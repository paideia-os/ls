  // ==========================================================================
  // .bss destination buffer for rn_compose_file_entry -- 128 bytes,
  // same shape/alignment as Runner::_rn_entry_buf.
  // ==========================================================================
  pub let mut _fff_entry_scratch : [u64; 16] = uninit @align(8)

  // ==========================================================================
  // file_fallback_fixtures_case_count() -> u64
  //
  // Leaf.
  // ==========================================================================
  pub let file_fallback_fixtures_case_count : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "ls.ENH-015 (#33): return FFF_CASE_COUNT (5) for a harness iterating via file_fallback_fixtures_run. Leaf pure function. paideia-as conformance: no test mnemonic; no cmp. Labels prefixed fffcc_.",
      block: {
        mov rax, 5;                              // FFF_CASE_COUNT
        ret
      }
    }

  // ==========================================================================
  // file_fallback_fixtures_run(case_idx) -> u64
  //
  // Signature: (u64) -> u64 !{mem} @{}
  //   RDI: case_idx (0..4)
  //   RAX: 0 on pass; FFF_ERR_LEN_MISMATCH + case_idx or
  //        FFF_ERR_RECORD_MISMATCH + case_idx on fail;
  //        FFF_ERR_BAD_CASE_IDX on out-of-range.
  //
  // Sequence:
  //   (1) Bounds check case_idx < 5.
  //   (2) expected_len (r12) = _fff_expected_lens[case_idx].
  //   (3) golden_ptr (r13) = &_fff_golden_all + case_idx * 128 (fixed
  //       stride -- no offsets table).
  //   (4) entry_buf_ptr (r14) = &_fff_entry_scratch.
  //   (5) name_ptr = &_fff_names_all + _fff_name_offsets[case_idx],
  //       computed inline right before the call (dead after).
  //   (6) Call rn_compose_file_entry(entry_buf_ptr, name_ptr).
  //   (7) cmp rax, expected_len; mismatch -> FFF_ERR_LEN_MISMATCH.
  //   (8) Byte-diff loop over all 128 bytes of the record; first
  //       mismatch -> FFF_ERR_RECORD_MISMATCH.
  //
  // Register plan (five callee-save pushes for pipeline stability
  // across the rn_compose_file_entry call, mirrors
  // JsonLineFixtures::json_line_fixtures_run):
  //   rbx = case_idx (survives)
  //   r12 = expected_len (survives)
  //   r13 = golden_ptr (survives)
  //   r14 = entry_buf_ptr (survives; also passed as the call's rdi)
  //   r15 = diff-loop index (byte-diff, reused after the one call)
  //
  // Alignment: 5 pushes = 40 bytes; entry rsp % 16 == 8; 8 + 40 = 48;
  // 48 % 16 == 0 at the rn_compose_file_entry call site. Matched 5 pops.
  // ==========================================================================
  pub let file_fallback_fixtures_run : (u64) -> u64 !{mem} @{} =
    fn (case_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.ENH-015 (#33): run one rn_compose_file_entry record-shape case. Bounds-check case_idx < 5 -> FFF_ERR_BAD_CASE_IDX. Load expected_len from _fff_expected_lens[case_idx] into r12. Compute golden_ptr = &_fff_golden_all + case_idx*128 into r13 (shl rax,7 stages the fixed 128-byte stride -- every golden record is the same size, so no offsets table is needed, unlike the variable-length JsonLineFixtures goldens). entry_buf_ptr = &_fff_entry_scratch into r14. Compute name_ptr = &_fff_names_all + _fff_name_offsets[case_idx] directly into rsi right before the call (dead after, no callee-save slot needed). Call rn_compose_file_entry(rdi=r14, rsi=name_ptr). Compare rax to r12 -> FFF_ERR_LEN_MISMATCH + case_idx on mismatch. Byte-diff loop over the full 128-byte record (not just name_len bytes) so the padding zeroing and the kind/name_len qword fields are pinned too, not just the name bytes: r15 = 0..128, stage r11 = r14+r15 for the actual byte (xor rax,rax; mov_b rax,[r11]; mov r10,rax to stash it), then r11 = r13+r15 for the expected byte (xor rax,rax; mov_b rax,[r11]), cmp rax,r10 -> FFF_ERR_RECORD_MISMATCH + case_idx on first drift -- same actual-then-expected-then-compare idiom as JsonLineFixtures::json_line_fixtures_run's diff loop. Five callee-save pushes (rbx=case_idx, r12=expected_len, r13=golden_ptr, r14=entry_buf_ptr, r15=diff index) = 40 bytes; entry rsp % 16 == 8; 8 + 40 = 48; aligned at the rn_compose_file_entry call site. paideia-as: no test mnemonic; largest cmp immediate 128 (record size); FFF_ERR_* sentinels via mov rax, imm64 + add rax, rbx. Labels prefixed fffr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                            // case_idx

        // Bounds check.
        cmp rbx, 5;                              // FFF_CASE_COUNT
        jae fffr_bad_idx;

        // expected_len -> r12.
        lea r11, [rip + _fff_expected_lens];
        mov r12, [r11 + rbx * 8];

        // golden_ptr = &_fff_golden_all + case_idx * 128.
        mov rax, rbx;
        shl rax, 7;                              // * 128
        lea r11, [rip + _fff_golden_all];
        add r11, rax;
        mov r13, r11;

        // entry_buf_ptr -> r14.
        lea r14, [rip + _fff_entry_scratch];

        // ---- Call rn_compose_file_entry(entry_buf_ptr, name_ptr) ---
        mov rdi, r14;

        // name_ptr = &_fff_names_all + _fff_name_offsets[case_idx].
        lea r11, [rip + _fff_name_offsets];
        mov rax, [r11 + rbx * 8];
        lea r11, [rip + _fff_names_all];
        add r11, rax;
        mov rsi, r11;

        call rn_compose_file_entry;

        // Length check.
        cmp rax, r12;
        jne fffr_len_fail;

        // Whole-record byte-diff loop (128 bytes).
        xor r15, r15;

      fffr_diff_loop:
        cmp r15, 128;
        jae fffr_ok;

        // Actual byte.
        mov r11, r14;
        add r11, r15;
        xor rax, rax;
        mov_b rax, [r11];
        mov r10, rax;                            // r10 = actual byte

        // Expected byte.
        mov r11, r13;
        add r11, r15;
        xor rax, rax;
        mov_b rax, [r11];                        // rax = expected byte

        cmp rax, r10;
        jne fffr_record_fail;

        add r15, 1;
        jmp fffr_diff_loop;

      fffr_ok:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fffr_len_fail:
        mov rax, 0xFFFFEBF0;                     // FFF_ERR_LEN_MISMATCH
        add rax, rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fffr_record_fail:
        mov rax, 0xFFFFEBF6;                     // FFF_ERR_RECORD_MISMATCH
        add rax, rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      fffr_bad_idx:
        mov rax, 0xFFFFEBFF;                     // FFF_ERR_BAD_CASE_IDX
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // file_fallback_fixtures_verify_all() -> u64
  //
  // Walk case_idx 0..4; first non-zero return propagates.
  //
  // Two callee-save pushes (rbx=idx, r12=cap) + sub rsp,8 pad = 24;
  // entry rsp %16==8; 8+24=32; aligned at file_fallback_fixtures_run
  // call site.
  // ==========================================================================
  pub let file_fallback_fixtures_verify_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.ENH-015 (#33): fail-fast walk of all 5 rn_compose_file_entry cases. Two callee-save pushes (rbx=idx, r12=cap) + sub rsp,8 pad = 24; entry rsp %16==8; 8+24=32; aligned at file_fallback_fixtures_run call site. Matched add rsp,8 + 2 pops. paideia-as: no test; cmp against 5 fits imm32. Labels prefixed fffva_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        xor rbx, rbx;
        mov r12, 5;                              // FFF_CASE_COUNT

      fffva_loop:
        cmp rbx, r12;
        jae fffva_ok;

        mov rdi, rbx;
        call file_fallback_fixtures_run;
        cmp rax, 0;
        jne fffva_out;

        add rbx, 1;
        jmp fffva_loop;

      fffva_ok:
        xor rax, rax;
      fffva_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
