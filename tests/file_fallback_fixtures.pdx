// tests/file_fallback_fixtures.pdx -- ls.ENH-015 (paideia-os/ls#33)
//
// FileFallbackFixtures module: byte-exact goldens for
// Runner::rn_compose_file_entry (src/runner.pdx), the pure record-
// composition helper backing the file-as-path single-row fallback
// (`ls file.txt` prints one row instead of failing with
// LS_ERR_READDIR). Follows the M4 fixture convention documented in
// tests/README.md.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// rn_compose_file_entry itself is a leaf with no syscalls, so it is
// directly fixture-testable (unlike runner_ls, which issues real
// `syscall` instructions and is exercised only by the qemu smoke
// path). This module is the executable pin for the composer's record
// shape; the EBADF-vs-genuine-failure discrimination and the
// hidden-filter bypass live in runner_ls's control flow and are
// covered by the qemu smoke matrix, not here.
//
// Five cases, each diffed as a full 128-byte record against a golden:
//
//   idx  input name           name_len   note
//   -----------------------------------------------------------------
//    0   "a.txt"               5         plain short name
//    1   "" (empty)            0         zero-length edge case
//    2   ".bashrc"             7         dotfile -- pins that the
//                                        composer does NOT hidden-
//                                        filter (that decision belongs
//                                        to rn_ls_file_fallback's jump
//                                        past hidden_filter_accept,
//                                        not to this function)
//    3   104 * 'x', NUL at 104 104       exact-clamp boundary: the
//                                        real terminator coincides
//                                        with RN_ENT_NAME_MAX
//    4   110 * 'y', NUL at 110 104       clamp-BEFORE-real-NUL: proves
//                                        the 104-byte bound fires
//                                        before the scan ever reaches
//                                        the actual terminator
//
// Every case pins: the zeroed inode qword at +0, the RN_ENT_KIND_FILE
// (8) qword at +8, the name_len qword at +16, the name bytes at +24,
// and zero padding for the remainder of the 104-byte name field.
//
// =============================================================================
// TABLE LAYOUT
// =============================================================================
//
//   _fff_name_offsets  [u64; 5]   -- byte offset into _fff_names_all
//   _fff_expected_lens [u64; 5]   -- expected rn_compose_file_entry
//                                    return value per case
//   _fff_names_all     [u8; 231]  -- packed NUL-terminated input names
//   _fff_golden_all    [u8; 640]  -- packed expected 128-byte records,
//                                    5 * 128 bytes, fixed stride (no
//                                    offsets table needed)
//   _fff_entry_scratch [u64; 16]  -- 128-byte rn_compose_file_entry
//                                    destination buffer (@align(8),
//                                    same shape as Runner::_rn_entry_buf)
//
// =============================================================================
// PUBLIC ENTRY POINTS
// =============================================================================
//
//   file_fallback_fixtures_case_count() -> u64        -- FFF_CASE_COUNT (5)
//   file_fallback_fixtures_run(case_idx) -> u64        -- 0 pass; err+idx on fail
//   file_fallback_fixtures_verify_all() -> u64         -- fail-fast walk
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`FileFallbackFixtures`).
//   - No `test` mnemonic; every zero-check / bound-check uses
//     `cmp reg, 0` or `cmp reg, imm`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Largest immediates:
//     5 (case cap), 128 (record stride / diff-loop bound). The
//     FFF_ERR_* sentinels are `mov rax, imm64` stores.
//   - Byte reads (diff loop) use `xor rax, rax; mov_b rax, [ptr]`
//     staged through r11 so addressing stays [reg]-only, matching
//     JsonLineFixtures's diff-loop idiom exactly.
//   - r10 / r11 are scratch.
//   - Labels prefixed fffr_ / fffva_.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   rn_compose_file_entry -- Runner (src/runner.pdx)

module FileFallbackFixtures = structure {

  // ==========================================================================
  // Return codes
  // ==========================================================================
  pub let FFF_OK                 : u64 = 0
  pub let FFF_ERR_LEN_MISMATCH   : u64 = 0xFFFFEBF0    // + case_idx (0..4)
  pub let FFF_ERR_RECORD_MISMATCH: u64 = 0xFFFFEBF6    // + case_idx (0..4)
  pub let FFF_ERR_BAD_CASE_IDX   : u64 = 0xFFFFEBFF

  pub let FFF_CASE_COUNT         : u64 = 5

  // ==========================================================================
  // Per-case byte offset into _fff_names_all.
  //
  //   case 0 -> 0    ("a.txt\0"          6 bytes)
  //   case 1 -> 6    ("\0"               1 byte)
  //   case 2 -> 7    (".bashrc\0"        8 bytes)
  //   case 3 -> 15   ('x' * 104 + '\0'   105 bytes)
  //   case 4 -> 120  ('y' * 110 + '\0'   111 bytes)
  // ==========================================================================
  pub let _fff_name_offsets : [u64; 5] = [ 0, 6, 7, 15, 120 ]

  // ==========================================================================
  // Per-case expected rn_compose_file_entry return value (clamped
  // name_len).
  // ==========================================================================
  pub let _fff_expected_lens : [u64; 5] = [ 5, 0, 7, 104, 104 ]

  // ==========================================================================
  // Packed input names (231 bytes total). Every name is NUL-
  // terminated within its own segment except where the clamp is
  // expected to fire strictly before that NUL is ever read (cases 3
  // and 4 both carry a trailing NUL anyway, for hygiene, even though
  // rn_compose_file_entry's bound check means it is never touched).
  // ==========================================================================
  pub let _fff_names_all : [u8; 231] = [
      // ---- case 0: "a.txt" (6 bytes incl. NUL) ----
      0x61, 0x2E, 0x74, 0x78, 0x74, 0x00,
      // ---- case 1: "" (1 byte: NUL only) ----
      0x00,
      // ---- case 2: ".bashrc" (8 bytes incl. NUL) ----
      0x2E, 0x62, 0x61, 0x73, 0x68, 0x72, 0x63, 0x00,
      // ---- case 3: 'x' * 104 + NUL (105 bytes) ----
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78, 0x78,
      0x00,
      // ---- case 4: 'y' * 110 + NUL (111 bytes) ----
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x79,
      0x79, 0x79, 0x79, 0x79, 0x79, 0x79, 0x00
  ]

