// tests/human_size_fixtures.pdx -- ls.ENH-003 (paideia-os/ls#17)
//
// HumanSizeFixtures module: byte-exact goldens for
// HumanSize::human_size_render (src/human_size.pdx). Retires the
// enhancement-plan §2.2 "the renderer has no test fixture" status
// for the -h size column.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// FIXTURE module. Six boundary cases spanning the fast path (bytes <
// 1024, raw decimal via render_dec_u64) and the slow path (integer +
// '.' + tenth digit + unit letter, base-2):
//
//   idx   input (bytes)              expected text   expected len
//   -----------------------------------------------------------
//    0    0                          "0"             1
//    1    999                        "999"           3
//    2    1024                       "1.0K"          4
//    3    1536                       "1.5K"          4
//    4    1048576                    "1.0M"          4
//    5    1099511627776 (= 1024^4)   "1.0T"          4
//
// Cases 0 and 1 pin both edges of the fast path (val == 0 which is
// the render_dec_u64 special case; val == 999 which is the largest
// value still below the 1024 unit-step). Cases 2..5 pin the four
// slow-path boundaries the human-size algorithm has to get right:
//
//   * case 2 (1024) pins unit_index == 1 (K) with a zero tenth
//     ((1024 & 0x3FF) * 10 >> 10 == 0).
//   * case 3 (1536) pins the tenth-digit derivation
//     ((1536 & 0x3FF) * 10 >> 10 == 5, so "1.5K").
//   * case 4 (1048576 == 1024^2) pins unit_index == 2 (M) with a
//     zero tenth.
//   * case 5 (1099511627776 == 1024^4) pins unit_index == 4 (T) --
//     four iterations of the /1024 loop, no clamp -- with zero
//     tenth.
//
// The human-readable copies of the expected byte sequences live at
// tests/goldens/human_size_case<N>_*.txt. Those files are NOT read
// by this fixture (paideia-as fixture modules have no filesystem
// cap); they exist so a human reviewing a regression can eyeball the
// expected output. The .rodata tables below are the authority the
// comparator asserts against.
//
// =============================================================================
// TABLE LAYOUT
// =============================================================================
//
//   _hsf_inputs         [u64; 6] -- one input value per case
//   _hsf_expected_lens  [u64; 6] -- byte count human_size_render must return
//   _hsf_offsets        [u64; 6] -- byte offset into _hsf_golden_all
//   _hsf_golden_all     [u8; 20] -- all six expected strings packed
//                                   contiguously: 1+3+4+4+4+4 = 20 bytes
//
// The single packed goldens array + per-case offset+len table lets
// one comparator loop cover every case without a per-case symbol
// dispatch (the dispatch collapses to a single `mov` + `lea` +
// `add`).
//
// =============================================================================
// PUBLIC ENTRY POINTS
// =============================================================================
//
//   human_size_fixtures_case_count() -> u64          -- HSF_CASE_COUNT (6)
//   human_size_fixtures_run(case_idx) -> u64         -- 0 pass; err+idx on fail
//   human_size_fixtures_verify_all() -> u64          -- fail-fast walk
//
// The verifier signatures match the M4 fixture convention documented
// in tests/README.md so a future harness iterates every module
// through a uniform `<name>_verify_all` call.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`HumanSizeFixtures`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Largest immediates:
//     6 (case cap), 32 (scratch cap). The HSF_ERR_* sentinels are
//     mov rax, imm64 stores or ADD-relative arithmetic.
//   - Byte reads use `xor rax, rax; mov_b rax, [ptr]` per #1248.
//   - r10 / r11 are scratch. Byte-diff loop stages each ptr into r11
//     before mov_b so the addressing mode is [reg] only (no
//     [reg + reg] byte reads, per the U1606 note in tools/build.sh's
//     history).
//   - Labels prefixed hsf_.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   human_size_render     -- HumanSize (src/human_size.pdx)

module HumanSizeFixtures = structure {

  // ==========================================================================
  // Return codes
  // ==========================================================================
  pub let HSF_OK               : u64 = 0
  pub let HSF_ERR_LEN_MISMATCH : u64 = 0xFFFFEB60    // + case_idx (0..5)
  pub let HSF_ERR_BYTE_MISMATCH: u64 = 0xFFFFEB70    // + case_idx (0..5)
  pub let HSF_ERR_BAD_CASE_IDX : u64 = 0xFFFFEB7F

  pub let HSF_CASE_COUNT       : u64 = 6

  // ==========================================================================
  // Input values (bytes).
  //
  //   case 0: 0
  //   case 1: 999
  //   case 2: 1024
  //   case 3: 1536
  //   case 4: 1048576         (= 1024^2)
  //   case 5: 1099511627776   (= 1024^4 = 0x10000000000)
  // ==========================================================================
  pub let _hsf_inputs : [u64; 6] = [
      0,
      999,
      1024,
      1536,
      1048576,
      1099511627776
  ]

  // ==========================================================================
  // Expected byte counts (one per case; matches human_size_render return).
  // ==========================================================================
  pub let _hsf_expected_lens : [u64; 6] = [
      1,          // "0"
      3,          // "999"
      4,          // "1.0K"
      4,          // "1.5K"
      4,          // "1.0M"
      4           // "1.0T"
  ]

  // ==========================================================================
  // Byte offset into _hsf_golden_all for each case.
  //
  //   case 0 -> [0..1)     "0"
  //   case 1 -> [1..4)     "999"
  //   case 2 -> [4..8)     "1.0K"
  //   case 3 -> [8..12)    "1.5K"
  //   case 4 -> [12..16)   "1.0M"
  //   case 5 -> [16..20)   "1.0T"
  // ==========================================================================
  pub let _hsf_offsets : [u64; 6] = [ 0, 1, 4, 8, 12, 16 ]

  // ==========================================================================
  // Packed goldens (20 bytes total).
  //
  //   ASCII: '0'=0x30 '9'=0x39 '1'=0x31 '.'=0x2E '5'=0x35
  //          'K'=0x4B 'M'=0x4D 'T'=0x54
  //
  // Layout matches _hsf_offsets exactly.
  // ==========================================================================
  pub let _hsf_golden_all : [u8; 20] = [
      // case 0: "0"
      0x30,
      // case 1: "999"
      0x39, 0x39, 0x39,
      // case 2: "1.0K"
      0x31, 0x2E, 0x30, 0x4B,
      // case 3: "1.5K"
      0x31, 0x2E, 0x35, 0x4B,
      // case 4: "1.0M"
      0x31, 0x2E, 0x30, 0x4D,
      // case 5: "1.0T"
      0x31, 0x2E, 0x30, 0x54
  ]

  // ==========================================================================
  // .bss render scratch -- 32 bytes. Sized bigger than the widest
  // expected (4 bytes) so a corrupt oversized render surfaces as a
  // length mismatch (rax > 4) rather than an overflow bomb.
  // ==========================================================================
  pub let mut _hsf_scratch : [u64; 4] = uninit @align(8)

  // ==========================================================================
  // human_size_fixtures_case_count() -> u64
  //
  // Leaf.
  // ==========================================================================
  pub let human_size_fixtures_case_count : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "ls.ENH-003 (#17): return HSF_CASE_COUNT (6) for a harness iterating via human_size_fixtures_run. Leaf pure function. paideia-as conformance: no test mnemonic; no cmp. Labels prefixed hsfcc_.",
      block: {
        mov rax, 6;                              // HSF_CASE_COUNT
        ret
      }
    }

  // ==========================================================================
  // human_size_fixtures_run(case_idx) -> u64
  //
  // Signature: (u64) -> u64 !{mem} @{}
  //   RDI: case_idx (0..5)
  //   RAX: 0 on pass; HSF_ERR_LEN_MISMATCH + case_idx or
  //        HSF_ERR_BYTE_MISMATCH + case_idx on fail;
  //        HSF_ERR_BAD_CASE_IDX on out-of-range.
  //
  // Sequence:
  //   (1) Bounds check case_idx < 6.
  //   (2) Load expected_len (r12), expected_ptr (r13) from tables.
  //   (3) Load input (rdx) from _hsf_inputs[case_idx].
  //   (4) Call human_size_render(&_hsf_scratch, 32, input).
  //   (5) cmp rax, r12; mismatch -> HSF_ERR_LEN_MISMATCH.
  //   (6) Byte-diff loop scratch[0..len] vs expected[0..len]; first
  //       mismatch -> HSF_ERR_BYTE_MISMATCH.
  //
  // Register plan (non-leaf; five callee-save pushes for pipeline
  // stability across the human_size_render call):
  //   rbx = case_idx (survives)
  //   r12 = expected_len (survives)
  //   r13 = expected_ptr (survives)
  //   r14 = scratch base (survives)
  //   r15 = byte loop counter
  //
  // Alignment: 5 pushes = 40 bytes; entry rsp % 16 == 8; 8 + 40 = 48;
  // 48 % 16 == 0. Aligned at the human_size_render call site. No pad.
  // Matched 5 pops.
  // ==========================================================================
  pub let human_size_fixtures_run : (u64) -> u64 !{mem} @{} =
    fn (case_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.ENH-003 (#17): run one human_size boundary case. Bounds-check case_idx < 6 -> HSF_ERR_BAD_CASE_IDX. Load expected_len from _hsf_expected_lens[case_idx] into r12. Compute expected_ptr = &_hsf_golden_all + _hsf_offsets[case_idx] into r13. LEA _hsf_scratch into r14. Load input from _hsf_inputs[case_idx] into rdx. Call human_size_render(r14, 32, rdx). Compare rax to r12 -> HSF_ERR_LEN_MISMATCH + case_idx on mismatch. Byte-diff loop iterates r15 = 0..r12: stage r11 = r14 + r15, xor rax + mov_b rax, [r11] gives actual byte; stage r11 = r13 + r15, xor r10 + mov_b r10, [r11] gives expected; cmp -> HSF_ERR_BYTE_MISMATCH + case_idx on first drift. Byte reads use [reg]-only addressing (no [reg+reg] mov_b per U1606). Five callee-save pushes (rbx=case_idx, r12=expected_len, r13=expected_ptr, r14=scratch, r15=byte counter) = 40 bytes; entry rsp % 16 == 8; 8 + 40 = 48; aligned. paideia-as: no test mnemonic; largest cmp immediate 6 or 32; HSF_ERR_* sentinels via mov rax, imm64 + add. Labels prefixed hsfr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;

        // Bounds check.
        cmp rbx, 6;                              // HSF_CASE_COUNT
        jae hsfr_bad_idx;

        // Load expected_len into r12.
        lea r11, [rip + _hsf_expected_lens];
        mov r12, [r11 + rbx * 8];

        // Compute expected_ptr = &_hsf_golden_all + _hsf_offsets[case_idx].
        lea r11, [rip + _hsf_offsets];
        mov rax, [r11 + rbx * 8];                // rax = offset
        lea r11, [rip + _hsf_golden_all];
        add r11, rax;
        mov r13, r11;                            // r13 = expected_ptr

        // Scratch address.
        lea r14, [rip + _hsf_scratch];

        // Load input value into rdx for the call.
        lea r11, [rip + _hsf_inputs];
        mov rdx, [r11 + rbx * 8];                // rdx = bytes

        // Call human_size_render(scratch, 32, bytes).
        mov rdi, r14;
        mov rsi, 32;
        // rdx already set
        call human_size_render;

        // Length check.
        cmp rax, r12;
        jne hsfr_len_fail;

        // Byte-diff loop.
        xor r15, r15;

      hsfr_diff_loop:
        cmp r15, r12;
        jae hsfr_ok;

        // Load actual byte from scratch.
        mov r11, r14;
        add r11, r15;
        xor rax, rax;
        mov_b rax, [r11];
        mov r10, rax;                            // r10 = actual byte

        // Load expected byte.
        mov r11, r13;
        add r11, r15;
        xor rax, rax;
        mov_b rax, [r11];                        // rax = expected byte

        cmp rax, r10;
        jne hsfr_byte_fail;

        add r15, 1;
        jmp hsfr_diff_loop;

      hsfr_ok:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      hsfr_len_fail:
        mov rax, 0xFFFFEB60;                     // HSF_ERR_LEN_MISMATCH
        add rax, rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      hsfr_byte_fail:
        mov rax, 0xFFFFEB70;                     // HSF_ERR_BYTE_MISMATCH
        add rax, rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      hsfr_bad_idx:
        mov rax, 0xFFFFEB7F;                     // HSF_ERR_BAD_CASE_IDX
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // human_size_fixtures_verify_all() -> u64
  //
  // Walk case_idx 0..5; first non-zero return propagates.
  //
  // Two callee-save pushes (rbx=idx, r12=cap) + sub rsp,8 pad = 24;
  // entry rsp %16==8; 8+24=32; aligned at human_size_fixtures_run
  // call site.
  // ==========================================================================
  pub let human_size_fixtures_verify_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.ENH-003 (#17): fail-fast walk of all 6 human_size boundary cases. Two callee-save pushes (rbx=idx, r12=cap) + sub rsp,8 pad = 24; entry rsp %16==8; 8+24=32; aligned at human_size_fixtures_run call site. Matched add rsp,8 + 2 pops. paideia-as: no test; cmp against 6 fits imm32. Labels prefixed hsfva_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        xor rbx, rbx;
        mov r12, 6;                              // HSF_CASE_COUNT

      hsfva_loop:
        cmp rbx, r12;
        jae hsfva_ok;

        mov rdi, rbx;
        call human_size_fixtures_run;
        cmp rax, 0;
        jne hsfva_out;

        add rbx, 1;
        jmp hsfva_loop;

      hsfva_ok:
        xor rax, rax;
      hsfva_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
