// tests/recurse_header_fixtures.pdx -- ls.ENH-017 (paideia-os/ls#35)
//
// RecurseHeaderFixtures module: byte-exact goldens for
// RecurseHeader::recurse_header_compose (src/recurse_header.pdx), the
// `-R` recursion-block header composer (`\n<path>/<name>:\n`).
// Follows the M4 fixture convention documented in tests/README.md.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// recurse_header_compose is a leaf with no syscalls, so it is
// directly fixture-testable (unlike runner_ls, which issues real
// `syscall` instructions and is exercised only by the qemu smoke
// path). This module pins the exact byte layout Runner's -R phase
// (src/runner.pdx, rn_ls_recurse_emit_loop) depends on, plus the two
// clamp boundaries (path scan bound, name_len bound) and the
// overflow contract.
//
// Five cases:
//
//   idx  path              name       name_len  dst_cap  expect
//   -----------------------------------------------------------------
//    0   (null -> ".")     "subdir"   6         256      "\n./subdir:\n" (11 B)
//    1   "/tmp/tree"       "a"        1         256      "\n/tmp/tree/a:\n" (14 B)
//    2   (null -> ".")     "subdir"   6         5        RH_ERR_OVERFLOW
//                                                        (needs 11, has 5)
//    3   (null -> ".")     110*'z'    110       200      109 B, name clamped
//                                                        to RH_NAME_MAX (104)
//                                                        -- pins that a
//                                                        caller-supplied
//                                                        name_len past the
//                                                        bound is silently
//                                                        clamped, not
//                                                        overrun
//    4   210*'p' (no NUL)  "x"        1         250      205 B, path clamped
//                                                        to RH_PATH_MAX
//                                                        (200) -- pins the
//                                                        "no NUL found
//                                                        within the scan
//                                                        bound" clamp path,
//                                                        distinct from
//                                                        case 3's caller-
//                                                        supplied-length
//                                                        clamp
//
// =============================================================================
// TABLE LAYOUT
// =============================================================================
//
//   _rhf_path_is_null    [u64; 5]  -- 1 => pass path_ptr = 0 literally
//   _rhf_path_offsets    [u64; 5]  -- byte offset into _rhf_paths_all
//                                     (ignored when is_null == 1)
//   _rhf_name_offsets    [u64; 5]  -- byte offset into _rhf_names_all
//   _rhf_name_lens       [u64; 5]  -- name_len argument per case
//   _rhf_dst_caps        [u64; 5]  -- dst_cap argument per case
//   _rhf_expected_lens   [u64; 5]  -- expected return; RH_ERR_OVERFLOW
//                                     (0xFFFF...F) => byte-diff skipped
//   _rhf_golden_offsets  [u64; 5]  -- byte offset into _rhf_golden_all
//                                     (ignored for the overflow case)
//   _rhf_paths_all       [u8; 220] -- packed path inputs
//   _rhf_names_all       [u8; 121] -- packed name inputs
//   _rhf_golden_all      [u8; 339] -- packed expected outputs
//   _rhf_scratch         [u64; 32] -- 256-byte compose dst (@align(8))
//
// =============================================================================
// PUBLIC ENTRY POINTS
// =============================================================================
//
//   recurse_header_fixtures_case_count() -> u64        -- RHF_CASE_COUNT (5)
//   recurse_header_fixtures_run(case_idx) -> u64       -- 0 pass; err+idx on fail
//   recurse_header_fixtures_verify_all() -> u64        -- fail-fast walk
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`RecurseHeaderFixtures`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Largest immediates:
//     5 (case cap), 250 (dst_cap), 220/121/339 (table sizes). The
//     0xFFFFFFFFFFFFFFFF overflow marker and the RHF_ERR_* sentinels
//     are `mov rax, imm64` / `mov r11, imm64` stores, never compares.
//   - Byte reads (diff loop) use `xor rax, rax; mov_b rax, [ptr]` per
//     #1248, staged through r11 so addressing stays [reg]-only.
//   - r10 / r11 are scratch.
//   - Labels prefixed rhf_ / rhfva_.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   recurse_header_compose -- RecurseHeader (src/recurse_header.pdx)

module RecurseHeaderFixtures = structure {

  // ==========================================================================
  // Return codes
  // ==========================================================================
  pub let RHF_OK                : u64 = 0
  pub let RHF_ERR_LEN_MISMATCH  : u64 = 0xFFFFEBB0    // + case_idx (0..4)
  pub let RHF_ERR_BYTE_MISMATCH : u64 = 0xFFFFEBC0    // + case_idx (0..4)
  pub let RHF_ERR_BAD_CASE_IDX  : u64 = 0xFFFFEBCF

  pub let RHF_CASE_COUNT        : u64 = 5

  // ==========================================================================
  // Per-case scalar inputs / expectations.
  // ==========================================================================
  pub let _rhf_path_is_null   : [u64; 5] = [ 1, 0, 1, 1,   0 ]
  pub let _rhf_path_offsets   : [u64; 5] = [ 0, 0, 0, 0,   10 ]
  pub let _rhf_name_offsets   : [u64; 5] = [ 0, 7, 0, 9,   119 ]
  pub let _rhf_name_lens      : [u64; 5] = [ 6, 1, 6, 110, 1 ]
  pub let _rhf_dst_caps       : [u64; 5] = [ 256, 256, 5, 200, 250 ]
  // Case 2 expects RH_ERR_OVERFLOW (0xFFFFFFFFFFFFFFFF); every other
  // case expects its composed byte count.
  pub let _rhf_expected_lens  : [u64; 5] = [ 11, 14, 0xFFFFFFFFFFFFFFFF, 109, 205 ]
  pub let _rhf_golden_offsets : [u64; 5] = [ 0, 11, 25, 25, 134 ]

  // ==========================================================================
  // Packed path inputs (220 bytes). Case 1's "/tmp/tree" is NUL-
  // terminated at byte 9 (10 bytes total) -- the ordinary scan-to-NUL
  // path. Case 4's 210 bytes of 'p' carry NO NUL anywhere in the
  // range recurse_header_compose can reach (its scan is bounded at
  // RH_PATH_MAX = 200, strictly less than 210) -- this is the "clamp
  // because the bound fired first, not because a NUL was found"
  // path, distinct from case 1's ordinary termination.
  // ==========================================================================
  pub let _rhf_paths_all : [u8; 220] = [
      0x2F, 0x74, 0x6D, 0x70, 0x2F, 0x74, 0x72, 0x65,
      0x65, 0x00, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70, 0x70,
      0x70, 0x70, 0x70, 0x70
  ]

  // ==========================================================================
  // Packed name inputs (121 bytes). Case 3's 110 bytes of 'z' carry
  // no NUL -- irrelevant here, since name_len is caller-supplied and
