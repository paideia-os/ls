// tests/group_sort_fixtures.pdx -- ls.ENH-020 (paideia-os/ls#38)
//
// GroupSortFixtures module: byte-exact (word-exact -- every element is
// a u64 index, not a byte) goldens for GroupSort::group_sort_partition
// (src/group_sort.pdx). Follows the M4 fixture convention documented
// in tests/README.md.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// Seven cases spanning the boundaries of the stable two-pass partition:
//
//   idx  kinds                    count  expected order
//   ----------------------------------------------------------------
//    0   (none)                   0      (none)
//    1   4,4,4                    3      0,1,2   (all dirs, unchanged)
//    2   8,8,8                    3      0,1,2   (all files, unchanged)
//    3   8,4,8,4                  4      1,3,0,2 (mixed, dirs pulled fwd)
//    4   10,4,8,4,10              5      1,3,0,2,4 (symlinks -- kind
//                                         0xA -- stay in the
//                                         non-directory partition;
//                                         pins the documented
//                                         no-promotion behaviour)
//    5   4                        1      0       (single dir)
//    6   8                        1      0       (single file)
//
// Case 0 pins the count == 0 no-op guard (both pass loops must fall
// through on the first bound check without touching order_ptr).
// Case 4 is the one that matters most: it is the executable pin for
// group_sort.pdx's documented "symlink-to-directory promotion is NOT
// implemented" gap -- a future stat-follow-backed rewrite that starts
// promoting kind 0xA would have to touch this golden, which is the
// point (the diff makes the behaviour change visible in review).
//
// =============================================================================
// TABLE LAYOUT
// =============================================================================
//
//   _gsf_counts             [u64; 7]  -- entries per case
//   _gsf_offsets            [u64; 7]  -- cumulative offset into the
//                                        two packed 17-element tables
//   _gsf_kinds_all          [u64; 17] -- every case's kinds, packed
//   _gsf_expected_order_all [u64; 17] -- every case's expected order,
//                                        packed at the same offsets
//
// offsets: [0, 0, 3, 6, 10, 15, 16]; total packed length = 17
// (case 0 contributes 0 elements, so case 1 also starts at offset 0).
//
// =============================================================================
// PUBLIC ENTRY POINTS
// =============================================================================
//
//   group_sort_fixtures_case_count() -> u64
//   group_sort_fixtures_run(case_idx) -> u64      -- 0 pass; err+idx on fail
//   group_sort_fixtures_verify_all() -> u64       -- fail-fast walk
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`GroupSortFixtures`).
//   - No `test` mnemonic; every zero-check / bound-check uses `cmp
//     reg, 0` or `cmp reg, reg`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Largest immediates:
//     7 (case cap), 3 (offset*8 shift-count is not an immediate
//     compare). The GSF_ERR_* sentinels are `mov rax, imm64` stores.
//   - No byte reads/writes -- every table element is a full u64 lane,
//     loaded/stored via `[base + index * 8]` (no #1248 mitigation
//     needed -- that mitigation is for narrow `mov_b` loads only).
//   - r10 / r11 are scratch. r10 doubles as the offset*8 stage and,
//     after the call returns, the diff-loop index (no interference --
//     the call to group_sort_partition happens before the diff loop
//     reuses r10).
//   - Labels prefixed gsfr_ / gsfva_.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   group_sort_partition -- GroupSort (src/group_sort.pdx)

module GroupSortFixtures = structure {

  // ==========================================================================
  // Return codes
  // ==========================================================================
  pub let GSF_OK                  : u64 = 0
  pub let GSF_ERR_COUNT_MISMATCH  : u64 = 0xFFFFEB31    // + case_idx (0..6)
  pub let GSF_ERR_ORDER_MISMATCH  : u64 = 0xFFFFEB41    // + case_idx (0..6)
  pub let GSF_ERR_BAD_CASE_IDX    : u64 = 0xFFFFEB4F

  pub let GSF_CASE_COUNT          : u64 = 7

  // ==========================================================================
  // Entries per case.
  // ==========================================================================
  pub let _gsf_counts : [u64; 7] = [
      0,    // case 0: empty
      3,    // case 1: all dirs
      3,    // case 2: all files
      4,    // case 3: mixed
      5,    // case 4: mixed with symlinks
      1,    // case 5: single dir
      1     // case 6: single file
  ]

  // ==========================================================================
  // Cumulative offset into _gsf_kinds_all / _gsf_expected_order_all
  // for each case's first element.
  // ==========================================================================
  pub let _gsf_offsets : [u64; 7] = [ 0, 0, 3, 6, 10, 15, 16 ]

  // ==========================================================================
  // Packed kind codes (17 elements total). Kind codes mirror
  // Runner::RN_ENT_OFF_KIND's low-nibble decode: 4 = directory,
  // 8 = file, 0xA (10) = symlink.
  // ==========================================================================
  pub let _gsf_kinds_all : [u64; 17] = [
      // case 1: all dirs
      4, 4, 4,
      // case 2: all files
      8, 8, 8,
      // case 3: mixed (file, dir, file, dir)
      8, 4, 8, 4,
      // case 4: mixed with symlinks (sym, dir, file, dir, sym)
      10, 4, 8, 4, 10,
      // case 5: single dir
      4,
      // case 6: single file
      8
  ]

  // ==========================================================================
  // Expected output order, packed at the same offsets as
  // _gsf_kinds_all.
  //
  //   case 1: dirs at 0,1,2 -> unchanged: 0,1,2
  //   case 2: no dirs -> unchanged: 0,1,2
  //   case 3: dirs at idx 1,3 (pass 1) then non-dirs at idx 0,2
  //           (pass 2) -> 1,3,0,2
  //   case 4: dirs at idx 1,3 (pass 1) then non-dirs (symlinks +
  //           file) at idx 0,2,4 in encounter order (pass 2) ->
  //           1,3,0,2,4 -- pins that symlinks (kind 0xA) are NOT
  //           promoted to the directory partition
  //   case 5: single dir -> 0
  //   case 6: single file -> 0
  // ==========================================================================
  pub let _gsf_expected_order_all : [u64; 17] = [
      // case 1
      0, 1, 2,
      // case 2
      0, 1, 2,
      // case 3
      1, 3, 0, 2,
      // case 4
      1, 3, 0, 2, 4,
      // case 5
      0,
      // case 6
      0
  ]

  // ==========================================================================
  // .bss order-output scratch -- 8 u64 lanes. Sized bigger than the
  // widest case (5) so a corrupt oversized write surfaces as an
  // index-range read past what the expected table covers rather than
  // an overflow bomb (same rationale as HumanSizeFixtures's _hsf_scratch).
  // ==========================================================================
  pub let mut _gsf_order_scratch : [u64; 8] = uninit @align(8)

  // ==========================================================================
  // group_sort_fixtures_case_count() -> u64
  //
  // Leaf.
  // ==========================================================================
  pub let group_sort_fixtures_case_count : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "ls.ENH-020 (#38): return GSF_CASE_COUNT (7) for a harness iterating via group_sort_fixtures_run. Leaf pure function. paideia-as conformance: no test mnemonic; no cmp. Labels prefixed gsfcc_.",
      block: {
        mov rax, 7;                              // GSF_CASE_COUNT
        ret
      }
    }

  // ==========================================================================
  // group_sort_fixtures_run(case_idx) -> u64
  //
  // Signature: (u64) -> u64 !{mem} @{}
  //   RDI: case_idx (0..6)
  //   RAX: 0 on pass; GSF_ERR_COUNT_MISMATCH + case_idx or
  //        GSF_ERR_ORDER_MISMATCH + case_idx on fail;
  //        GSF_ERR_BAD_CASE_IDX on out-of-range.
  //
  // Sequence:
  //   (1) Bounds check case_idx < 7.
  //   (2) Load count (r12) from _gsf_counts[case_idx].
  //   (3) Load offset (staged in r10, then *8) from
  //       _gsf_offsets[case_idx].
  //   (4) kinds_ptr (r13) = &_gsf_kinds_all + offset*8.
  //       expected_order_ptr (r15) = &_gsf_expected_order_all + offset*8.
  //   (5) order_scratch_ptr (r14) = &_gsf_order_scratch.
  //   (6) Call group_sort_partition(r13, r12, r14).
  //   (7) cmp rax, r12; mismatch -> GSF_ERR_COUNT_MISMATCH + case_idx.
  //   (8) Word-diff loop scratch[0..count) vs expected[0..count);
  //       first mismatch -> GSF_ERR_ORDER_MISMATCH + case_idx.
  //
  // Register plan (five callee-save pushes for pipeline stability
  // across the group_sort_partition call, mirrors
  // HumanSizeFixtures::human_size_fixtures_run):
  //   rbx = case_idx (survives)
  //   r12 = count (survives)
  //   r13 = kinds_ptr (survives)
  //   r14 = order_scratch_ptr (survives)
  //   r15 = expected_order_ptr (survives)
  //
  // Alignment: 5 pushes = 40 bytes; entry rsp % 16 == 8; 8 + 40 = 48;
  // 48 % 16 == 0 at the group_sort_partition call site. Matched 5 pops.
  // ==========================================================================
  pub let group_sort_fixtures_run : (u64) -> u64 !{mem} @{} =
    fn (case_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.ENH-020 (#38): run one group_sort_partition boundary case. Bounds-check case_idx < 7 -> GSF_ERR_BAD_CASE_IDX. Load count from _gsf_counts[case_idx] into r12. Load offset from _gsf_offsets[case_idx] into rax, stage into r10, shl r10,3 to get the byte offset. kinds_ptr = &_gsf_kinds_all + r10 (into r13); expected_order_ptr = &_gsf_expected_order_all + r10 (into r15, reusing r10 before it is repurposed as the diff-loop index). order_scratch_ptr = &_gsf_order_scratch (into r14). Call group_sort_partition(r13, r12, r14). Compare rax to r12 -> GSF_ERR_COUNT_MISMATCH + case_idx on mismatch (the function always echoes count on well-formed input, so any drift here is a real bug). Word-diff loop iterates r10 = 0..r12 (r10 is free to reuse for this purpose because the one call already happened): load actual from [r14 + r10*8], expected from [r15 + r10*8], cmp -> GSF_ERR_ORDER_MISMATCH + case_idx on first drift. Five callee-save pushes (rbx=case_idx, r12=count, r13=kinds_ptr, r14=order_scratch_ptr, r15=expected_order_ptr) = 40 bytes; entry rsp % 16 == 8; 8 + 40 = 48; aligned at the group_sort_partition call site. paideia-as: no test mnemonic; largest cmp immediate 7 (GSF_CASE_COUNT); GSF_ERR_* sentinels via mov rax, imm64 + add rax, rbx. No byte reads -- every table element is a full u64 lane. Labels prefixed gsfr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                            // case_idx

        // Bounds check.
        cmp rbx, 7;                              // GSF_CASE_COUNT
        jae gsfr_bad_idx;

        // Load count into r12.
        lea r11, [rip + _gsf_counts];
        mov r12, [r11 + rbx * 8];

        // Load offset, stage byte offset in r10.
        lea r11, [rip + _gsf_offsets];
        mov r10, [r11 + rbx * 8];
        shl r10, 3;                              // r10 = offset * 8

        // kinds_ptr = &_gsf_kinds_all + offset*8.
        lea r13, [rip + _gsf_kinds_all];
        add r13, r10;

        // expected_order_ptr = &_gsf_expected_order_all + offset*8.
        lea r15, [rip + _gsf_expected_order_all];
        add r15, r10;

        // order_scratch_ptr.
        lea r14, [rip + _gsf_order_scratch];

        // Call group_sort_partition(kinds_ptr, count, order_scratch_ptr).
        mov rdi, r13;
        mov rsi, r12;
        mov rdx, r14;
        call group_sort_partition;

        // Count-echo check.
        cmp rax, r12;
        jne gsfr_count_fail;

        // Word-diff loop (reuses r10 as the loop index -- the one
        // call above has already happened, so r10's earlier value is
        // dead).
        xor r10, r10;

      gsfr_diff_loop:
        cmp r10, r12;
        jae gsfr_ok;

        mov rax, [r14 + r10 * 8];                // actual
        mov r11, [r15 + r10 * 8];                // expected
        cmp rax, r11;
        jne gsfr_order_fail;

        add r10, 1;
        jmp gsfr_diff_loop;

      gsfr_ok:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gsfr_count_fail:
        mov rax, 0xFFFFEB31;                     // GSF_ERR_COUNT_MISMATCH
        add rax, rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gsfr_order_fail:
        mov rax, 0xFFFFEB41;                     // GSF_ERR_ORDER_MISMATCH
        add rax, rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      gsfr_bad_idx:
        mov rax, 0xFFFFEB4F;                     // GSF_ERR_BAD_CASE_IDX
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // group_sort_fixtures_verify_all() -> u64
  //
  // Walk case_idx 0..6; first non-zero return propagates.
  //
  // Two callee-save pushes (rbx=idx, r12=cap) + sub rsp,8 pad = 24;
  // entry rsp %16==8; 8+24=32; aligned at group_sort_fixtures_run
  // call site.
  // ==========================================================================
  pub let group_sort_fixtures_verify_all : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.ENH-020 (#38): fail-fast walk of all 7 group_sort_partition boundary cases. Two callee-save pushes (rbx=idx, r12=cap) + sub rsp,8 pad = 24; entry rsp %16==8; 8+24=32; aligned at group_sort_fixtures_run call site. Matched add rsp,8 + 2 pops. paideia-as: no test; cmp against 7 fits imm32. Labels prefixed gsfva_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        xor rbx, rbx;
        mov r12, 7;                              // GSF_CASE_COUNT

      gsfva_loop:
        cmp rbx, r12;
        jae gsfva_ok;

        mov rdi, rbx;
        call group_sort_fixtures_run;
        cmp rax, 0;
        jne gsfva_out;

        add rbx, 1;
        jmp gsfva_loop;

      gsfva_ok:
        xor rax, rax;
      gsfva_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
