// src/dispatch.pdx -- ls.M1-003 (paideia-os/ls#3) + ls.ENH-004 (#18)
//
// Dispatch module: composition of ArgvSurface::argv_surface_parse and
// Runner::runner_ls into a single entry point ls_dispatch(argv, argc).
// ls.ENH-004 (#18) folds the result through ExitMap::exit_map before
// returning, since this repo ships no `_start` frame -- ls_dispatch,
// named as `entry` in manifest.pdxproj, IS the entry boundary a
// wrapper would otherwise fold at. Every caller therefore sees the
// I4 vocabulary (0/2/3/4) rather than a raw 0xFFFFEBxx sentinel.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The one entry point a M2 _start frame calls. Every M1 harness test
// exercises the same wiring so the shape freezes here at M1-003 and
// the M2 additions (real sys_pdxfs_open + real KIND_TTY writes inside
// Runner) are body-only edits.
//
// Flow of ls_dispatch(argv, argc):
//
//   1. Call ArgvSurface::argv_surface_parse(argv, argc). Any return
//      != AS_OK (0xFFFFEB10) skips straight to step 4 with that
//      sentinel in rax.
//   2. On AS_OK, load _as_path_ptr + _as_flag_bits from
//      ArgvSurface's .bss.
//   3. Call Runner::runner_ls(path_ptr, flag_bits). rax becomes its
//      return (LS_RUN_STUB at M1; LS_OK / LS_ERR_* at M2+).
//   4. ls.ENH-004 (#18): call ExitMap::exit_map(rax) and return ITS
//      result. ls_dispatch's caller therefore always sees 0/2/3/4 --
//      never a raw 0xFFFFEBxx sentinel -- per design/architecture.md
//      §6.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Dispatch`), no directory
//     prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. AS_OK (0xFFFFEB10)
//     does NOT fit in a sign-extended imm32 (as u64 it is
//     0x00000000FFFFEB10 but a sign-extended imm32 of 0xFFFFEB10
//     encodes 0xFFFFFFFFFFFFEB10), so the compare stages the constant
//     into r10 first -- `mov r10, 0xFFFFEB10; cmp rax, r10` -- per
//     the "large immediates staged via r11/r10" convention (also
//     used by libpdx-elevate for 0xFFFFFFFFFFFFFFFF at
//     elevate_client_lookup_broker).
//   - r11 is scratch for every LEA base; r10 is scratch for the
//     staged AS_OK constant. Neither is assumed live across a call.
//   - No byte reads in this module.
//   - Non-leaf: one r12 push (for SysV 16-byte alignment across the
//     two nested calls -- argv_surface_parse and runner_ls -- and
//     for callee-save discipline per SysV convention even though r12
//     is not clobbered inside this function). Same idiom as
//     doc.M1-003's doc_dispatch_from_buf single-push wrapper (see
//     paideia-os/doc src/argv_dispatch.pdx L339).
//
// =============================================================================
// v1.1.0 (ls.ENH-006 / #19): --schema short-circuit
// =============================================================================
//
// After argv_surface_parse returns AS_OK, Dispatch inspects
// _as_flag_bits & AS_BIT_SCHEMA (0x10). When set, it calls
// SchemaDump::schema_dump_emit BEFORE Runner and returns LS_OK
// verbatim (folded to exit 0 by exit_map). --schema is a stateless
// read-of-manifest -- no directory read, no audit frame, no
// semantic-pipe emission -- so the runner_ls call is skipped
// entirely on this path.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   argv_surface_parse   -- ArgvSurface (src/argv_surface.pdx)
//   runner_ls            -- Runner (src/runner.pdx)
//   exit_map              -- ExitMap (src/exit_map.pdx), ls.ENH-004 (#18)
//   schema_dump_emit     -- SchemaDump (src/schema_dump.pdx), v1.1.0 ENH-006
//
// Read:
//   _as_path_ptr         -- ArgvSurface (src/argv_surface.pdx .bss)
//   _as_flag_bits        -- ArgvSurface (src/argv_surface.pdx .bss)

module Dispatch = structure {

  // ==========================================================================
  // ls_dispatch(argv, argc) -> u64
  //
  // Signature: ls_dispatch : (u64, u64) -> u64 !{mem} @{}
  //   RDI: argv  (u64* array of NUL-terminated arg pointers)
  //   RSI: argc  (count of entries in argv)
  //   RAX: the I4 exit-code vocabulary -- 0 (success), 2 (usage), 3
  //        (system), or 4 (capability denied) -- per ExitMap::
  //        exit_map. ls.ENH-004 (#18): no 0xFFFFEBxx sentinel ever
  //        escapes ls_dispatch.
  //
  // Register plan:
  //   r10 = AS_OK stage (large-imm compare workaround)
  //   r11 = scratch (LEA base for .bss reads)
  //   r12 = pushed for alignment + SysV callee-save discipline
  //   rdi/rsi = pass-through to argv_surface_parse; then loaded from
  //             .bss for runner_ls; then rdi reloaded with the
  //             pre-fold code for exit_map
  //   rax = pre-fold code in, folded I4 exit code out
  // ==========================================================================
  pub let ls_dispatch : (u64, u64) -> u64 !{mem} @{} =
    fn (argv: u64) (argc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.M1-003 (#3) + ls.ENH-004 (#18): the composition entry point named as `entry` in manifest.pdxproj. Passes argv/argc verbatim to ArgvSurface::argv_surface_parse. On AS_OK (0xFFFFEB10) loads _as_path_ptr + _as_flag_bits from ArgvSurface's .bss and calls Runner::runner_ls; any non-AS_OK argv-parse rejection instead falls straight to the shared epilogue with rax still holding the AS_ERR_* sentinel. Either way, the epilogue (ls_dp_done) moves rax into rdi and calls ExitMap::exit_map so ls_dispatch always returns the I4 vocabulary (0/2/3/4), never a raw 0xFFFFEBxx code -- this repo ships no `_start` frame, so ls_dispatch is the entry boundary the fold belongs at (design/enhancement-plan.md §7 point 3). The AS_OK compare stages the 0xFFFFEB10 constant into r10 because it does not fit in a sign-extended imm32 (paideia-as `cmp reg, imm <= 0x7FFFFFFF` rule -- same staging idiom libpdx-elevate uses for its 0xFFFFFFFFFFFFFFFF sentinel at elevate_client_lookup_broker). Push/pop parity: single r12 push aligns rsp % 16 to 0 for all three nested call sites (entry rsp % 16 == 8; one push takes it to 0; no additional call changes that alignment since r12 stays pushed until the shared epilogue) AND preserves r12 across every callee per SysV callee-save discipline. Same idiom as doc's doc_dispatch_from_buf (paideia-os/doc src/argv_dispatch.pdx L339). Labels prefixed ls_dp_.",
      block: {
        push r12;                            // alignment + callee-save

        // argv_surface_parse(argv, argc) -- rdi + rsi already correct
        // from our own SysV entry.
        call argv_surface_parse;

        // Compare against AS_OK. 0xFFFFEB10 does not fit in a sign-
        // extended imm32, so stage via r10.
        mov r10, 0xFFFFEB10;                 // AS_OK
        cmp rax, r10;
        jne ls_dp_done;                      // fold the parse error too

        // AS_OK. Load _as_flag_bits early so we can gate --schema
        // before dispatching Runner (v1.1.0 ENH-006 / #19).
        lea r11, [rip + _as_flag_bits];
        mov rsi, [r11];                      // rsi = flag_bits

        // ls.ENH-006 (#19) v1.1.0: --schema short-circuit. AS_BIT_
        // SCHEMA (0x10) -> emit catalog on KIND_TTY and return LS_OK
        // without invoking Runner. r10 scratch for the mask; rsi
        // preserved (still holds flag_bits for the runner path).
        mov r10, rsi;
        and r10, 0x10;                       // AS_BIT_SCHEMA
        cmp r10, 0;
        je  ls_dp_run_runner;                // no --schema -> runner path

        // --schema present: emit catalog + fold.
        call schema_dump_emit;
        // schema_dump_emit returns SD_OK (0) on success -> map through
        // exit_map (which routes 0xFFFFEB00-band unknowns to system,
        // but SD_OK is 0 which is NOT in the ls sub-band; the fold
        // treats it as unknown -> exit 3). Route the success case to
        // LS_OK explicitly so ExitMap folds it to 0.
        cmp rax, 0;
        jne ls_dp_done;                      // failure: propagate as-is
        mov rax, 0xFFFFEB00;                 // LS_OK -> exit 0
        jmp ls_dp_done;

      ls_dp_run_runner:
        // Standard runner path: load path_ptr + call runner_ls.
        lea r11, [rip + _as_path_ptr];
        mov rdi, [r11];
        // rsi already holds flag_bits from the load above.
        call runner_ls;
        // rax = Runner's return code (LS_RUN_STUB at M1; LS_OK / LS_
        // ERR_* at M2+). Fall through to the shared fold below.

      ls_dp_done:
        // ls.ENH-004 (#18): fold whatever 0xFFFFEBxx sentinel is in
        // rax (from either the parse-error early-out or Runner)
        // through ExitMap::exit_map before returning to our caller.
        mov rdi, rax;                        // ls_code arg for exit_map
        call exit_map;
        pop r12;
        ret
      }
    }
}
