// src/runner.pdx -- ls.M1-003 + ls.M3-001 + ls.M3-003 (paideia-os/ls#3 + #8 + #10)
//
// Runner module: the operation body -- iterate a held KIND_PDXFS_FILE
// (directory) cap via sys_pdxfs_dir_readnext (sysno 72), write each
// entry's name to KIND_TTY(write) one per line, and emit one typed
// PdxFsDirEntry record per entry to the stdout semantic-pipe endpoint.
// At M3-003 the whole body is wrapped in a libpdx-audit begin/commit
// pair (DirListRecord frame) so the D3 audit-first invariant holds:
// no user-visible byte on KIND_TTY or the stdout endpoint is emitted
// before the audit frame is open.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// At ls.M3-001 (#8) Runner FLIPS from LS_RUN_STUB to a real iteration
// body. The M1 STUB shape is preserved on unreachable paths (the
// path-argument gates still return the same LS_ERR_BAD_PATH they did
// at M1 for the empty-string reject) so the M4 correctness matrix
// keeps its M1 vocabulary; the LS_RUN_STUB return retires at M3 --
// every well-formed argv now resolves through the real syscall path
// to either LS_OK or one of the substrate-error sub-band codes:
//
//   LS_OK              (0xFFFFEB00)  entries iterated and emitted
//   LS_ERR_BAD_PATH    (0xFFFFEB21)  path_ptr != 0 && byte0 == 0
//   LS_ERR_READDIR     (0xFFFFEB22)  sys_pdxfs_dir_readnext returned -errno
//   LS_ERR_TTY_WRITE   (0xFFFFEB23)  sys_write (fd 1) returned -errno
//   LS_ERR_EMIT_BIND   (0xFFFFEB24)  libpdx-semantic-pipe bind refused
//   LS_ERR_EMIT_SEND   (0xFFFFEB25)  send_record refused
//   LS_ERR_AUDIT       (0xFFFFEB26)  libpdx-audit audit_begin refused (M3-003)
//
// =============================================================================
// PRE-OPENED DIR CAP CONVENTION
// =============================================================================
//
// The kernel's sys_pdxfs_open (sysno 71) is a MINT operation whose
// parent argument must be a KIND_MEMORY cap carrying RIGHT_MINT (see
// paideia-os src/kernel/core/syscall/handlers/sys_pdxfs_open.pdx §
// pdxfs_file_cap_mint_inner requirements). ls does NOT hold such a
// parent -- read-only tools cannot mint filesystem caps. Instead,
// shell.M2 will hand ls a pre-narrowed KIND_PDXFS_FILE(read, <arg-
// path>) at exec time via the InitCap sidecar per r49-r50-plan.md
// §4.4 ("the tool's cap request narrows to exactly the argument
// path"). The M3-001 Runner therefore does NOT call sys_pdxfs_open;
// it calls sys_pdxfs_dir_readnext on the pre-handed cap slot pinned
// at LS_DIR_CAP_SLOT (2).
//
// LS_DIR_CAP_SLOT = 2 is chosen to match the caps.decl order:
//   slot 0: KIND_USER
//   slot 1: KIND_TTY(write)
//   slot 2: KIND_PDXFS_FILE(read, <arg-path>)   <-- Runner reads here
//   slot 3: KIND_IPC_ENDPOINT                    <-- SemanticEmit uses this
//
// At M3, when ls runs without shell.M2 having populated the cap_table
// yet, sys_pdxfs_dir_readnext returns -EBADF and Runner surfaces
// LS_ERR_READDIR -- correct substrate-wiring behaviour; the emission
// path lights up in a live end-to-end run once shell.M2 lands. This
// matches the "substrate wiring shipped, live behavior gated on the
// cap-handoff round" idiom every M3 R49 tool uses.
//
// =============================================================================
// FLOW (M3-001 + M3-003)
// =============================================================================
//
//   (1) Gate path_ptr as at M1 (empty string -> LS_ERR_BAD_PATH; null
//       path is legal at M3 and means "default to the pre-opened
//       LS_DIR_CAP_SLOT cap" -- the shell narrows to the concrete arg
//       path at exec, so ls does not resolve paths itself at M3).
//   (1b) M3-003: audit_ls_begin(path_ptr, flag_bits) -- open the
//       DirListRecord audit frame BEFORE any user-visible byte is
//       emitted (D3 invariant). On refusal return LS_ERR_AUDIT
//       without touching KIND_TTY or the semantic-pipe endpoint.
//   (2) sem_emit_reset() -- imprint the PdxFsDirEntry@0.1 schema id
//       (ls.ENH-010, #27: real spipe_schema_id_from_name fold, not
//       a stub).
//   (3) sem_emit_bind_stdout() -- bind LS_STDOUT_ENDPOINT_SLOT to
//       PdxFsDirEntry@0.1. On refusal return LS_ERR_EMIT_BIND.
//   (4) Loop:
//       (a) pdxfs_dir_readnext(LS_DIR_CAP_SLOT, &_rn_entry_buf) -> rc
//       (b) rc == 1 -> entry written; proceed.
//           rc == 0 -> end-of-directory; break.
//           other  -> LS_ERR_READDIR (propagate).
//       (c) Extract name_ptr = _rn_entry_buf + PDXFS_DIR_ENT_OFF_NAME
//           and name_len = *(_rn_entry_buf + PDXFS_DIR_ENT_OFF_NAME_LEN)
//       (d) hidden_filter_accept(name_ptr, flag_bits & AS_BIT_A):
//           reject -> ls_note(LS_ST_HIDDEN); continue loop.
//           accept -> proceed.
//       (e) Compose name + '\n' into _rn_line_buf (name_len + 1 bytes);
//           tty_write(&_rn_line_buf, name_len + 1). On refusal
//           return LS_ERR_TTY_WRITE.
//       (f) sem_emit_entry(&_rn_entry_buf). On refusal return
//           LS_ERR_EMIT_SEND.
//       (g) ls_note(LS_ST_ENTRIES); continue loop.
//   (5) Return LS_OK.
//
// Every ret path (except the pre-audit LS_ERR_BAD_PATH branch) flows
// through rn_ls_epilogue which calls audit_ls_commit(exit_code)
// before unwinding. audit_ls_commit is safe to call on the pre-audit
// path too -- it gates internally on _au_id != 0 -- so the epilogue
// unification is unconditional.
//
// =============================================================================
// AS_BIT_A DEPENDENCY
// =============================================================================
//
// Runner reads bit 1 of flag_bits (AS_BIT_A per ArgvSurface). Value
// mirrored locally as RN_BIT_A_MASK = 0x2 so this file does not have
// to import ArgvSurface's constants -- the bit position is stable
// across the R49 wave (see design/architecture.md §3.1 bit table).
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Runner`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Immediates in this
//     module: 0 (null-check), 1 (readnext-entry discriminator), 2
//     (RN_BIT_A_MASK), 16 (PDXFS_DIR_ENT_OFF_NAME_LEN), 24
//     (PDXFS_DIR_ENT_OFF_NAME), 104 (PDXFS_DIR_NAME_MAX + 1 line-cap
//     bound). The 0xFFFFEB2x error returns are `mov rax, imm64`
//     emissions, not compares.
//   - Byte reads (name-copy loop into _rn_line_buf) use `xor rax;
//     mov_b rax, [ptr]` per #1248.
//   - Byte writes (name-copy loop tail + '\n' terminator) use
//     `mov_b [dst], reg`.
//   - r11 is scratch; r10 is scratch (both used as ephemeral address
//     holders in the copy loop).
//   - Non-leaf; many nested calls. Six callee-save pushes (rbx =
//     dir_cap_slot copy for pipeline stability across readnext + tty_
//     write + sem_emit_entry, r12 = path_ptr, r13 = flag_bits, r14 =
//     name_len for the current entry, r15 = _rn_line_buf base, rbp =
//     name_ptr) + `sub rsp, 8` pad = 56 bytes; entry rsp % 16 == 8;
//     8 + 56 = 64; 64 % 16 == 0 at every nested-call site. Every ret
//     path unwinds through rn_ls_epilogue which does the 6 pops + the
//     rsp restore in one place.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   ls_note                -- Ls (src/ls.pdx)
//   pdxfs_dir_readnext     -- PdxfsShim (src/pdxfs_shim.pdx)
//   tty_write              -- TtyWrite (src/tty_write.pdx)
//   hidden_filter_accept   -- HiddenFilter (src/hidden_filter.pdx)
//   sem_emit_reset         -- SemanticEmit (src/semantic_emit.pdx)
//   sem_emit_bind_stdout   -- SemanticEmit (src/semantic_emit.pdx)
//   sem_emit_entry         -- SemanticEmit (src/semantic_emit.pdx)
//   audit_ls_begin         -- AuditShim (src/audit_shim.pdx) -- M3-003
//   audit_ls_commit        -- AuditShim (src/audit_shim.pdx) -- M3-003

module Runner = structure {

  // ==========================================================================
  // Constants (locally mirrored so this file does not depend on
  // ArgvSurface's bit vocabulary; the M4 smoke matrix catches drift).
  // ==========================================================================

  // ArgvSurface AS_BIT_A mask (mirrored -- see design/architecture.md §3.1)
  pub let RN_BIT_A_MASK           : u64 = 0x2
  // ls.ENH-019 (#37): -F type-indicator suffix mask (AS_BIT_F).
  pub let RN_BIT_F_MASK           : u64 = 0x1000
  // ls.ENH-019 (#37): kind-nibble offset inside the 128-byte kernel
  // PdxFsDirEntry record. See paideia-os
  // src/kernel/core/cap/pdxfs_dir_iter.pdx §1 (inode@0, kind@8,
  // name_len@16, name[104]@24). The kind qword's low 4 bits carry the
  // PdxFS-v1 file-type nibble (0x4=dir, 0x8=file, 0xA=symlink, ...).
  pub let RN_ENT_OFF_KIND         : u64 = 8

  // Kernel PdxFsDirEntry offsets (mirror paideia-os
  // src/kernel/core/cap/pdxfs_dir_iter.pdx §1).
  pub let RN_ENT_OFF_NAME_LEN     : u64 = 16
  pub let RN_ENT_OFF_NAME         : u64 = 24
  pub let RN_ENT_NAME_MAX         : u64 = 104
  pub let RN_ENT_SIZE             : u64 = 128

  // Pre-opened directory cap slot (see file header).
  pub let LS_DIR_CAP_SLOT         : u64 = 2

  // sys_pdxfs_dir_readnext discriminators.
  pub let RN_READNEXT_ENTRY       : u64 = 1
  pub let RN_READNEXT_EOD         : u64 = 0

  // Stat slot ids (mirror Ls; kept as local constants so this file
  // does not have to import Ls's slot names).
  pub let RN_STAT_RUNS            : u64 = 2
  pub let RN_STAT_ENTRIES         : u64 = 3
  pub let RN_STAT_ERRORS          : u64 = 4
  pub let RN_STAT_HIDDEN          : u64 = 5

  // ==========================================================================
  // .bss
  // ==========================================================================
  //
  // _rn_entry_buf -- 128-byte scratch that sys_pdxfs_dir_readnext
  // writes into (one entry at a time). 16 u64 lanes.
  //
  // _rn_line_buf -- name + '\n' composition buffer for the tty_write
  // call. Sized RN_ENT_NAME_MAX + 1 = 105 bytes = 14 u64 lanes rounded
  // up.
  pub let mut _rn_entry_buf : [u64; 16] = uninit @align(8)
  pub let mut _rn_line_buf  : [u64; 14] = uninit @align(8)

  // ==========================================================================
  // runner_ls(path_ptr, flag_bits) -> u64
  //
  // Signature: (u64, u64) -> u64 !{mem, sysreg} @{cap}
  //   RDI (input): path_ptr   -- NUL-terminated path (informational at
  //                              M3 -- shell narrows the dir cap at
  //                              exec; kept in the signature for the
  //                              R51+ path-multiplex round).
  //   RSI (input): flag_bits  -- OR of ArgvSurface::AS_BIT_*.
  //   RAX (output): LS_OK on success; one of the substrate-error
  //                 sub-band codes (see file header) on refusal.
  //
  // See file header §Flow for the step-by-step body.
  // ==========================================================================
  pub let runner_ls : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (path_ptr: u64) (flag_bits: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "ls.M3-001 (#8) + ls.M3-003 (#10): Runner flips from LS_RUN_STUB to a real iteration body, wrapped in a libpdx-audit DirListRecord frame (D3 audit-first). Uses pdxfs_dir_readnext (sysno 72) against a pre-handed KIND_PDXFS_FILE(read, <arg-path>) at LS_DIR_CAP_SLOT (2, per caps.decl order). Bumps LS_ST_RUNS on entry unconditionally so the counter records every ATTEMPT. Argument gates preserve the M1 shape: null path_ptr resolves through the read loop with the pre-handed cap (informational path; shell narrowed the cap already); non-null path_ptr with byte0 == 0 refuses with LS_ERR_BAD_PATH. M3-003 audit-open: audit_ls_begin(path_ptr, flag_bits) called AFTER the path gate and BEFORE sem_emit_reset -- this is the boundary the D3 invariant pins (no user-visible byte until the audit frame is open). Refusal returns LS_ERR_AUDIT (0xFFFFEB26). Emit prelude: sem_emit_reset + sem_emit_bind_stdout must succeed before the read loop; bind refusal returns LS_ERR_EMIT_BIND. Loop: pdxfs_dir_readnext(LS_DIR_CAP_SLOT, &_rn_entry_buf); rc == 1 -> proceed; rc == 0 -> break; else LS_ERR_READDIR. Per-entry: extract name_len (offset 16) + name_ptr (offset 24) from the 128-byte record; hidden_filter_accept(name_ptr, flag_bits & AS_BIT_A) -- rejects bump LS_ST_HIDDEN and loop; accepts compose name + '\\n' in _rn_line_buf (byte copy loop with #1248 mitigation) and tty_write; tty_write refusal (negative rax) -> LS_ERR_TTY_WRITE; then sem_emit_entry (144-byte record over the bound stdout endpoint, M3-002 shape with owner Cap wire) -> LS_ERR_EMIT_SEND on refusal; bump LS_ST_ENTRIES; continue. Every ret path (except the pre-audit LS_ERR_BAD_PATH -- but that too goes through the same epilogue because audit_ls_commit is a no-op on _au_id == 0) flows through rn_ls_epilogue which saves exit_code in r13 (dead at epilogue -- flag_bits done), calls audit_ls_commit, then restores rax and unwinds. Six callee-save pushes (rbx = LS_DIR_CAP_SLOT copy; r12 = path_ptr; r13 = flag_bits then exit_code carry; r14 = name_len for the current entry; r15 = _rn_line_buf base for the tty_write call; rbp = name_ptr for the tty_write + hidden_filter_accept chain) + sub rsp,8 pad = 56 bytes; entry rsp % 16 == 8; 8 + 56 = 64; 64 % 16 == 0 at every nested-call site (ls_note, audit_ls_begin, sem_emit_reset, sem_emit_bind_stdout, pdxfs_dir_readnext, hidden_filter_accept, tty_write, sem_emit_entry, audit_ls_commit). Matched add rsp,8 + 6 pops before every ret via the shared rn_ls_epilogue label. paideia-as conformance: r11 + r10 for LEA + byte-address scratch; no test mnemonic; largest cmp immediate 128 (RN_ENT_SIZE) fits imm32; the 0xFFFFEB2x return sentinels are mov rax, imm64 emissions, not compares. Effects widened to !{mem, sysreg} @{cap} matching the union of the callees (pdxfs_dir_readnext + tty_write + sem_emit_entry + audit_ls_begin + audit_ls_commit all carry {mem, sysreg}; pdxfs_dir_readnext + sem_emit_entry + audit_ls_begin + audit_ls_commit carry @{cap}). Labels prefixed rn_ls_.",
      block: {
        // ---- 6-push prologue + 8-byte alignment pad ------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                              // rsp % 16 == 0 for nested calls

        mov r12, rdi;                            // path_ptr
        mov r13, rsi;                            // flag_bits

        // ---- Bump LS_ST_RUNS -----------------------------------------
        mov rdi, 2;                              // RN_STAT_RUNS
        call ls_note;

        // ---- Path arg gate (empty-string reject preserved from M1) --
        cmp r12, 0;
        je  rn_ls_audit_open;                    // null path -> proceed
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 0;
        je  rn_ls_bad_path;

      rn_ls_audit_open:
        // ---- M3-003: open DirListRecord audit frame (D3) -------------
        //
        // MUST happen before any user-visible byte reaches KIND_TTY
        // or the semantic-pipe endpoint. On refusal, we return
        // LS_ERR_AUDIT via the epilogue -- audit_ls_commit is a no-op
        // when _au_id == 0 (which it stays on refusal), so the
        // unified epilogue is safe.
        mov rdi, r12;                            // path_ptr
        mov rsi, r13;                            // flag_bits
        call audit_ls_begin;
        cmp rax, 0;                              // AU_OK
        jne rn_ls_audit_fail;

      rn_ls_pre_emit:
        // ---- Emit prelude: schema-imprint + bind ---------------------
        call sem_emit_reset;
        call sem_emit_bind_stdout;
        cmp rax, 0;                              // SE_OK
        jne rn_ls_bind_fail;

        // ---- Load LS_DIR_CAP_SLOT into rbx for the loop --------------
        mov rbx, 2;                              // LS_DIR_CAP_SLOT

      rn_ls_loop:
        // ---- pdxfs_dir_readnext(LS_DIR_CAP_SLOT, &_rn_entry_buf) ----
        mov rdi, rbx;                            // dir_cap_slot
        lea r11, [rip + _rn_entry_buf];
        mov rsi, r11;                            // entry_buf_va
        call pdxfs_dir_readnext;

        // rc discriminate.
        cmp rax, 1;                              // RN_READNEXT_ENTRY
        je  rn_ls_have_entry;
        cmp rax, 0;                              // RN_READNEXT_EOD
        je  rn_ls_done;

        // Any other value -> negative-errno; propagate as LS_ERR_READDIR.
        jmp rn_ls_readdir_fail;

      rn_ls_have_entry:
        // ---- Load name_len (offset 16) and name_ptr (offset 24) ------
        lea r11, [rip + _rn_entry_buf];
        mov r14, [r11 + 16];                     // name_len

        lea r11, [rip + _rn_entry_buf];
        add r11, 24;                             // name_ptr = &entry + 24
        mov rbp, r11;                            // rbp = name_ptr

        // ---- hidden_filter_accept(name_ptr, flag_bits & AS_BIT_A) ---
        mov rdi, rbp;
        mov rsi, r13;
        mov r10, 2;                              // RN_BIT_A_MASK
        and rsi, r10;                            // show_hidden = flag_bits & AS_BIT_A
        call hidden_filter_accept;

        cmp rax, 0;
        je  rn_ls_hidden;                        // filtered out

        // ---- Compose _rn_line_buf: copy name bytes + '\n' -----------
        //
        // Bound the name copy at min(name_len, RN_ENT_NAME_MAX) so a
        // corrupt name_len from a broken upstream cannot overflow
        // _rn_line_buf.
        mov rcx, r14;                            // name_len
        mov r10, 104;                            // RN_ENT_NAME_MAX
        cmp rcx, r10;
        jbe rn_ls_len_ok;
        mov rcx, r10;                            // clamp

      rn_ls_len_ok:
        // r14 = actual bytes-to-copy (clamped)
        mov r14, rcx;

        lea r15, [rip + _rn_line_buf];           // dst base

        // Byte-copy loop: rax = index 0..rcx (using rcx as remaining).
        // We use a fresh index r10 inside the loop; r14 holds the
        // authoritative clamped length.
        xor r10, r10;                            // idx = 0

      rn_ls_copy_head:
        cmp r10, r14;                            // idx < len ?
        jae rn_ls_copy_done;

        mov r11, rbp;                            // &src[0]
        add r11, r10;                            // &src[idx]
        xor rax, rax;                            // #1248 mitigation
        mov_b rax, [r11];

        mov r11, r15;                            // &dst[0]
        add r11, r10;                            // &dst[idx]
        mov_b [r11], rax;

        add r10, 1;
        jmp rn_ls_copy_head;

      rn_ls_copy_done:
        // ---- ls.ENH-019 (#37): -F type-indicator suffix -----------
        //
        // When AS_BIT_F is set in flag_bits, inspect the entry's kind
        // nibble at record offset 8 and append a single suffix byte
        // before the '\n':
        //   nibble 0x4 (dir)     -> '/'
        //   nibble 0xA (symlink) -> '@'
        //   nibble 0x8 (file)    -> no suffix at v1.1 (exec '*' awaits
        //                           the kernel record growing a mode
        //                           field via sys_pdxfs_stat_by_inode --
        //                           tracked as follow-up, aligned with
        //                           ENH-008 owner deferral).
        //   other                -> no suffix.
        //
        // r10 = suffix byte, rax = kind qword scratch.
        mov r10, r13;                            // r10 = flag_bits copy
        mov r11, 0x1000;                         // RN_BIT_F_MASK
        and r10, r11;
        cmp r10, 0;
        je  rn_ls_no_suffix;
        // Load kind at offset 8.
        lea r11, [rip + _rn_entry_buf];
        mov rax, [r11 + 8];                      // RN_ENT_OFF_KIND
        and rax, 0xF;                            // low 4 bits = nibble
        cmp rax, 0x4;
        je  rn_ls_suffix_dir;
        cmp rax, 0xA;
        je  rn_ls_suffix_sym;
        jmp rn_ls_no_suffix;

      rn_ls_suffix_dir:
        mov r10, 0x2F;                           // '/'
        jmp rn_ls_suffix_emit;

      rn_ls_suffix_sym:
        mov r10, 0x40;                           // '@'
        jmp rn_ls_suffix_emit;

      rn_ls_suffix_emit:
        // dst[len] = suffix; len++
        mov r11, r15;
        add r11, r14;
        mov_b [r11], r10;
        add r14, 1;

      rn_ls_no_suffix:
        // ---- Append '\n' -----------------------------------------
        mov r11, r15;
        add r11, r14;                            // &dst[len]
        mov rax, 0x0A;                           // '\n'
        mov_b [r11], rax;

        // ---- tty_write(&_rn_line_buf, len + 1) ------------------------
        mov rdi, r15;
        mov rsi, r14;
        add rsi, 1;                              // len + 1 (name + '\n')
        call tty_write;

        // sys_write returns bytes_written on success; negative-errno on
        // failure. Detect failure with cmp rax, 0; jl (signed) -- if
        // rax has bit 63 set, it is a negative-errno.
        cmp rax, 0;
        jl  rn_ls_tty_fail;

        // ---- sem_emit_entry(&_rn_entry_buf) --------------------------
        lea r11, [rip + _rn_entry_buf];
        mov rdi, r11;
        call sem_emit_entry;

        cmp rax, 0;                              // SE_OK
        jne rn_ls_send_fail;

        // ---- Bump LS_ST_ENTRIES + continue loop ----------------------
        mov rdi, 3;                              // RN_STAT_ENTRIES
        call ls_note;

        jmp rn_ls_loop;

      rn_ls_hidden:
        // ---- Hidden: bump LS_ST_HIDDEN + continue --------------------
        mov rdi, 5;                              // RN_STAT_HIDDEN
        call ls_note;
        jmp rn_ls_loop;

      rn_ls_done:
        // ---- Success --------------------------------------------------
        mov rax, 0xFFFFEB00;                     // LS_OK
        jmp rn_ls_epilogue;

      rn_ls_bad_path:
        mov rdi, 4;                              // RN_STAT_ERRORS
        call ls_note;
        mov rax, 0xFFFFEB21;                     // LS_ERR_BAD_PATH
        jmp rn_ls_epilogue;

      rn_ls_bind_fail:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB24;                     // LS_ERR_EMIT_BIND
        jmp rn_ls_epilogue;

      rn_ls_readdir_fail:
        // ls.ENH-015 (#33): when the cap at LS_DIR_CAP_SLOT is a
        // regular file rather than a directory, sys_pdxfs_dir_readnext
        // returns -EBADF here (0xFFFFFFFFFFFFFFF7 -- kind mismatch on
        // the dir-mode gate). The POSIX fall-through would compose one
        // entry-shaped record from the file cap's row (via a
        // pdxfs_file_stat_by_slot trampoline that does not yet exist in
        // PdxfsShim) and emit a single line + one PdxFsDirEntry record.
        // Blocked by #29 (path-resolve) for the argument-driven cap
        // narrowing that must precede the file/dir discrimination;
        // land the discrimination + single-entry emit as follow-up to
        // #29. Today: continue to surface LS_ERR_READDIR so the current
        // exit vocabulary stays honest.
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB22;                     // LS_ERR_READDIR
        jmp rn_ls_epilogue;

      rn_ls_tty_fail:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB23;                     // LS_ERR_TTY_WRITE
        jmp rn_ls_epilogue;

      rn_ls_send_fail:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB25;                     // LS_ERR_EMIT_SEND
        jmp rn_ls_epilogue;

      rn_ls_audit_fail:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB26;                     // LS_ERR_AUDIT
        // audit_ls_commit is a no-op here (_au_id stayed 0) so the
        // unified epilogue is safe -- no separate no-audit epilogue
        // needed.
        jmp rn_ls_epilogue;

      rn_ls_epilogue:
        // ---- M3-003: close DirListRecord audit frame -----------------
        //
        // Save exit code in r13 (dead at this point -- flag_bits no
        // longer needed), call audit_ls_commit, restore.
        // audit_ls_commit gates internally on _au_id != 0, so the
        // pre-audit LS_ERR_BAD_PATH path is safe here.
        mov r13, rax;                            // save exit_code
        mov rdi, r13;
        call audit_ls_commit;                    // clobbers rax
        mov rax, r13;                            // restore exit_code

        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
