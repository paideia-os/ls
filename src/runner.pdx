// src/runner.pdx -- ls v1.1-A (paideia-os/ls M1-001 STUB retirement)
//
// Runner module: the ls operation body. v1.1-A REPLACES the M1-M4
// ceremonial cap-based body -- which called sys_pdxfs_dir_readnext
// (sysno 72) on a pre-narrowed KIND_PDXFS_FILE cap slot that
// shell.M2's InitCap handoff never actually populated, so every
// invocation refused with LS_ERR_READDIR (-EBADF from the kernel) --
// with a REAL end-to-end body that reaches the filesystem through
// the path-addressed POSIX-compat primitives sys_stat (77) /
// sys_open (2) / sys_getdents (78) / sys_close (3), and writes each
// name to fd 1 via the existing TtyWrite::tty_write trampoline
// (sysno 1, UART fast-path per src/kernel/core/syscall/dispatch.pdx
// L515).
//
// =============================================================================
// SCOPE OF v1.1-A (deliberately narrow)
// =============================================================================
//
// One name per line. No column layout. No color. No -l long format.
// No -a hidden-file gating (every entry the kernel hands back is
// written, including dot-prefixed ones -- a proper -a/-A split
// lands with v1.2 when the flag_bits path re-engages). No -R
// recursion. No --json. No semantic-pipe emission. No audit frame.
// No sort. No -F suffix. No group-directories-first.
//
// This is the "just make ls actually enumerate a directory"
// deliverable the user's dev loop has been asking for since the
// M1-M4 wave completed. Every one of the deferred features above
// lands as a use-site edit against THIS Runner body in a later
// round -- the pre-v1.1-A modules (LongFormat, JsonLine, ColorPicker,
// Columns, HiddenFilter, HumanSize, OwnerCol, SemanticEmit,
// AuditShim, GroupSort, SortOptions, RecurseFilter, RecurseHeader,
// SchemaDump, LongTotal) are still in-tree exactly as they were, so
// their re-engagement is a Runner-body edit rather than a
// re-declare. Dispatch's --schema short-circuit (which never went
// through Runner) is unaffected.
//
// =============================================================================
// FLOW
// =============================================================================
//
//   (1) Default path: if path_ptr == 0 (the pos_count-0 case
//       Dispatch passes through as the _as_path_ptr sentinel), use
//       the local _rn_default_path (".\0").
//
//   (2) sys_stat(path_ptr, RN_STAT_PATH_HINT, &_rn_stat_buf). Any
//       non-zero return (missing path, kernel-half VA, ...) is
//       LS_ERR_BAD_PATH (0xFFFFEB21). This costs one syscall per
//       invocation but keeps the LS_ERR_BAD_PATH sub-band the M1
//       tests/exit_matrix.pdx fixture already pins meaningful --
//       LS_ERR_READDIR gets reserved for enumeration failures on a
//       path that DID resolve.
//
//   (3) sys_open(path_ptr, 0 /*O_RDONLY*/, 0 /*mode*/) -> fd. Any
//       negative-errno return (bit 63 set; caller detects via
//       `cmp rax, 0; jl`) -> LS_ERR_READDIR (same sub-band the
//       downstream getdents-time failures use; open-vs-enumerate
//       distinction is not part of the v1.1-A external vocabulary).
//
//   (4) Loop:
//         (a) sys_getdents(fd, &_rn_getdents_buf,
//                          RN_GD_BUF_CAP=4096) -> rax.
//         (b) rax == 0 -> end-of-directory; break.
//             rax  < 0 -> close fd + LS_ERR_READDIR (propagate).
//             rax  > 0 -> proceed to record walk.
//         (c) Walk records from cursor = base to end = base + rax:
//               name_len_u16 = *(u64)(cursor + 8) & 0xFFFF
//               (the u64 load spans name_len@8 + type@10 +
//                reserved@11 + name[0..4]; the mask isolates
//                name_len -- avoids needing a mov_w mnemonic
//                paideia-as's encoder does not yet expose to userspace).
//               if name_len == 0 -> terminator; fetch next batch.
//               tty_write(cursor + 12, name_len)
//               tty_write(&_rn_newline, 1)
//               cursor += 12 + name_len
//               continue.
//
//   (5) sys_close(fd). Return LS_OK (0xFFFFEB00).
//
// Dispatch's per-positional loop (src/dispatch.pdx §ls.ENH-014
// section) is unchanged: it still folds every Runner return
// through ExitMap immediately and returns the worst code. Because
// v1.1-A is path-addressed, `ls a b c` now actually reads three
// distinct directories (in the pre-v1.1-A cap body every call
// read through the same LS_DIR_CAP_SLOT).
//
// =============================================================================
// FLAG BITS
// =============================================================================
//
// v1.1-A IGNORES flag_bits entirely. Both the substantive user
// flags (-l / -a / -h / --color / --json / -R / -t / -S / -r /
// -1 / -C / -F / --group-directories-first) and the
// Dispatch<->Runner header bits (RN_BIT_HEADER_MASK /
// RN_BIT_HEADER_BLANK_MASK) are read-past. The rsi argument is
// still declared in the signature so Dispatch's call site does not
// have to change. Flag re-engagement is scoped to v1.2 (columns +
// header lines), v1.3 (color / -l / -a), and beyond -- see the
// SCOPE section for the full deferral list.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module basename PascalCase (`Runner`), no directory prefix
//     (same module name as the pre-v1.1-A body -- Dispatch's
//     `call runner_ls` is a symbol reference that resolves against
//     THIS file after rebuild).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Immediates in
//     this module: 0 (null-check + EOD-check + name_len terminator
//     + O_RDONLY flag), 12 (record header size), 255
//     (RN_STAT_PATH_HINT), 4096 (getdents buffer cap), 0xFFFF
//     (name_len mask); every larger value (LS_OK /
//     LS_ERR_BAD_PATH / LS_ERR_READDIR) is a `mov rax, imm64`
//     emission, not a compare.
//   - No byte reads (the u64 load + mask pattern for name_len
//     sidesteps the mov_w gap; the record's name payload is passed
//     by pointer to tty_write, never loaded byte-by-byte here).
//   - r11 is scratch (paideia-as reserved); r10 is scratch (used
//     transiently for the name_len extraction).
//   - Non-leaf: 5 callee-save pushes (rbx=fd, r12=cursor,
//     r13=end-cursor, r14=buf-base, rbp=path_ptr) => 40 bytes; entry
//     rsp % 16 == 8; 8 + 40 = 48; 48 % 16 == 0 at every nested-call
//     site (sys_stat, sys_open, sys_getdents, sys_close, tty_write).
//     No `sub rsp, 8` pad needed -- the 5-push count already
//     restores 16-byte alignment. Matched 5 pops via the single
//     shared rn_ls_epilogue label every ret path converges on.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   sys_stat, sys_open, sys_close, sys_getdents  -- PosixShim
//                                                   (src/posix_shim.pdx)
//   tty_write                                     -- TtyWrite
//                                                   (src/tty_write.pdx)

module Runner = structure {

  // ==========================================================================
  // Return-code sentinels (mirror Ls's error band -- see src/ls.pdx
  // §Return-code band 0xFFFFEBxx). Redeclared as u64 locals so this
  // file does not have to import Ls; the M4 smoke matrix catches any
  // drift between the mirrors here and the authoritative Ls values.
  // ==========================================================================
  pub let LS_OK             : u64 = 0xFFFFEB00
  pub let LS_ERR_BAD_PATH   : u64 = 0xFFFFEB21
  pub let LS_ERR_READDIR    : u64 = 0xFFFFEB22

  // ==========================================================================
  // Constants used by the record walk.
  // ==========================================================================

  // Bytes to skip past the fixed record header (ino@0 u64 +
  // name_len@8 u16 + type@10 u8 + reserved@11 u8 = 12 bytes) to reach
  // name[0]. Frozen at paideia-os src/kernel/core/syscall/
  // sys_getdents.pdx §Record layout for R56.M3.
  pub let RN_REC_HDR_BYTES  : u64 = 12
  // Mask that isolates name_len from a u64 load at (cursor + 8).
  // The load spans name_len (2 bytes) + type (1) + reserved (1) +
  // name[0..4] (4); the mask keeps only the two low bytes.
  pub let RN_NAME_LEN_MASK  : u64 = 0xFFFF
  // Directory getdents batch size. Fixed at one page; see PosixShim's
  // PSH_GETDENTS_BUF_CAP for the rationale.
  pub let RN_GD_BUF_CAP     : u64 = 4096
  // sys_stat path_len_hint. Fixed at 255 -- see PosixShim's
  // PSH_PATH_HINT_DEFAULT and design/user/syscall-table.md row 85 for
  // the walker-CAP convention.
  pub let RN_STAT_PATH_HINT : u64 = 255

  // ==========================================================================
  // Immutable defaults (.rodata).
  //
  // _rn_default_path -- ".\0" (0x2E 0x00). Used when path_ptr == 0
  //   at Runner entry (the pos_count-0 case Dispatch passes through
  //   as the _as_path_ptr sentinel). Explicit NUL terminator so
  //   sys_open's user_read_str_via_walk halts inside the two-byte
  //   footprint rather than reading into the next .rodata symbol.
  //
  // _rn_newline -- 0x0A. Written after each directory entry name so
  //   the output stays one-name-per-line without a per-call
  //   composition step.
  // ==========================================================================
  pub let _rn_default_path : [u8; 2] = [0x2E, 0x00]
  pub let _rn_newline      : [u8; 1] = [0x0A]

  // ==========================================================================
  // .bss scratch.
  //
  // _rn_getdents_buf -- 4096-byte user scratch sys_getdents writes
  //   into (one batch at a time). 513 u64 lanes @align(8): the
  //   first 512 (= 4096 bytes = RN_GD_BUF_CAP) are the syscall
  //   destination; the trailing 8-byte lane is unused headroom the
  //   record walk relies on. The walk's name_len extraction does a
  //   u64 load at (cursor + 8); when the last live record sits
  //   flush against the batch tail the cursor advances into the
  //   12-byte terminator header, and the load at
  //   (terminator_start + 8) reads 4 bytes past the terminator's
  //   own name_len field. Without the headroom lane, an exactly-
  //   full 4096-byte return (kernel guarantees a terminator so this
  //   is the tight worst case) would overread the last 4 bytes
  //   into whatever .bss symbol the linker packed next -- benign
  //   if it is also .bss, but a fault risk if the next page were
  //   unmapped. The pad lane keeps the overread strictly within
  //   this symbol.
  //
  // _rn_stat_buf -- 64-byte user scratch sys_stat writes into.
  //   8 u64 lanes @align(8). v1.1-A only uses the buffer as an
  //   existence-check sink -- no field is inspected -- but the
  //   allocation is real so the syscall does not fault on a null
  //   write pointer.
  // ==========================================================================
  pub let mut _rn_getdents_buf : [u64; 513] = uninit @align(8)
  pub let mut _rn_stat_buf     : [u64; 8]   = uninit @align(8)

  // ==========================================================================
  // runner_ls(path_ptr, flag_bits) -> u64
  //
  // Signature: (u64, u64) -> u64 !{mem, sysreg} @{}
  //   RDI (input): path_ptr  -- NUL-terminated user path; 0 -> "."
  //   RSI (input): flag_bits -- IGNORED at v1.1-A (see file header)
  //   RAX (output): LS_OK on success, LS_ERR_BAD_PATH if the path
  //                 does not resolve, LS_ERR_READDIR if enumeration
  //                 fails after the path resolves.
  //
  // Register plan (non-leaf, 5 callee-save pushes -- see file
  // header §PAIDEIA-AS CONFORMANCE for the alignment arithmetic):
  //   rbx = fd (from sys_open; held across the getdents loop and
  //             the close call).
  //   r12 = record cursor (moves through the getdents batch).
  //   r13 = record end (base + bytes returned by the last
  //         sys_getdents call).
  //   r14 = _rn_getdents_buf base (loaded once via lea).
  //   rbp = path_ptr (saved from the initial rdi; sys_stat and
  //         sys_open both consume rdi so we cannot leave it live
  //         in-place).
  //   r10 = scratch (name_len extraction; not preserved across
  //         calls, refreshed per record).
  //   r11 = scratch (LEA base for .rodata reaches; not preserved).
  // ==========================================================================
  pub let runner_ls : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (path_ptr: u64) (flag_bits: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "ls v1.1-A: real path-addressed body replacing the M1-M4 cap-slot STUB (which called sys_pdxfs_dir_readnext (sysno 72) on a pre-narrowed KIND_PDXFS_FILE cap that shell.M2's InitCap handoff never populated -- every invocation returned LS_ERR_READDIR at HEAD). Flow: default path_ptr to _rn_default_path (\".\\0\") when 0 (the pos_count-0 case Dispatch passes as the _as_path_ptr sentinel); sys_stat as an existence check that surfaces missing-path as LS_ERR_BAD_PATH ahead of the more expensive open+enumerate path; sys_open (O_RDONLY=0, mode=0) -> fd; loop sys_getdents with a 4096-byte .bss buffer until it returns 0 (EOD); walk each returned batch record-by-record extracting name_len via a u64 load + 0xFFFF mask at cursor+8 (avoids needing a mov_w mnemonic paideia-as's encoder does not yet expose to userspace) and calling tty_write per name and per newline; sys_close on the way out. Every error path (open failure, getdents failure) drains fd via sys_close before returning LS_ERR_READDIR so the fd table does not leak. flag_bits is read-past at v1.1-A (see file-header §FLAG BITS) -- the substantive user flags (-l/-a/-h/--color/--json/-R/-t/-S/-r/-1/-C/-F/--group-directories-first) and the Dispatch<->Runner header bits (RN_BIT_HEADER_MASK / RN_BIT_HEADER_BLANK_MASK) all defer to later rounds. Non-leaf: 5 callee-save pushes (rbx=fd, r12=cursor, r13=end, r14=buf-base, rbp=path_ptr) = 40 bytes; entry rsp % 16 == 8; 8 + 40 = 48; 48 % 16 == 0 at every nested-call site (sys_stat, sys_open, sys_getdents, sys_close, tty_write). No `sub rsp, 8` pad needed -- the 5-push count already restores 16-byte alignment. Matched 5 pops via the single shared rn_ls_epilogue label. paideia-as conformance: no test mnemonic (every zero-check via cmp reg, 0); every cmp reg, imm uses imm <= 0x7FFFFFFF (0, 12, 255, 4096, 0xFFFF; every larger sentinel is a mov rax, imm64 emission). No byte reads (the u64 load + mask sidesteps mov_w; name payload is passed by pointer to tty_write, never inspected byte-wise here). r10 and r11 both scratch. Labels prefixed rn_ls_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;
        // rsp % 16 == 0 at every nested-call site.

        // Stash path_ptr; default to _rn_default_path when 0.
        mov rbp, rdi;
        cmp rbp, 0;
        jne rn_ls_have_path;
        lea rbp, [rip + _rn_default_path];

      rn_ls_have_path:
        // ---- (2) sys_stat(path, 255, &_rn_stat_buf) ---------------
        mov rdi, rbp;
        mov rsi, 255;                            // RN_STAT_PATH_HINT
        lea rdx, [rip + _rn_stat_buf];
        call sys_stat;
        cmp rax, 0;
        jne rn_ls_bad_path;                      // non-zero -> BAD_PATH

        // ---- (3) sys_open(path, 0 /*O_RDONLY*/, 0 /*mode*/) ------
        mov rdi, rbp;
        xor rsi, rsi;
        xor rdx, rdx;
        call sys_open;
        cmp rax, 0;
        jl  rn_ls_open_err;                      // signed negative -> errno
        mov rbx, rax;                            // rbx = fd

        // Base pointer of the getdents scratch, loaded once.
        lea r14, [rip + _rn_getdents_buf];

      rn_ls_gd_loop:
        // ---- (4a) sys_getdents(fd, buf, 4096) --------------------
        mov rdi, rbx;
        mov rsi, r14;
        mov rdx, 4096;                           // RN_GD_BUF_CAP
        call sys_getdents;
        cmp rax, 0;
        je  rn_ls_eod;                           // rax == 0 -> EOD
        jl  rn_ls_gd_err;                        // rax < 0  -> errno

        // rax > 0: bytes returned. Set cursor = base, end = base+rax.
        mov r12, r14;
        mov r13, r14;
        add r13, rax;

      rn_ls_rec_loop:
        cmp r12, r13;
        jae rn_ls_gd_loop;                       // batch drained; fetch next

        // Extract name_len via u64 load + 0xFFFF mask (see file
        // header rationale for the mov_w avoidance).
        mov r10, [r12 + 8];
        and r10, 0xFFFF;
        cmp r10, 0;
        je  rn_ls_gd_loop;                       // terminator -> next batch

        // tty_write(cursor + 12, name_len).
        mov rdi, r12;
        add rdi, 12;                             // RN_REC_HDR_BYTES
        mov rsi, r10;
        call tty_write;
        // Short-write / errno path ignored at v1.1-A -- a real retry
        // loop lands with the flag-bits re-engagement round; the
        // enumeration continues either way so an early bad byte does
        // not silently truncate the whole listing.

        // tty_write(&_rn_newline, 1).
        lea rdi, [rip + _rn_newline];
        mov rsi, 1;
        call tty_write;

        // cursor += 12 + name_len.
        add r12, 12;
        add r12, r10;
        jmp rn_ls_rec_loop;

      rn_ls_eod:
        // ---- (5) sys_close(fd); return LS_OK ---------------------
        mov rdi, rbx;
        call sys_close;
        mov rax, 0xFFFFEB00;                     // LS_OK
        jmp rn_ls_epilogue;

      rn_ls_gd_err:
        // sys_getdents failed mid-enumeration. Drain fd, return
        // LS_ERR_READDIR.
        mov rdi, rbx;
        call sys_close;
        mov rax, 0xFFFFEB22;                     // LS_ERR_READDIR
        jmp rn_ls_epilogue;

      rn_ls_open_err:
        // sys_open failed. No fd to drain -- fall straight through.
        mov rax, 0xFFFFEB22;                     // LS_ERR_READDIR
        jmp rn_ls_epilogue;

      rn_ls_bad_path:
        // sys_stat rejected the path. Return LS_ERR_BAD_PATH.
        mov rax, 0xFFFFEB21;                     // LS_ERR_BAD_PATH

      rn_ls_epilogue:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
