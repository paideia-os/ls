// src/runner.pdx -- ls.M1-003 + ls.M3-001 + ls.M3-003 (paideia-os/ls#3 + #8 + #10)
//
// Runner module: the operation body -- iterate a held KIND_PDXFS_FILE
// (directory) cap via sys_pdxfs_dir_readnext (sysno 72), write each
// entry's name to KIND_TTY(write) one per line, and emit one typed
// PdxFsDirEntry record per entry to the stdout semantic-pipe endpoint.
// At M3-003 the whole body is wrapped in a libpdx-audit begin/commit
// pair (DirListRecord frame) so the D3 audit-first invariant holds:
// no user-visible byte on KIND_TTY or the stdout endpoint is emitted
// before the audit frame is open.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// At ls.M3-001 (#8) Runner FLIPS from LS_RUN_STUB to a real iteration
// body. The M1 STUB shape is preserved on unreachable paths (the
// path-argument gates still return the same LS_ERR_BAD_PATH they did
// at M1 for the empty-string reject) so the M4 correctness matrix
// keeps its M1 vocabulary; the LS_RUN_STUB return retires at M3 --
// every well-formed argv now resolves through the real syscall path
// to either LS_OK or one of the substrate-error sub-band codes:
//
//   LS_OK              (0xFFFFEB00)  entries iterated and emitted
//   LS_ERR_BAD_PATH    (0xFFFFEB21)  path_ptr != 0 && byte0 == 0
//   LS_ERR_READDIR     (0xFFFFEB22)  sys_pdxfs_dir_readnext returned -errno
//   LS_ERR_TTY_WRITE   (0xFFFFEB23)  sys_write (fd 1) returned -errno
//   LS_ERR_EMIT_BIND   (0xFFFFEB24)  libpdx-semantic-pipe bind refused
//   LS_ERR_EMIT_SEND   (0xFFFFEB25)  send_record refused
//   LS_ERR_AUDIT       (0xFFFFEB26)  libpdx-audit audit_begin refused (M3-003)
//
// =============================================================================
// PRE-OPENED DIR CAP CONVENTION
// =============================================================================
//
// The kernel's sys_pdxfs_open (sysno 71) is a MINT operation whose
// parent argument must be a KIND_MEMORY cap carrying RIGHT_MINT (see
// paideia-os src/kernel/core/syscall/handlers/sys_pdxfs_open.pdx §
// pdxfs_file_cap_mint_inner requirements). ls does NOT hold such a
// parent -- read-only tools cannot mint filesystem caps. Instead,
// shell.M2 will hand ls a pre-narrowed KIND_PDXFS_FILE(read, <arg-
// path>) at exec time via the InitCap sidecar per r49-r50-plan.md
// §4.4 ("the tool's cap request narrows to exactly the argument
// path"). The M3-001 Runner therefore does NOT call sys_pdxfs_open;
// it calls sys_pdxfs_dir_readnext on the pre-handed cap slot pinned
// at LS_DIR_CAP_SLOT (2).
//
// LS_DIR_CAP_SLOT = 2 is chosen to match the caps.decl order:
//   slot 0: KIND_USER
//   slot 1: KIND_TTY(write)
//   slot 2: KIND_PDXFS_FILE(read, <arg-path>)   <-- Runner reads here
//   slot 3: KIND_IPC_ENDPOINT                    <-- SemanticEmit uses this
//
// At M3, when ls runs without shell.M2 having populated the cap_table
// yet, sys_pdxfs_dir_readnext returns -EBADF and Runner surfaces
// LS_ERR_READDIR -- correct substrate-wiring behaviour; the emission
// path lights up in a live end-to-end run once shell.M2 lands. This
// matches the "substrate wiring shipped, live behavior gated on the
// cap-handoff round" idiom every M3 R49 tool uses.
//
// =============================================================================
// FLOW (M3-001 + M3-003)
// =============================================================================
//
//   (1) Gate path_ptr as at M1 (empty string -> LS_ERR_BAD_PATH; null
//       path is legal at M3 and means "default to the pre-opened
//       LS_DIR_CAP_SLOT cap" -- the shell narrows to the concrete arg
//       path at exec, so ls does not resolve paths itself at M3).
//   (1b) M3-003: audit_ls_begin(path_ptr, flag_bits) -- open the
//       DirListRecord audit frame BEFORE any user-visible byte is
//       emitted (D3 invariant). On refusal return LS_ERR_AUDIT
//       without touching KIND_TTY or the semantic-pipe endpoint.
//   (2) sem_emit_reset() -- imprint the PdxFsDirEntry@0.1 schema id
//       (ls.ENH-010, #27: real spipe_schema_id_from_name fold, not
//       a stub).
//   (3) sem_emit_bind_stdout() -- bind LS_STDOUT_ENDPOINT_SLOT to
//       PdxFsDirEntry@0.1. On refusal return LS_ERR_EMIT_BIND.
//   (4) Loop:
//       (a) pdxfs_dir_readnext(LS_DIR_CAP_SLOT, &_rn_entry_buf) -> rc
//       (b) rc == 1 -> entry written; proceed.
//           rc == 0 -> end-of-directory; break.
//           other  -> LS_ERR_READDIR (propagate).
//       (c) Extract name_ptr = _rn_entry_buf + PDXFS_DIR_ENT_OFF_NAME
//           and name_len = *(_rn_entry_buf + PDXFS_DIR_ENT_OFF_NAME_LEN)
//       (d) hidden_filter_accept(name_ptr, flag_bits & AS_BIT_A):
//           reject -> ls_note(LS_ST_HIDDEN); continue loop.
//           accept -> proceed.
//       (e) Compose name + '\n' into _rn_line_buf (name_len + 1 bytes);
//           tty_write(&_rn_line_buf, name_len + 1). On refusal
//           return LS_ERR_TTY_WRITE.
//       (f) sem_emit_entry(&_rn_entry_buf). On refusal return
//           LS_ERR_EMIT_SEND.
//       (g) ls_note(LS_ST_ENTRIES); continue loop.
//   (5) Return LS_OK.
//
// Every ret path (except the pre-audit LS_ERR_BAD_PATH branch) flows
// through rn_ls_epilogue which calls audit_ls_commit(exit_code)
// before unwinding. audit_ls_commit is safe to call on the pre-audit
// path too -- it gates internally on _au_id != 0 -- so the epilogue
// unification is unconditional.
//
// =============================================================================
// AS_BIT_A DEPENDENCY
// =============================================================================
//
// Runner reads bit 1 of flag_bits (AS_BIT_A per ArgvSurface). Value
// mirrored locally as RN_BIT_A_MASK = 0x2 so this file does not have
// to import ArgvSurface's constants -- the bit position is stable
// across the R49 wave (see design/architecture.md §3.1 bit table).
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Runner`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Immediates in this
//     module: 0 (null-check), 1 (readnext-entry discriminator), 2
//     (RN_BIT_A_MASK), 16 (PDXFS_DIR_ENT_OFF_NAME_LEN), 24
//     (PDXFS_DIR_ENT_OFF_NAME), 104 (PDXFS_DIR_NAME_MAX + 1 line-cap
//     bound). The 0xFFFFEB2x error returns are `mov rax, imm64`
//     emissions, not compares.
//   - Byte reads (name-copy loop into _rn_line_buf) use `xor rax;
//     mov_b rax, [ptr]` per #1248.
//   - Byte writes (name-copy loop tail + '\n' terminator) use
//     `mov_b [dst], reg`.
//   - r11 is scratch; r10 is scratch (both used as ephemeral address
//     holders in the copy loop).
//   - Non-leaf; many nested calls. Six callee-save pushes (rbx =
//     dir_cap_slot copy for pipeline stability across readnext + tty_
//     write + sem_emit_entry, r12 = path_ptr, r13 = flag_bits, r14 =
//     name_len for the current entry, r15 = _rn_line_buf base, rbp =
//     name_ptr) + `sub rsp, 8` pad = 56 bytes; entry rsp % 16 == 8;
//     8 + 56 = 64; 64 % 16 == 0 at every nested-call site. Every ret
//     path unwinds through rn_ls_epilogue which does the 6 pops + the
//     rsp restore in one place.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   ls_note                -- Ls (src/ls.pdx)
//   pdxfs_dir_readnext     -- PdxfsShim (src/pdxfs_shim.pdx)
//   tty_write              -- TtyWrite (src/tty_write.pdx)
//   hidden_filter_accept   -- HiddenFilter (src/hidden_filter.pdx)
//   sem_emit_reset         -- SemanticEmit (src/semantic_emit.pdx)
//   sem_emit_bind_stdout   -- SemanticEmit (src/semantic_emit.pdx)
//   sem_emit_entry         -- SemanticEmit (src/semantic_emit.pdx)
//   audit_ls_begin         -- AuditShim (src/audit_shim.pdx) -- M3-003
//   audit_ls_commit        -- AuditShim (src/audit_shim.pdx) -- M3-003
//   long_format_line       -- LongFormat (src/long_format.pdx) -- v1.1.0 ENH-002
//   json_line_render       -- JsonLine (src/json_line.pdx) -- v1.1.0 ENH-007
//   color_pick             -- ColorPicker (src/color_picker.pdx) -- v1.1.0 ENH-005
//   color_sgr_prefix       -- ColorPicker (src/color_picker.pdx) -- v1.1.0 ENH-005
//   color_sgr_suffix       -- ColorPicker (src/color_picker.pdx) -- v1.1.0 ENH-005
//   group_sort_partition   -- GroupSort (src/group_sort.pdx) -- ls.ENH-020 (#38)

module Runner = structure {

  // ==========================================================================
  // Constants (locally mirrored so this file does not depend on
  // ArgvSurface's bit vocabulary; the M4 smoke matrix catches drift).
  // ==========================================================================

  // ArgvSurface AS_BIT_A mask (mirrored -- see design/architecture.md §3.1)
  pub let RN_BIT_A_MASK           : u64 = 0x2
  // ls.ENH-002 (#24) v1.1.0: -l long-format mask (AS_BIT_L). Runner
  // routes accepted entries through LongFormat::long_format_line when
  // set; otherwise the default name+suffix+LF path stays.
  pub let RN_BIT_L_MASK           : u64 = 0x1
  // ls.ENH-002 (#24) v1.1.0: -h human size mask (AS_BIT_H). Forwarded
  // into long_format_line's kind_mode_flags[13] (human_size_flag).
  pub let RN_BIT_H_MASK           : u64 = 0x4
  // ls.ENH-007 (#26) v1.1.0: --json mask (AS_BIT_JSON). Runner
  // replaces the KIND_TTY text branch with JsonLine emission when set.
  pub let RN_BIT_JSON_MASK        : u64 = 0x8
  // ls.ENH-005 (#25) v1.1.0: --color mask (AS_BIT_COLOR). Runner
  // wraps text-branch content with ANSI SGR prefix/suffix when set
  // AND the color-auto probe (if AS_BIT_COLOR_AUTO also set) resolves
  // to KIND_TTY. --json disables color regardless.
  pub let RN_BIT_COLOR_MASK       : u64 = 0x20
  // ls.ENH-023 (#41) v1.1.0: --color=auto mask (AS_BIT_COLOR_AUTO).
  // Runner probes stdout KIND when set alongside AS_BIT_COLOR.
  pub let RN_BIT_COLOR_AUTO_MASK  : u64 = 0x4000
  // ls.ENH-019 (#37): -F type-indicator suffix mask (AS_BIT_F).
  pub let RN_BIT_F_MASK           : u64 = 0x1000
  // ls.ENH-020 (#38): --group-directories-first mask (AS_BIT_GDF).
  // Runner buffers the whole directory when this bit is set (the held
  // dir cap has no rewind primitive -- see the GDF collect-phase
  // comment below) and reorders emission through
  // GroupSort::group_sort_partition.
  pub let RN_BIT_GDF_MASK         : u64 = 0x2000
  // ls.ENH-020 (#38): static cap on the GDF buffer. See the
  // collect-phase comment for the overflow policy rationale (today's
  // kernel readnext is a fixed small stub -- design/enhancement-plan.md
  // §1.1 -- so this bound is unreachable at HEAD; it exists so a
  // future real substrate fails loudly rather than silently once a
  // directory outgrows a static buffer).
  pub let RN_GDF_MAX_ENTRIES      : u64 = 64
  // ls.ENH-019 (#37): kind-nibble offset inside the 128-byte kernel
  // PdxFsDirEntry record. See paideia-os
  // src/kernel/core/cap/pdxfs_dir_iter.pdx §1 (inode@0, kind@8,
  // name_len@16, name[104]@24). The kind qword's low 4 bits carry the
  // PdxFS-v1 file-type nibble (0x4=dir, 0x8=file, 0xA=symlink, ...).
  pub let RN_ENT_OFF_KIND         : u64 = 8
  // ls.ENH-007 (#26) v1.1.0: inode field offset (record byte 0). Read
  // into json_line_render as the "inode" numeric.
  pub let RN_ENT_OFF_INODE        : u64 = 0

  // Kernel PdxFsDirEntry offsets (mirror paideia-os
  // src/kernel/core/cap/pdxfs_dir_iter.pdx §1).
  pub let RN_ENT_OFF_NAME_LEN     : u64 = 16
  pub let RN_ENT_OFF_NAME         : u64 = 24
  pub let RN_ENT_NAME_MAX         : u64 = 104
  pub let RN_ENT_SIZE             : u64 = 128

  // ls.ENH-015 (#33): kind-nibble placeholder used by
  // rn_compose_file_entry for the file-as-path single-row fallback.
  // Hardcoded (not read from any cap) because tmpfs mints only
  // VNODE_TYPE_REG=1 / VNODE_TYPE_DIR=2 at HEAD (no symlink vnode
  // type exists yet -- src/kernel/core/fs/tmpfs/vops.pdx) and no
  // cap-kind-query trampoline is exposed to userspace to tell a file
  // cap from a future symlink cap apart. See rn_ls_file_fallback for
  // the full rationale.
  pub let RN_ENT_KIND_FILE        : u64 = 8

  // Pre-opened directory cap slot (see file header).
  pub let LS_DIR_CAP_SLOT         : u64 = 2

  // sys_pdxfs_dir_readnext discriminators.
  pub let RN_READNEXT_ENTRY       : u64 = 1
  pub let RN_READNEXT_EOD         : u64 = 0

  // Stat slot ids (mirror Ls; kept as local constants so this file
  // does not have to import Ls's slot names).
  pub let RN_STAT_RUNS            : u64 = 2
  pub let RN_STAT_ENTRIES         : u64 = 3
  pub let RN_STAT_ERRORS          : u64 = 4
  pub let RN_STAT_HIDDEN          : u64 = 5

  // ==========================================================================
  // .bss
  // ==========================================================================
  //
  // _rn_entry_buf -- 128-byte scratch that sys_pdxfs_dir_readnext
  // writes into (one entry at a time). 16 u64 lanes.
  //
  // _rn_line_buf -- text composition buffer for the tty_write call.
  // v1.1.0 (ENH-002/#24 + ENH-007/#26): grown from 14 u64 to 32 u64
  // (256 bytes) so LongFormat's max line (kind + mode + owner + size
  // + mtime + name + optional " -> <link:target-unknown>" + LF ~
  // 200 bytes) and JsonLine's max line (30-byte fixed + name 104 +
  // digits 22 = 156 bytes) fit without a per-renderer buffer split.
  // The default name+suffix+LF path uses well under 105 bytes; the
  // growth is a strict superset.
  //
  // _rn_lf_extra_scratch -- 16-byte scratch for long_format_line's
  // extra_ptr (mtime_ns at [0..8), owner_row at [8..16)). Both fields
  // are placeholder 0 at v1.1.0 -- see ENH-008 (owner) and the plan
  // doc §7 for the kernel readnext-record growth (mtime, mode_bits,
  // size). 2 u64 lanes.
  //
  // _rn_sgr_prefix_scratch -- 8-byte scratch for a color SGR prefix
  // emit ("ESC [ N N m" max 6 bytes; 1 u64 lane leaves headroom).
  //
  // _rn_sgr_suffix_scratch -- 8-byte scratch for the fixed 4-byte
  // color SGR suffix ("ESC [ 0 m").
  pub let mut _rn_entry_buf          : [u64; 16] = uninit @align(8)
  pub let mut _rn_line_buf           : [u64; 32] = uninit @align(8)
  pub let mut _rn_lf_extra_scratch   : [u64; 2]  = uninit @align(8)
  pub let mut _rn_sgr_prefix_scratch : [u64; 1]  = uninit @align(8)
  pub let mut _rn_sgr_suffix_scratch : [u64; 1]  = uninit @align(8)

  // ls.ENH-020 (#38): GDF (--group-directories-first) buffering state.
  //
  // _rn_gdf_mode  -- non-zero for the whole call when AS_BIT_GDF was
  //                  set on flag_bits (computed once at entry).
  // _rn_gdf_count -- entries buffered into _rn_gdf_buf so far (collect
  //                  phase) / total buffered (emit phase).
  // _rn_gdf_idx   -- emission cursor into _rn_gdf_order_buf (emit phase).
  // _rn_gdf_buf   -- up to RN_GDF_MAX_ENTRIES (64) 128-byte
  //                  PdxFsDirEntry records, packed (64*16 = 1024 u64
  //                  lanes = 8192 bytes).
  // _rn_gdf_kinds_buf  -- one low-nibble kind code per buffered entry
  //                       (GroupSort::group_sort_partition's input).
  // _rn_gdf_order_buf  -- GroupSort::group_sort_partition's output: a
  //                       permutation of 0.._rn_gdf_count-1, dirs
  //                       first, stable within each group.
  pub let mut _rn_gdf_mode        : u64 = uninit @align(8)
  pub let mut _rn_gdf_count       : u64 = uninit @align(8)
  pub let mut _rn_gdf_idx         : u64 = uninit @align(8)
  pub let mut _rn_gdf_buf         : [u64; 1024] = uninit @align(8)
  pub let mut _rn_gdf_kinds_buf   : [u64; 64]   = uninit @align(8)
  pub let mut _rn_gdf_order_buf   : [u64; 64]   = uninit @align(8)

  // ls.ENH-015 (#33): non-zero once rn_ls_file_fallback has composed
  // and dispatched the single synthetic entry for a non-directory cap.
  // rn_ls_continue checks this BEFORE the GDF check so the loop
  // terminates after exactly one entry instead of calling
  // pdxfs_dir_readnext again (which would re-hit the same -EBADF and
  // spin forever on a file cap).
  pub let mut _rn_single_file_mode : u64 = uninit @align(8)

  // ==========================================================================
  // runner_ls(path_ptr, flag_bits) -> u64
  //
  // Signature: (u64, u64) -> u64 !{mem, sysreg} @{cap}
  //   RDI (input): path_ptr   -- NUL-terminated path (informational at
  //                              M3 -- shell narrows the dir cap at
  //                              exec; kept in the signature for the
  //                              R51+ path-multiplex round).
  //   RSI (input): flag_bits  -- OR of ArgvSurface::AS_BIT_*.
  //   RAX (output): LS_OK on success; one of the substrate-error
  //                 sub-band codes (see file header) on refusal.
  //
  // See file header §Flow for the step-by-step body.
  // ==========================================================================
  pub let runner_ls : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (path_ptr: u64) (flag_bits: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "ls.M3-001 (#8) + ls.M3-003 (#10): Runner flips from LS_RUN_STUB to a real iteration body, wrapped in a libpdx-audit DirListRecord frame (D3 audit-first). Uses pdxfs_dir_readnext (sysno 72) against a pre-handed KIND_PDXFS_FILE(read, <arg-path>) at LS_DIR_CAP_SLOT (2, per caps.decl order). Bumps LS_ST_RUNS on entry unconditionally so the counter records every ATTEMPT. Argument gates preserve the M1 shape: null path_ptr resolves through the read loop with the pre-handed cap (informational path; shell narrowed the cap already); non-null path_ptr with byte0 == 0 refuses with LS_ERR_BAD_PATH. M3-003 audit-open: audit_ls_begin(path_ptr, flag_bits) called AFTER the path gate and BEFORE sem_emit_reset -- this is the boundary the D3 invariant pins (no user-visible byte until the audit frame is open). Refusal returns LS_ERR_AUDIT (0xFFFFEB26). Emit prelude: sem_emit_reset + sem_emit_bind_stdout must succeed before the read loop; bind refusal returns LS_ERR_EMIT_BIND. Loop: pdxfs_dir_readnext(LS_DIR_CAP_SLOT, &_rn_entry_buf); rc == 1 -> proceed; rc == 0 -> break; else LS_ERR_READDIR. Per-entry: extract name_len (offset 16) + name_ptr (offset 24) from the 128-byte record; hidden_filter_accept(name_ptr, flag_bits & AS_BIT_A) -- rejects bump LS_ST_HIDDEN and loop; accepts compose name + '\\n' in _rn_line_buf (byte copy loop with #1248 mitigation) and tty_write; tty_write refusal (negative rax) -> LS_ERR_TTY_WRITE; then sem_emit_entry (144-byte record over the bound stdout endpoint, M3-002 shape with owner Cap wire) -> LS_ERR_EMIT_SEND on refusal; bump LS_ST_ENTRIES; continue. Every ret path (except the pre-audit LS_ERR_BAD_PATH -- but that too goes through the same epilogue because audit_ls_commit is a no-op on _au_id == 0) flows through rn_ls_epilogue which saves exit_code in r13 (dead at epilogue -- flag_bits done), calls audit_ls_commit, then restores rax and unwinds. Six callee-save pushes (rbx = LS_DIR_CAP_SLOT copy; r12 = path_ptr; r13 = flag_bits then exit_code carry; r14 = name_len for the current entry; r15 = _rn_line_buf base for the tty_write call; rbp = name_ptr for the tty_write + hidden_filter_accept chain) + sub rsp,8 pad = 56 bytes; entry rsp % 16 == 8; 8 + 56 = 64; 64 % 16 == 0 at every nested-call site (ls_note, audit_ls_begin, sem_emit_reset, sem_emit_bind_stdout, pdxfs_dir_readnext, hidden_filter_accept, tty_write, sem_emit_entry, audit_ls_commit). Matched add rsp,8 + 6 pops before every ret via the shared rn_ls_epilogue label. paideia-as conformance: r11 + r10 for LEA + byte-address scratch; no test mnemonic; largest cmp immediate 128 (RN_ENT_SIZE) fits imm32; the 0xFFFFEB2x return sentinels are mov rax, imm64 emissions, not compares. Effects widened to !{mem, sysreg} @{cap} matching the union of the callees (pdxfs_dir_readnext + tty_write + sem_emit_entry + audit_ls_begin + audit_ls_commit all carry {mem, sysreg}; pdxfs_dir_readnext + sem_emit_entry + audit_ls_begin + audit_ls_commit carry @{cap}). Labels prefixed rn_ls_.",
      block: {
        // ---- 6-push prologue + 8-byte alignment pad ------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                              // rsp % 16 == 0 for nested calls

        mov r12, rdi;                            // path_ptr
        mov r13, rsi;                            // flag_bits

        // ---- Bump LS_ST_RUNS -----------------------------------------
        mov rdi, 2;                              // RN_STAT_RUNS
        call ls_note;

        // ---- ls.ENH-020 (#38): GDF mode + collect-state init ----------
        //
        // Compute AS_BIT_GDF membership once and stash it in .bss --
        // every callee-save register is already committed for the
        // rest of this function (see the file-header register plan),
        // so there is no free register to carry a mode flag across
        // the whole body. Zero the buffered-entry bookkeeping
        // unconditionally; only the GDF path reads it, but a clean
        // start costs nothing on the non-GDF path.
        mov r10, r13;                            // flag_bits copy
        mov r11, 0x2000;                         // RN_BIT_GDF_MASK
        and r10, r11;
        lea r11, [rip + _rn_gdf_mode];
        mov [r11], r10;
        lea r11, [rip + _rn_gdf_count];
        mov r10, 0;
        mov [r11], r10;
        lea r11, [rip + _rn_gdf_idx];
        mov [r11], r10;

        // ls.ENH-015 (#33): clear the single-file-fallback flag every
        // call -- only rn_ls_file_fallback ever sets it.
        lea r11, [rip + _rn_single_file_mode];
        mov r10, 0;
        mov [r11], r10;

        // ---- Path arg gate (empty-string reject preserved from M1) --
        cmp r12, 0;
        je  rn_ls_audit_open;                    // null path -> proceed
        xor rax, rax;
        mov_b rax, [r12];
        cmp rax, 0;
        je  rn_ls_bad_path;

      rn_ls_audit_open:
        // ---- M3-003: open DirListRecord audit frame (D3) -------------
        //
        // MUST happen before any user-visible byte reaches KIND_TTY
        // or the semantic-pipe endpoint. On refusal, we return
        // LS_ERR_AUDIT via the epilogue -- audit_ls_commit is a no-op
        // when _au_id == 0 (which it stays on refusal), so the
        // unified epilogue is safe.
        mov rdi, r12;                            // path_ptr
        mov rsi, r13;                            // flag_bits
        call audit_ls_begin;
        cmp rax, 0;                              // AU_OK
        jne rn_ls_audit_fail;

      rn_ls_pre_emit:
        // ---- Emit prelude: schema-imprint + bind ---------------------
        call sem_emit_reset;
        call sem_emit_bind_stdout;
        cmp rax, 0;                              // SE_OK
        jne rn_ls_bind_fail;

        // ---- Load LS_DIR_CAP_SLOT into rbx for the loop --------------
        mov rbx, 2;                              // LS_DIR_CAP_SLOT

        // ---- ls.ENH-020 (#38): GDF branches to the collect phase -----
        lea r11, [rip + _rn_gdf_mode];
        mov r10, [r11];
        cmp r10, 0;
        jne rn_ls_gdf_collect;
        // Non-GDF: fall through to the unchanged streaming loop.

      rn_ls_loop:
        // ---- pdxfs_dir_readnext(LS_DIR_CAP_SLOT, &_rn_entry_buf) ----
        mov rdi, rbx;                            // dir_cap_slot
        lea r11, [rip + _rn_entry_buf];
        mov rsi, r11;                            // entry_buf_va
        call pdxfs_dir_readnext;

        // rc discriminate.
        cmp rax, 1;                              // RN_READNEXT_ENTRY
        je  rn_ls_have_entry;
        cmp rax, 0;                              // RN_READNEXT_EOD
        je  rn_ls_done;

        // Any other value -> negative-errno; propagate as LS_ERR_READDIR.
        jmp rn_ls_readdir_fail;

        // ==============================================================
        // ls.ENH-020 (#38): GDF (--group-directories-first) phases.
        //
        // The held KIND_PDXFS_FILE dir cap is forward-only -- no
        // rewind/reopen primitive exists in PdxfsShim (src/pdxfs_shim.pdx
        // exposes only pdxfs_open_dir and pdxfs_dir_readnext) -- so
        // grouping directories ahead of files requires buffering every
        // entry before any of them is rendered or emitted. Three phases:
        //
        //   rn_ls_gdf_collect      -- drain the directory into
        //     _rn_gdf_buf (one 128-byte record per slot, up to
        //     RN_GDF_MAX_ENTRIES). Reuses _rn_entry_buf as the
        //     pdxfs_dir_readnext scratch target, then bulk-copies it
        //     into the next free _rn_gdf_buf slot.
        //   rn_ls_gdf_partition    -- extract one kind-nibble per
        //     buffered record into _rn_gdf_kinds_buf and call
        //     GroupSort::group_sort_partition to compute a dirs-first,
        //     stable-within-group emission order into
        //     _rn_gdf_order_buf.
        //   rn_ls_gdf_emit_next    -- the buffered-mode replacement for
        //     rn_ls_loop's "get the next entry" step: copies the
        //     buffered record at the next order-buffer index into
        //     _rn_entry_buf, advances the cursor, then falls into the
        //     UNCHANGED per-entry body at rn_ls_have_entry. Every
        //     "continue" edge in that body now runs through
        //     rn_ls_continue (above), which redirects here instead of
        //     rn_ls_loop when GDF mode is on.
        //
        // Overflow (more than RN_GDF_MAX_ENTRIES entries): refuses via
        // the existing rn_ls_readdir_fail path (LS_ERR_READDIR). This
        // is a real, documented substrate-resource-limit refusal, not
        // a silent truncation of the grouped listing -- consistent
        // with this tool's D3 audit-first / no-silent-wrong-output
        // discipline. Today's kernel readnext is a fixed small stub
        // (design/enhancement-plan.md §1.1), so this bound is
        // unreachable at HEAD.
        //
        // Symlink-to-directory promotion is NOT implemented. GNU ls
        // groups a symlink whose target is a directory alongside real
        // directories; doing that here needs the target's type, which
        // needs a stat-follow syscall PdxfsShim does not expose. A
        // symlink entry (kind 0xA) is buffered and partitioned like
        // any other non-directory entry -- see GroupSort's module doc
        // comment (src/group_sort.pdx) for the full rationale and the
        // tracked follow-up.
        // ==============================================================
      rn_ls_gdf_collect:
        mov rdi, rbx;                            // LS_DIR_CAP_SLOT
        lea r11, [rip + _rn_entry_buf];
        mov rsi, r11;
        call pdxfs_dir_readnext;

        cmp rax, 1;                              // RN_READNEXT_ENTRY
        je  rn_ls_gdf_have_raw;
        cmp rax, 0;                              // RN_READNEXT_EOD
        je  rn_ls_gdf_partition;

        jmp rn_ls_readdir_fail;

      rn_ls_gdf_have_raw:
        // Overflow guard -- reject before writing past _rn_gdf_buf.
        lea r11, [rip + _rn_gdf_count];
        mov r14, [r11];                          // current count
        cmp r14, 64;                             // RN_GDF_MAX_ENTRIES
        jae rn_ls_readdir_fail;

        // dst_lane_base = count * 16 (16 u64 lanes per 128-byte record)
        mov r9, r14;
        shl r9, 4;

        lea r15, [rip + _rn_entry_buf];          // src base
        lea r8,  [rip + _rn_gdf_buf];             // dst table base

        xor rcx, rcx;                             // lane idx = 0

      rn_ls_gdf_copy_loop:
        cmp rcx, 16;
        jae rn_ls_gdf_copy_done;

        mov rax, [r15 + rcx * 8];
        mov r10, r9;
        add r10, rcx;                             // absolute dst lane index
        mov [r8 + r10 * 8], rax;

        add rcx, 1;
        jmp rn_ls_gdf_copy_loop;

      rn_ls_gdf_copy_done:
        add r14, 1;
        lea r11, [rip + _rn_gdf_count];
        mov [r11], r14;
        jmp rn_ls_gdf_collect;

      rn_ls_gdf_partition:
        // Extract one kind-nibble per buffered record into
        // _rn_gdf_kinds_buf, then call GroupSort::group_sort_partition.
        // r12 (path_ptr) is dead by this point -- the only use of
        // path_ptr was the M1 empty-string gate at function entry --
        // so it is safe to repurpose here as the buffered count.
        lea r11, [rip + _rn_gdf_count];
        mov r12, [r11];                          // count

        xor rcx, rcx;                             // idx = 0

      rn_ls_gdf_kinds_loop:
        cmp rcx, r12;
        jae rn_ls_gdf_kinds_done;

        mov r9, rcx;
        shl r9, 4;                                // idx * 16
        add r9, 1;                                // + kind-lane offset
                                                   // (RN_ENT_OFF_KIND byte
                                                   // 8 = lane 1)
        lea r11, [rip + _rn_gdf_buf];
        mov rax, [r11 + r9 * 8];
        and rax, 0xF;                             // low nibble -- kind code

        lea r11, [rip + _rn_gdf_kinds_buf];
        mov [r11 + rcx * 8], rax;

        add rcx, 1;
        jmp rn_ls_gdf_kinds_loop;

      rn_ls_gdf_kinds_done:
        lea r11, [rip + _rn_gdf_kinds_buf];
        mov rdi, r11;
        mov rsi, r12;                             // count
        lea r11, [rip + _rn_gdf_order_buf];
        mov rdx, r11;
        call group_sort_partition;

        lea r11, [rip + _rn_gdf_idx];
        mov r10, 0;
        mov [r11], r10;
        jmp rn_ls_gdf_emit_next;

      rn_ls_gdf_emit_next:
        lea r11, [rip + _rn_gdf_idx];
        mov r10, [r11];                           // emit cursor
        lea r11, [rip + _rn_gdf_count];
        mov r9, [r11];                            // total buffered
        cmp r10, r9;
        jae rn_ls_done;                           // all buffered entries emitted

        // idx = _rn_gdf_order_buf[cursor]
        lea r11, [rip + _rn_gdf_order_buf];
        mov rax, [r11 + r10 * 8];                 // original buffer index

        // Copy the 128-byte record at _rn_gdf_buf[idx] into
        // _rn_entry_buf so the UNCHANGED per-entry body below sees it
        // exactly like a live pdxfs_dir_readnext result.
        mov r9, rax;
        shl r9, 4;                                // idx * 16 (src lane base)

        lea r15, [rip + _rn_gdf_buf];             // src table base
        lea r8,  [rip + _rn_entry_buf];            // dst base

        xor rcx, rcx;                              // lane idx = 0

      rn_ls_gdf_emit_copy_loop:
        cmp rcx, 16;
        jae rn_ls_gdf_emit_copy_done;

        mov r11, r9;
        add r11, rcx;                              // absolute src lane index
        mov rax, [r15 + r11 * 8];
        mov [r8 + rcx * 8], rax;

        add rcx, 1;
        jmp rn_ls_gdf_emit_copy_loop;

      rn_ls_gdf_emit_copy_done:
        // Advance the cursor BEFORE falling into the shared per-entry
        // body -- rn_ls_continue routes every "next entry" edge back
        // here, so the cursor must already point at the next slot.
        lea r11, [rip + _rn_gdf_idx];
        mov r10, [r11];
        add r10, 1;
        mov [r11], r10;

        jmp rn_ls_have_entry;

      rn_ls_have_entry:
        // ---- Load name_len (offset 16) and name_ptr (offset 24) ------
        lea r11, [rip + _rn_entry_buf];
        mov r14, [r11 + 16];                     // name_len

        lea r11, [rip + _rn_entry_buf];
        add r11, 24;                             // name_ptr = &entry + 24
        mov rbp, r11;                            // rbp = name_ptr

        // ---- hidden_filter_accept(name_ptr, flag_bits & AS_BIT_A) ---
        mov rdi, rbp;
        mov rsi, r13;
        mov r10, 2;                              // RN_BIT_A_MASK
        and rsi, r10;                            // show_hidden = flag_bits & AS_BIT_A
        call hidden_filter_accept;

        cmp rax, 0;
        je  rn_ls_hidden;                        // filtered out

      rn_ls_render_dispatch:
        // ls.ENH-015 (#33): shared re-entry point for the file-as-
        // path fallback (rn_ls_file_fallback jumps directly here,
        // BYPASSING the hidden_filter_accept call above -- an explicit
        // path argument is never dot-filtered under POSIX ls
        // semantics, only directory-walk entries are). Requires r14 =
        // name_len and rbp = name_ptr already loaded, exactly as the
        // fall-through from a real directory entry leaves them.
        //
        // ---- v1.1.0: Renderer dispatch ------------------------------
        //
        // Priority: AS_BIT_JSON > AS_BIT_L > default. JSON wins over
        // -l per the "--json is a full wire replacement" rule the user
        // constraint pinned this session (JSON swaps the text branch;
        // any text-formatting flags are ignored when JSON is on so a
        // downstream JSON consumer never sees mixed shapes). Default
        // path (bare `ls`) falls through unchanged.
        //
        // r10 = flag_bits & mask; r11 = mask constant staged.
        mov r10, r13;
        mov r11, 0x8;                            // AS_BIT_JSON
        and r10, r11;
        cmp r10, 0;
        jne rn_ls_render_json;

        mov r10, r13;
        mov r11, 0x1;                            // AS_BIT_L
        and r10, r11;
        cmp r10, 0;
        jne rn_ls_render_long;

        // ---- Compose _rn_line_buf: copy name bytes + '\n' -----------
        //
        // Bound the name copy at min(name_len, RN_ENT_NAME_MAX) so a
        // corrupt name_len from a broken upstream cannot overflow
        // _rn_line_buf.
        mov rcx, r14;                            // name_len
        mov r10, 104;                            // RN_ENT_NAME_MAX
        cmp rcx, r10;
        jbe rn_ls_len_ok;
        mov rcx, r10;                            // clamp

      rn_ls_len_ok:
        // r14 = actual bytes-to-copy (clamped)
        mov r14, rcx;

        lea r15, [rip + _rn_line_buf];           // dst base

        // Byte-copy loop: rax = index 0..rcx (using rcx as remaining).
        // We use a fresh index r10 inside the loop; r14 holds the
        // authoritative clamped length.
        xor r10, r10;                            // idx = 0

      rn_ls_copy_head:
        cmp r10, r14;                            // idx < len ?
        jae rn_ls_copy_done;

        mov r11, rbp;                            // &src[0]
        add r11, r10;                            // &src[idx]
        xor rax, rax;                            // #1248 mitigation
        mov_b rax, [r11];

        mov r11, r15;                            // &dst[0]
        add r11, r10;                            // &dst[idx]
        mov_b [r11], rax;

        add r10, 1;
        jmp rn_ls_copy_head;

      rn_ls_copy_done:
        // ---- ls.ENH-019 (#37): -F type-indicator suffix -----------
        //
        // When AS_BIT_F is set in flag_bits, inspect the entry's kind
        // nibble at record offset 8 and append a single suffix byte
        // before the '\n':
        //   nibble 0x4 (dir)     -> '/'
        //   nibble 0xA (symlink) -> '@'
        //   nibble 0x8 (file)    -> no suffix at v1.1 (exec '*' awaits
        //                           the kernel record growing a mode
        //                           field via sys_pdxfs_stat_by_inode --
        //                           tracked as follow-up, aligned with
        //                           ENH-008 owner deferral).
        //   other                -> no suffix.
        //
        // r10 = suffix byte, rax = kind qword scratch.
        mov r10, r13;                            // r10 = flag_bits copy
        mov r11, 0x1000;                         // RN_BIT_F_MASK
        and r10, r11;
        cmp r10, 0;
        je  rn_ls_no_suffix;
        // Load kind at offset 8.
        lea r11, [rip + _rn_entry_buf];
        mov rax, [r11 + 8];                      // RN_ENT_OFF_KIND
        and rax, 0xF;                            // low 4 bits = nibble
        cmp rax, 0x4;
        je  rn_ls_suffix_dir;
        cmp rax, 0xA;
        je  rn_ls_suffix_sym;
        jmp rn_ls_no_suffix;

      rn_ls_suffix_dir:
        mov r10, 0x2F;                           // '/'
        jmp rn_ls_suffix_emit;

      rn_ls_suffix_sym:
        mov r10, 0x40;                           // '@'
        jmp rn_ls_suffix_emit;

      rn_ls_suffix_emit:
        // dst[len] = suffix; len++
        mov r11, r15;
        add r11, r14;
        mov_b [r11], r10;
        add r14, 1;

      rn_ls_no_suffix:
        // ---- Append '\n' -----------------------------------------
        mov r11, r15;
        add r11, r14;                            // &dst[len]
        mov rax, 0x0A;                           // '\n'
        mov_b [r11], rax;
        add r14, 1;                              // r14 = bytes including LF

        // Fall through to the shared emit (v1.1.0: shared with
        // rn_ls_render_long + rn_ls_render_json).
        jmp rn_ls_emit_wire;

        // ==========================================================
        // v1.1.0 ENH-002 (#24): -l long-format render path.
        //
        // Calls LongFormat::long_format_line with the entry's fields
        // packed into kind_mode_flags:
        //   [3:0]  = kind_nibble (from _rn_entry_buf[8] low 4 bits)
        //   [12:4] = mode_bits   = 0 (kernel readnext record has no
        //                          mode column at v1.x -- ENH-008 and
        //                          the paideia-os follow-up track the
        //                          fix)
        //   [13]   = human_size_flag (from AS_BIT_H)
        // Size and mtime are similarly 0 placeholders (kernel-blocked
        // per plan doc §7); extra_ptr points at _rn_lf_extra_scratch
        // pre-zeroed each iteration so the two 0 fields are stable.
        //
        // dst = _rn_line_buf (256 bytes); returns bytes composed in
        // rax (or LF_ERR_OVERFLOW). name_ptr is in rbp; name is
        // implicitly NUL-terminated by the readnext record (name_len
        // bytes followed by zero fill inside the 104-byte name field).
        // ==========================================================
      rn_ls_render_long:
        // Compute kind_mode_flags into a scratch register (r10).
        //   nibble = _rn_entry_buf[8] & 0xF
        //   human  = (flag_bits & AS_BIT_H) ? 0x2000 : 0
        //   kmf    = nibble | human
        lea r11, [rip + _rn_entry_buf];
        mov rax, [r11 + 8];                      // RN_ENT_OFF_KIND qword
        and rax, 0xF;                            // low 4 bits
        mov r10, rax;                            // r10 = kmf accumulator

        mov rax, r13;                            // flag_bits copy
        mov r11, 0x4;                            // AS_BIT_H
        and rax, r11;
        cmp rax, 0;
        je  rn_ls_lf_no_h;
        mov r11, 0x2000;                         // bit 13
        or  r10, r11;

      rn_ls_lf_no_h:
        // Zero _rn_lf_extra_scratch (mtime_ns @0, owner_row @8).
        lea r11, [rip + _rn_lf_extra_scratch];
        xor rax, rax;
        mov [r11], rax;
        mov [r11 + 8], rax;

        // Marshal args:
        //   rdi = dst_ptr    = _rn_line_buf
        //   rsi = dst_cap    = 256
        //   rdx = name_ptr   = rbp
        //   rcx = kind_mode_flags = r10
        //   r8  = size_bytes = 0 (placeholder)
        //   r9  = extra_ptr  = _rn_lf_extra_scratch
        lea r11, [rip + _rn_line_buf];
        mov rdi, r11;
        mov r15, r11;                            // remember dst for emit
        mov rsi, 256;
        mov rdx, rbp;
        mov rcx, r10;
        xor r8, r8;                              // size placeholder
        lea r11, [rip + _rn_lf_extra_scratch];
        mov r9, r11;
        call long_format_line;

        // Refuse on overflow (long_format returns 0xFFFFFFFFFFFFFFFF).
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  rn_ls_tty_fail;                      // reuse existing fail path

        // Bump LS_ST_LONG counter (slot 6) so the tool's stats record
        // how many -l lines were rendered.
        mov r14, rax;                            // save bytes-written
        mov rdi, 6;                              // RN_STAT_LONG
        call ls_note;

        jmp rn_ls_emit_wire;

        // ==========================================================
        // v1.1.0 ENH-007 (#26): --json render path.
        //
        // Calls JsonLine::json_line_render with the six fields packed
        // by the 6-register cap:
        //   rdi = dst_ptr    = _rn_line_buf
        //   rsi = dst_cap    = 256
        //   rdx = name_ptr   = rbp
        //   rcx = name_len   = r14
        //   r8  = kind_nibble (from _rn_entry_buf[8] low 4 bits)
        //   r9  = inode      = _rn_entry_buf[0]
        // ==========================================================
      rn_ls_render_json:
        lea r11, [rip + _rn_line_buf];
        mov rdi, r11;
        mov r15, r11;
        mov rsi, 256;
        mov rdx, rbp;
        mov rcx, r14;                            // name_len

        lea r11, [rip + _rn_entry_buf];
        mov rax, [r11 + 8];                      // kind qword
        and rax, 0xF;
        mov r8, rax;
        lea r11, [rip + _rn_entry_buf];
        mov rax, [r11];                          // inode qword
        mov r9, rax;

        call json_line_render;

        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  rn_ls_tty_fail;

        mov r14, rax;                            // bytes composed
        // Fall through to shared emit -- JSON path deliberately
        // SKIPS color wrap regardless of AS_BIT_COLOR (structured
        // output must not carry ANSI escapes).
        jmp rn_ls_emit_wire_no_color;

        // ==========================================================
        // v1.1.0 ENH-005 (#25) + ENH-023 (#41): shared emit path.
        //
        // On entry:
        //   r15 = buf_ptr  (bytes to write)
        //   r14 = bytes    (total bytes in buf)
        //
        // Color decision:
        //   * If AS_BIT_JSON set -> jump was already routed to
        //     rn_ls_emit_wire_no_color (structured branch).
        //   * If AS_BIT_COLOR unset -> no color.
        //   * If AS_BIT_COLOR set and AS_BIT_COLOR_AUTO unset -> color.
        //   * If AS_BIT_COLOR set and AS_BIT_COLOR_AUTO set -> probe
        //     stdout KIND; today fd 1 has no cap-slot binding (M3
        //     compat shim; see tty_write.pdx §TW_KIND_TTY note), so
        //     the probe reduces to "not a TTY" -> no color.
        //
        // When color is on:
        //   1. color_pick(kind_nibble, mode=0, schema=0) -> palette
        //   2. color_sgr_prefix into _rn_sgr_prefix_scratch (<= 6 B)
        //   3. tty_write prefix
        //   4. tty_write content
        //   5. color_sgr_suffix into _rn_sgr_suffix_scratch (4 B)
        //   6. tty_write suffix
        // Each tty_write's negative-errno collapses via the shared
        // rn_ls_tty_fail label.
        //
        // sem_emit_entry (semantic-pipe emission) is UNCHANGED across
        // every render path -- the wire record is always the 144-byte
        // PdxFsDirEntry@0.1 (SemanticEmit's contract).
        // ==========================================================
      rn_ls_emit_wire:
        // Gate: AS_BIT_COLOR set?
        mov r10, r13;
        mov r11, 0x20;                           // AS_BIT_COLOR
        and r10, r11;
        cmp r10, 0;
        je  rn_ls_emit_wire_no_color;

        // AS_BIT_COLOR_AUTO set? If so, probe -> today: no color.
        mov r10, r13;
        mov r11, 0x4000;                         // AS_BIT_COLOR_AUTO
        and r10, r11;
        cmp r10, 0;
        jne rn_ls_emit_wire_no_color;            // auto -> off today

        // ---- Color ON path: pick palette + wrap ---------------
        //
        // rdi = kind_nibble (from _rn_entry_buf[8] low 4)
        // rsi = mode_bits    = 0 placeholder
        // rdx = schema_id    = 0 (schema-registry lookup awaits ENH-010
        //                         at libpdx-schema-registry.M1)
        lea r11, [rip + _rn_entry_buf];
        mov rax, [r11 + 8];
        and rax, 0xF;
        mov rdi, rax;
        xor rsi, rsi;
        xor rdx, rdx;
        call color_pick;

        // rax = palette_id. If palette == 0 (CP_PAL_NONE), skip color
        // wrap and emit content directly. r10 holds palette across
        // the prefix/content/suffix trio.
        mov r10, rax;
        cmp r10, 0;
        je  rn_ls_emit_wire_no_color;

        // Compose SGR prefix into _rn_sgr_prefix_scratch (max 6 B).
        lea r11, [rip + _rn_sgr_prefix_scratch];
        mov rdi, r11;
        mov rsi, 8;                              // scratch cap
        mov rdx, r10;                            // palette_id
        call color_sgr_prefix;

        // rax = prefix bytes; overflow (0xFFFFFFFFFFFFFFFF) -> tty_fail.
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  rn_ls_tty_fail;

        // tty_write(&_rn_sgr_prefix_scratch, rax).
        lea r11, [rip + _rn_sgr_prefix_scratch];
        mov rdi, r11;
        mov rsi, rax;
        call tty_write;
        cmp rax, 0;
        jl  rn_ls_tty_fail;

        // tty_write(buf, bytes).
        mov rdi, r15;
        mov rsi, r14;
        call tty_write;
        cmp rax, 0;
        jl  rn_ls_tty_fail;

        // Compose SGR suffix into _rn_sgr_suffix_scratch (4 B).
        lea r11, [rip + _rn_sgr_suffix_scratch];
        mov rdi, r11;
        mov rsi, 8;                              // scratch cap
        call color_sgr_suffix;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  rn_ls_tty_fail;

        // tty_write(&_rn_sgr_suffix_scratch, rax).
        lea r11, [rip + _rn_sgr_suffix_scratch];
        mov rdi, r11;
        mov rsi, rax;
        call tty_write;
        cmp rax, 0;
        jl  rn_ls_tty_fail;

        // Bump LS_ST_COLOR (slot 7) so the tool's stats record how
        // many entries were emitted with ANSI SGR.
        mov rdi, 7;                              // RN_STAT_COLOR
        call ls_note;

        jmp rn_ls_after_wire;

      rn_ls_emit_wire_no_color:
        // ---- Plain content emit (no color wrap) ----
        mov rdi, r15;
        mov rsi, r14;
        call tty_write;
        cmp rax, 0;
        jl  rn_ls_tty_fail;

      rn_ls_after_wire:
        // ---- sem_emit_entry(&_rn_entry_buf) -- unchanged ------------
        lea r11, [rip + _rn_entry_buf];
        mov rdi, r11;
        call sem_emit_entry;

        cmp rax, 0;                              // SE_OK
        jne rn_ls_send_fail;

        // ---- Bump LS_ST_ENTRIES + continue loop ----------------------
        mov rdi, 3;                              // RN_STAT_ENTRIES
        call ls_note;

        jmp rn_ls_continue;

      rn_ls_hidden:
        // ---- Hidden: bump LS_ST_HIDDEN + continue --------------------
        mov rdi, 5;                              // RN_STAT_HIDDEN
        call ls_note;
        jmp rn_ls_continue;

        // ls.ENH-020 (#38): shared continuation dispatcher. Both
        // "advance to the next entry" sites above used to jump
        // straight to rn_ls_loop (call pdxfs_dir_readnext again); GDF
        // mode instead needs to advance the buffered emission cursor.
        // r13 (flag_bits) is untouched by either predecessor, so this
        // check is safe to run unconditionally.
      rn_ls_continue:
        // ls.ENH-015 (#33): single-file mode wins over GDF mode --
        // checked first because one synthetic entry is the entire
        // "listing"; terminate immediately rather than calling
        // pdxfs_dir_readnext again (same cap would re-hit -EBADF).
        lea r11, [rip + _rn_single_file_mode];
        mov r10, [r11];
        cmp r10, 0;
        jne rn_ls_done;

        lea r11, [rip + _rn_gdf_mode];
        mov r10, [r11];
        cmp r10, 0;
        jne rn_ls_gdf_emit_next;
        jmp rn_ls_loop;

      rn_ls_done:
        // ---- Success --------------------------------------------------
        mov rax, 0xFFFFEB00;                     // LS_OK
        jmp rn_ls_epilogue;

      rn_ls_bad_path:
        mov rdi, 4;                              // RN_STAT_ERRORS
        call ls_note;
        mov rax, 0xFFFFEB21;                     // LS_ERR_BAD_PATH
        jmp rn_ls_epilogue;

      rn_ls_bind_fail:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB24;                     // LS_ERR_EMIT_BIND
        jmp rn_ls_epilogue;

      rn_ls_readdir_fail:
        // ls.ENH-015 (#33): sys_pdxfs_dir_readnext returns -EBADF
        // (0xFFFFFFFFFFFFFFF7) for TWO distinct substrate conditions
        // that the kernel body cannot itself tell apart (see
        // paideia-os src/kernel/core/syscall/handlers/
        // sys_pdxfs_dir_readnext.pdx §DIR-MODE GATE): (a) LS_DIR_CAP_SLOT
        // was never populated (the M3 "shell hasn't wired a cap yet"
        // case this exit code was originally designed to surface), and
        // (b) LS_DIR_CAP_SLOT holds a live cap whose mode nibble is
        // NOT DIR -- i.e. a regular-file cap the shell already
        // narrowed to the argument path. rax still holds the raw
        // -errno here (comparisons do not clobber it).
        //
        // A non-null path_ptr (r12) is used as the second signal that
        // disambiguates (b) from (a): a bare `ls` invocation with no
        // argument never has anything to name a synthetic row with,
        // so that shape keeps the pre-existing LS_ERR_READDIR
        // behaviour unconditionally (protects the M3 boot-smoke
        // "cap slot never wired" fingerprint from regressing). This is
        // an interim heuristic, not a real cap/argument correspondence
        // check (paideia-os/ls#29 tracks the real fix + the standalone
        // `ls file.txt`-with-no-pre-narrowed-cap case); it is exactly
        // the scope #33 calls out as landable before #29 closes: "a
        // shell that already narrows to a file cap gets correct
        // behaviour."
        mov r10, 0xFFFFFFFFFFFFFFF7;              // -EBADF
        cmp rax, r10;
        jne rn_ls_readdir_fail_real;
        cmp r12, 0;                               // path_ptr
        je  rn_ls_readdir_fail_real;
        jmp rn_ls_file_fallback;

      rn_ls_readdir_fail_real:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB22;                     // LS_ERR_READDIR
        jmp rn_ls_epilogue;

      rn_ls_file_fallback:
        // ls.ENH-015 (#33): compose one PdxFsDirEntry-shaped record
        // from path_ptr via the pure rn_compose_file_entry helper, then
        // fall into the SAME render dispatch a real directory entry
        // uses (rn_ls_render_dispatch) -- no duplicated format-flag
        // switch. See RN_ENT_KIND_FILE's comment for why kind is a
        // hardcoded FILE placeholder rather than a real stat result
        // (no symlink vnode type exists in tmpfs yet, and no cap-kind-
        // query trampoline is exposed to userspace to distinguish one
        // from a regular file); `-L` / real symlink-vs-file rendering
        // for this row is therefore not representable today and is
        // out of scope until both land.
        lea r11, [rip + _rn_entry_buf];
        mov rdi, r11;                              // entry_buf_va
        mov rsi, r12;                              // name_ptr = path_ptr
        call rn_compose_file_entry;
        mov r14, rax;                              // name_len for dispatch

        lea r11, [rip + _rn_single_file_mode];
        mov r10, 1;
        mov [r11], r10;

        lea r11, [rip + _rn_entry_buf];
        add r11, 24;                               // RN_ENT_OFF_NAME
        mov rbp, r11;                              // name_ptr for dispatch

        jmp rn_ls_render_dispatch;

      rn_ls_tty_fail:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB23;                     // LS_ERR_TTY_WRITE
        jmp rn_ls_epilogue;

      rn_ls_send_fail:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB25;                     // LS_ERR_EMIT_SEND
        jmp rn_ls_epilogue;

      rn_ls_audit_fail:
        mov rdi, 4;
        call ls_note;
        mov rax, 0xFFFFEB26;                     // LS_ERR_AUDIT
        // audit_ls_commit is a no-op here (_au_id stayed 0) so the
        // unified epilogue is safe -- no separate no-audit epilogue
        // needed.
        jmp rn_ls_epilogue;

      rn_ls_epilogue:
        // ---- M3-003: close DirListRecord audit frame -----------------
        //
        // Save exit code in r13 (dead at this point -- flag_bits no
        // longer needed), call audit_ls_commit, restore.
        // audit_ls_commit gates internally on _au_id != 0, so the
        // pre-audit LS_ERR_BAD_PATH path is safe here.
        mov r13, rax;                            // save exit_code
        mov rdi, r13;
        call audit_ls_commit;                    // clobbers rax
        mov rax, r13;                            // restore exit_code

        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // rn_compose_file_entry(entry_buf_va, name_ptr) -> name_len
  //
  // ls.ENH-015 (#33): pure record-composition helper for the file-as-
  // path fallback (rn_ls_file_fallback above). Writes a synthetic
  // 128-byte PdxFsDirEntry-shaped record at entry_buf_va so it can be
  // rendered by the SAME per-entry dispatch (rn_ls_render_dispatch)
  // that renders a real pdxfs_dir_readnext result -- this function
  // owns none of the format-flag logic, only the record shape.
  //
  // Signature: (u64, u64) -> u64 !{mem} @{}
  //   RDI (input):  entry_buf_va -- caller-owned 128-byte buffer
  //                                 (same shape/size as _rn_entry_buf).
  //   RSI (input):  name_ptr     -- NUL-terminated name source
  //                                 (path_ptr from argv; not read past
  //                                 RN_ENT_NAME_MAX bytes even if
  //                                 unterminated within that window).
  //   RAX (output): name_len, clamped to [0, RN_ENT_NAME_MAX=104].
  //
  // Record fields written:
  //   +0  (inode)         -- 0 placeholder. No cap-to-inode lookup is
  //                          reachable from a held KIND_PDXFS_FILE cap
  //                          without a stat trampoline this repo does
  //                          not have (same placeholder discipline as
  //                          owner/mtime/mode_bits elsewhere in this
  //                          file, pending sys_pdxfs_stat_by_inode
  //                          integration).
  //   +8  (kind, low nibble) -- RN_ENT_KIND_FILE (8) unconditionally.
  //                          See RN_ENT_KIND_FILE's own comment: tmpfs
  //                          has no symlink vnode type at HEAD and no
  //                          cap-kind-query trampoline exists, so a
  //                          real file cap and a hypothetical future
  //                          symlink cap are indistinguishable here.
  //   +16 (name_len)       -- strnlen(name_ptr, RN_ENT_NAME_MAX).
  //   +24 (name, 104 B)    -- name bytes, zero-padded past name_len
  //                          (the whole 128-byte record is zeroed
  //                          first, so padding is implicit).
  //
  // Register plan (leaf; no nested calls, so no callee-save / stack
  // discipline to preserve -- every register below is caller-save):
  //   rdi = entry_buf_va (input, read-only throughout)
  //   rsi = name_ptr     (input, read-only throughout)
  //   r10 = scratch address / zero-fill value
  //   r9  = scratch address / RN_ENT_KIND_FILE literal
  //   r8  = scratch address (byte-copy loop src)
  //   rcx = name_len accumulator (also the return value staging reg)
  //   rax = byte-load scratch (xor+mov_b #1248 mitigation) / return
  // ==========================================================================
  pub let rn_compose_file_entry : (u64, u64) -> u64 !{mem} @{} =
    fn (entry_buf_va: u64) (name_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.ENH-015 (#33): compose a synthetic 128-byte PdxFsDirEntry-shaped record from a raw NUL-terminated name so Runner::runner_ls's rn_ls_file_fallback can render a non-directory LS_DIR_CAP_SLOT cap through the existing per-entry dispatch instead of a duplicate format switch. Body: (1) zero all 16 u64 lanes of entry_buf_va via a lane-indexed store loop (rcfe_zero_loop) -- this makes every field past name_len implicitly zero-padded and the inode field a stable 0 placeholder. (2) store RN_ENT_KIND_FILE (8) as a full qword at +8 (matches the existing RN_ENT_OFF_KIND read-and-mask-low-nibble convention used throughout Runner). (3) strnlen(name_ptr, 104) via rcfe_strlen_loop: byte-scan with the #1248 mitigation (xor rax, rax; mov_b rax, [addr]) bounded at RN_ENT_NAME_MAX (104) so a name longer than the record's name field is clamped rather than overrun -- the bound check runs BEFORE the byte load each iteration, so byte index 104 of an unterminated name is never read. (4) store the clamped length (rcx) as a qword at +16. (5) rcfe_copy_loop byte-copies rcx bytes from name_ptr to entry_buf_va+24 (RN_ENT_OFF_NAME), same #1248-mitigated load + mov_b store idiom used by rn_ls_copy_head elsewhere in this file. (6) return rcx (clamped name_len) in rax. Leaf function: no CALL instructions, so no push/pop parity or SysV pre-call alignment to maintain -- every register used (rax, rcx, r8, r9, r10) is caller-save and none of rdi/rsi is ever overwritten, so both inputs stay valid for the whole body. paideia-as conformance: no test mnemonic, every zero-check is cmp reg, 0; every cmp immediate (16, 104) fits imm32; no and with a 64-bit immediate; byte reads use xor rax, rax; mov_b rax, [reg] with [reg]-only addressing (no [reg+reg]); scaled-index stores ([r10 + rcx * 8]) match the existing GDF copy-loop idiom in runner_ls. Labels prefixed rcfe_.",
      block: {
        // ---- (1) Zero the 128-byte record (16 u64 lanes) ----------
        mov r10, rdi;                              // dst base
        xor rax, rax;                               // zero value
        mov rcx, 0;                                 // lane idx

      rcfe_zero_loop:
        cmp rcx, 16;
        jae rcfe_zero_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp rcfe_zero_loop;

      rcfe_zero_done:
        // ---- (2) kind nibble at +8 = RN_ENT_KIND_FILE (8) ----------
        mov r10, rdi;
        mov r9, 8;                                  // RN_ENT_KIND_FILE
        mov [r10 + 8], r9;

        // ---- (3) name_len = strnlen(name_ptr, RN_ENT_NAME_MAX=104) -
        mov r10, rsi;                               // name_ptr copy for scan
        xor rcx, rcx;                                // len accumulator

      rcfe_strlen_loop:
        mov r9, 104;                                 // RN_ENT_NAME_MAX
        cmp rcx, r9;
        jae rcfe_strlen_done;
        xor rax, rax;
        mov r8, r10;
        add r8, rcx;
        mov_b rax, [r8];                             // #1248 mitigation
        cmp rax, 0;
        je  rcfe_strlen_done;
        add rcx, 1;
        jmp rcfe_strlen_loop;

      rcfe_strlen_done:
        // ---- (4) store name_len at +16 -----------------------------
        mov r10, rdi;
        mov [r10 + 16], rcx;

        // ---- (5) copy rcx bytes from name_ptr to entry_buf_va+24 ---
        xor r9, r9;                                  // idx = 0

      rcfe_copy_loop:
        cmp r9, rcx;
        jae rcfe_copy_done;
        mov r8, rsi;
        add r8, r9;
        xor rax, rax;
        mov_b rax, [r8];                             // #1248 mitigation
        mov r10, rdi;
        add r10, 24;                                 // RN_ENT_OFF_NAME
        add r10, r9;
        mov_b [r10], rax;
        add r9, 1;
        jmp rcfe_copy_loop;

      rcfe_copy_done:
        // ---- (6) return clamped name_len ---------------------------
        mov rax, rcx;
        ret
      }
    }
}
