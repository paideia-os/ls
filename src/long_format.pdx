// src/long_format.pdx -- ls.M2-001 (paideia-os/ls#4)
//
// LongFormat module: the `-l` long-format layout. Renders one
// directory-entry line as:
//
//   <kind> <mode:o> <owner> <size> <mtime> <name>\n
//
// where the columns are separated by single spaces.  The `-h` flag
// selects HumanSize for the size column; without `-h` the size
// renders as raw decimal via Render::render_dec_u64.  The owner
// column is delegated to OwnerCol::owner_col_render_from_row --
// the caller passes the KIND_USER row already decoded upstream
// (via OwnerCol::owner_col_render_from_wire during the M3 readdir
// pass, or by direct cap query during a M4 fixture).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// One entry point:
//
//   long_format_line(dst_ptr, dst_cap,
//                    name_ptr,
//                    kind_mode_flags,
//                    size_bytes,
//                    extra_ptr)
//     -> bytes_written | LF_ERR_OVERFLOW
//
// paideia-as caps a lambda at 6 register-passed parameters (System-V
// register cap; P0276), so the field set is packed rather than the
// nine independent leaf values an unpacked API would prefer:
//   kind_mode_flags = (kind_nibble & 0xF)
//                     | ((mode_bits & 0x1FF) << 4)
//                     | ((human_size_flag & 1) << 13)
//   extra_ptr -> 16-byte caller-owned scratch: [0..8) = mtime_ns,
//                [8..16) = owner_row.
// name from the entry blob; kind_nibble + mode_bits + size + mtime
// from the KIND_PDXFS_FILE cap's row via pdxfs_file_row_mode / _len /
// _mtime; owner_row from a KIND_USER decode.
//
// =============================================================================
// COLUMN SEMANTICS
// =============================================================================
//
//   kind      One character from a 4-bit nibble in mode_bits[15:12]
//             (PdxFS-v1 file-type nibble; see paideia-os
//             src/kernel/core/cap/kind_pdxfs_file.pdx SECTION 1).
//             The caller passes the nibble ALREADY EXTRACTED as an
//             independent parameter -- LongFormat does not re-mask
//             mode_bits, which lets a caller with a fresh nibble
//             (say, from a directory-only PdxFS cap that packs
//             kind differently) still use this renderer.
//             - 0x4 dir      -> 'd'
//             - 0x8 file     -> '-'  (POSIX convention)
//             - 0xA symlink  -> 'l'
//             - 0xC special  -> 's'
//             - other        -> '?'  (unknown; consumer diagnostic)
//   mode      Three octal digits from mode_bits[8:0]. Rendered as
//             three ASCII digits '0'..'7'. No POSIX 'rwxrwxrwx'
//             glyphs at M2 -- that translation lands with M3 when
//             the schema/MIME palette decides how permissions
//             render in each output mode (text vs JSON schema).
//   owner     Delegated to owner_col_render_from_row (M2-002).
//             Emits `u:<row>`.
//   size      Delegated to human_size_render (M2-003) when
//             human_size_flag != 0, else render_dec_u64 (Render).
//   mtime     Rendered as `ns:<decimal>` so a downstream schema-
//             typed consumer can recover the raw i128 mtime
//             unambiguously.  Real calendar rendering awaits
//             pdx-time at R54 (plan doc §3.6).
//   name      Copied verbatim from name_ptr up to the first NUL.
//             No escaping at M2 (names are already caller-owned
//             NUL-terminated bytes from the PdxFS-v1 entry blob;
//             malicious-byte escaping is a M3 concern once the
//             schema pipe declares its escaping rules).
//   \n        Line terminator.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`LongFormat`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Largest immediate
//     is 0x2E ('.', unused here) -- most immediates are ASCII bytes
//     (<= 0x7F) or small shift counts (<= 6).  Sentinel returns
//     (0xFFFFFFFFFFFFFFFF) stage into r11 for compare.
//   - Byte reads (name copy loop) use `xor rax; mov_b rax, [ptr]`
//     per #1248.
//   - Byte writes via `mov_b [dst], reg` (through Render, or inline
//     inside the name copy loop through render_byte_write).
//   - r11 is scratch for LEA + sentinel + short-lived constants.
//   - Non-leaf; many nested calls.  Callee-save discipline: 7
//     pushes (rbx, r12, r13, r14, r15, rbp, r9) = 56 bytes; entry
//     rsp % 16 == 8; 8 + 56 = 64; 64 % 16 == 0 at every nested-call
//     site.
//   - extra_ptr (the caller-save r9 register arg) is spilled to
//     [rsp+0] in the prologue -- r9 is caller-saved and would
//     otherwise be clobbered by the first nested call -- and
//     reloaded at each consume site (`mov r10, [rsp]`).
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   render_dec_u64                -- Render (src/render.pdx)
//   render_byte_write             -- Render (src/render.pdx)
//   human_size_render             -- HumanSize (src/human_size.pdx)
//   owner_col_render_from_row     -- OwnerCol (src/owner_col.pdx)

module LongFormat = structure {

  // ==========================================================================
  // Return codes
  // ==========================================================================
  pub let LF_OK              : u64 = 0
  pub let LF_ERR_OVERFLOW    : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Kind-nibble letter table
  //
  // Indexed by kind_nibble (0..15). Slots that PdxFS-v1 does not
  // assign a type to render as '?' so a corrupted mode field
  // surfaces as a visible column value rather than a silent blank.
  //
  // ASCII:  '?' = 0x3F   'd' = 0x64   '-' = 0x2D
  //         'l' = 0x6C   's' = 0x73
  // ==========================================================================
  pub let _lf_kind_letters : [u8; 16] = [
      0x3F, 0x3F, 0x3F, 0x3F, 0x64, 0x3F, 0x3F, 0x3F,
      0x2D, 0x3F, 0x6C, 0x3F, 0x73, 0x3F, 0x3F, 0x3F
  ]

  // ==========================================================================
  // long_format_line(dst_ptr, dst_cap, name_ptr, kind_mode_flags,
  //                  size_bytes, extra_ptr) -> bytes_written | LF_ERR_OVERFLOW
  //
  // kind_mode_flags packs three small fields the 6-param register cap
  // (P0276) no longer leaves room to pass independently:
  //   bits [3:0]   = kind_nibble
  //   bits [12:4]  = mode_bits (9 bits)
  //   bit  [13]    = human_size_flag
  // extra_ptr points at a 16-byte caller-owned scratch: [0..8) = mtime_ns,
  // [8..16) = owner_row.
  //
  // Register allocation across the twelve-step emit sequence:
  //   rbx = anchor  (dst_ptr; never changes; final total = cursor - anchor)
  //   r12 = cursor  (advances after each emit)
  //   r13 = cap remaining
  //   r14 = (mode_bits | human_size_flag << 9), unpacked from rcx at
  //         prologue; mode_bits consumed at step 3 (bits 0..8), the
  //         flag at step 7 (bit 9) -- they never collide.
  //   r15 = size_bytes (spilled from r8 at prologue; consumed at step 7)
  //   rbp = name_ptr (spilled from rdx at prologue; consumed at step 11)
  //   [rsp + 0] = extra_ptr (spilled from r9 at prologue -- r9 is
  //               caller-saved and would be clobbered by the first
  //               nested call); reloaded at each consume site.
  //
  // kind_nibble is consumed at step 1 BEFORE any nested call so it
  // reads directly from rcx's low 4 bits and needs no spill.
  //
  // Overflow discipline: every nested call's return is compared
  // against 0xFFFFFFFFFFFFFFFF staged in r11; any child overflow
  // jumps to lf_overflow which returns LF_ERR_OVERFLOW without
  // touching dst beyond what already succeeded.  Partial writes on
  // overflow are acceptable here (unlike Render's atomic refusal)
  // because a line-level rendering that overruns dst_cap is a
  // caller-provided-too-small-buffer scenario the caller must
  // discard the whole line -- the partial bytes carry a truncated
  // schema no downstream consumer will read.
  // ==========================================================================
  pub let long_format_line
    : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dst_ptr: u64) (dst_cap: u64) (name_ptr: u64)
       (kind_mode_flags: u64) (size_bytes: u64) (extra_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.M2-001 (#4): the `-l` long-format line renderer. Six-argument entry is the System-V register-passed cap (P0276); kind_nibble/mode_bits/human_size_flag pack into kind_mode_flags and mtime_ns/owner_row move behind extra_ptr (a 16-byte caller-owned scratch) since paideia-as lambdas do not support stack-passed args. Twelve emit steps between callee-save pushes; each nested call checks the r11-staged 0xFFFFFFFFFFFFFFFF sentinel and short-circuits on overflow to lf_overflow. Column order (kind, mode, owner, size, mtime, name) adds one column (mode) beyond the plan doc §4.4 four-column base so a text-layer reader without the schema pipe still sees permission bits; the drop-swap point is the three-digit block starting at lf_emit_mode. Kind letter derived by table lookup at _lf_kind_letters[nibble & 0xF], with '?' fallback for unknown nibbles. Mode rendered as three raw octal digits from mode_bits[8:0]; the POSIX rwxrwxrwx glyph translation lands with the M3 schema-driven palette. Mtime rendered as `ns:<decimal>` because pdx-time doesn't ship until R54 (plan §3.6); the prefix keeps the column self-describing so a downstream typed consumer can recover the raw i128 value. Size dispatches to human_size_render (M2-003) or render_dec_u64 by the human_size_flag bit. Name copied byte-by-byte until NUL through inline mov_b loads (#1248 mitigation) forwarded to render_byte_write.  Callee-save + rsp discipline: 7 pushes (rbx, r12..r15, rbp, r9) = 56 bytes; entry rsp % 16 == 8; 8 + 56 = 64; 64 % 16 == 0 at every nested-call site. extra_ptr lives at [rsp+0] post-prologue and reloads at each consume site (mtime_ns at step 9b, owner_row at step 5) via `mov r10, [rsp]`. paideia-as conformance: no `test`; largest immediate 0x7F (ASCII); byte writes via mov_b [dst], reg through Render; mov_b addressing is [reg] only so every indexed byte load computes its address into r11 first. Labels prefixed lf_.",
      block: {
        // ---- prologue ------------------------------------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        push r9;                             // extra_ptr (caller-saved;
                                              // spill before first call)

        mov rbx, rdi;                        // anchor
        mov r12, rdi;                        // cursor
        mov r13, rsi;                        // cap remaining
        mov r14, rcx;                        // unpack mode_bits | flag<<9
        shr r14, 4;
        and r14, 0x3FF;
        mov r15, r8;                         // size_bytes
        mov rbp, rdx;                        // name_ptr

        // ---- step 1: emit kind letter -------------------------------
        // kind_nibble still in rcx (caller-save, not yet clobbered).
        mov rax, rcx;
        and rax, 0xF;
        lea r11, [rip + _lf_kind_letters];
        add r11, rax;                        // r11 = &_lf_kind_letters[nibble]
        xor rdx, rdx;
        mov_b rdx, [r11];                    // kind letter into rdx

        mov rdi, r12;
        mov rsi, r13;
        // rdx = kind letter (already loaded)
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // ---- step 2: emit ' ' ---------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x20;                       // ' '
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // ---- step 3: emit three octal digits from r14 --------------
      lf_emit_mode:
        // digit_hi = (mode >> 6) & 7
        mov rax, r14;
        shr rax, 6;
        and rax, 7;
        add rax, 0x30;
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, rax;
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // digit_mid = (mode >> 3) & 7
        mov rax, r14;
        shr rax, 3;
        and rax, 7;
        add rax, 0x30;
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, rax;
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // digit_lo = mode & 7
        mov rax, r14;
        and rax, 7;
        add rax, 0x30;
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, rax;
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // ---- step 4: emit ' ' ---------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x20;
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // ---- step 5: emit owner via OwnerCol (owner_row via extra_ptr) -
        mov r10, [rsp];                      // r10 = extra_ptr
        mov rdx, [r10 + 8];                  // owner_row
        mov rdi, r12;
        mov rsi, r13;
        call owner_col_render_from_row;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, rax;
        sub r13, rax;

        // ---- step 6: emit ' ' ---------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x20;
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // ---- step 7: emit size (human vs raw dec) -------------------
        mov rax, r14;                        // human_size_flag = bit 9
        shr rax, 9;
        and rax, 1;
        cmp rax, 0;
        je  lf_size_raw;

        // human path
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r15;                        // size_bytes
        call human_size_render;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, rax;
        sub r13, rax;
        jmp lf_after_size;

      lf_size_raw:
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r15;
        call render_dec_u64;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, rax;
        sub r13, rax;

      lf_after_size:
        // ---- step 8: emit ' ' ---------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x20;
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // ---- step 9a: emit 'n' 's' ':' ------------------------------
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x6E;                       // 'n'
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x73;                       // 's'
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x3A;                       // ':'
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // ---- step 9b: emit decimal(mtime_ns via extra_ptr) ----------
        mov r10, [rsp];                      // r10 = extra_ptr
        mov rdx, [r10];                      // mtime_ns
        mov rdi, r12;
        mov rsi, r13;
        call render_dec_u64;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, rax;
        sub r13, rax;

        // ---- step 10: emit ' ' --------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x20;
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;

        // ---- step 11: name copy loop --------------------------------
        // Read bytes from rbp (name_ptr) until NUL; emit each.
      lf_name_head:
        xor rax, rax;
        mov_b rax, [rbp];
        cmp rax, 0;
        je  lf_name_done;

        mov rdi, r12;
        mov rsi, r13;
        mov rdx, rax;
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;
        sub r13, 1;
        add rbp, 1;
        jmp lf_name_head;

      lf_name_done:
        // ---- step 12: emit '\n' -------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 0x0A;                       // '\n'
        call render_byte_write;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  lf_overflow;
        add r12, 1;

        // ---- success: return cursor - anchor -----------------------
        mov rax, r12;
        sub rax, rbx;
        pop r9;                               // discard spilled extra_ptr
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lf_overflow:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop r9;                               // discard spilled extra_ptr
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
