// src/semantic_emit.pdx -- ls.M3-001 + ls.M3-002 + ls.M4-004
//                          (paideia-os/ls#8 + #9 + #14)
//
// SemanticEmit module: schema-bind + per-entry PdxFsDirEntry record
// emission on ls's stdout KIND_IPC_ENDPOINT.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// Two entry points:
//
//   sem_emit_bind_stdout() -> u64
//     Idempotent bind of ls's stdout endpoint slot to the PdxFsDirEntry
//     schema. ls.R90-XREPO.012.M4-002 (#30): delegates to libpdx-
//     semantic-pipe::Registry::bind_by_name(fd = LS_STDOUT_ENDPOINT_
//     SLOT, name_ptr = &_se_schema_name, name_len = 17) -- the
//     schema-registry-aware entry point that resolves the name against
//     a live svc.schema-registry when one is reachable and falls back
//     to the same deterministic pre-BLAKE3 fold ls used to run inline
//     (spipe_schema_id_from_name) when it is not, all inside a single
//     call. This retires ls's own hand-paired reset-then-bind sequence
//     as the mechanism the actual bind depends on -- the hash ls binds
//     with is now byte-for-byte whatever a fresh bind_by_name call for
//     the same name independently produces, proving the end-to-end
//     path rather than agreeing only by construction with ls's own
//     local copy. Returns 0 on success, LS_ERR_EMIT_BIND (0xFFFFEB24)
//     on refusal.
//
//   sem_emit_entry(kernel_entry_ptr) -> u64
//     Emit ONE PdxFsDirEntry record over the pre-bound stdout endpoint.
//     The kernel_entry_ptr points at a 128-byte kernel-visible
//     PdxFsDirEntry (paideia-os src/kernel/core/cap/pdxfs_dir_iter.pdx
//     §1); this function copies it verbatim into a .bss scratch and
//     calls libpdx-semantic-pipe::Send::send_record. Returns 0 on
//     success, LS_ERR_EMIT_SEND (0xFFFFEB25) on refusal.
//
// =============================================================================
// WIRE RECORD SHAPE (M3-002)
// =============================================================================
//
// The bytes on the wire are 144 = 128 (kernel PdxFsDirEntry) + 16
// (owner Cap wire):
//
//   [0..128]  the kernel-visible PdxFsDirEntry copied verbatim
//             (inode @0, kind @8, name_len @16, name[104] @24 --
//             layout mirrors paideia-os pdxfs_dir_iter.pdx §1).
//   [128..136] owner_kind : u64 = KIND_USER (0x190)
//   [136..144] owner_target_ptr : u64 = user_row (low 16 bits from
//             the file's KIND_USER_ref, zero-extended), sourced from
//             OwnerCol::owner_col_owner_row_from_entry(kernel_entry_ptr)
//             (src/owner_col.pdx, ls.ENH-008 #28). The kernel
//             PdxFsDirEntry does not carry an owner field at HEAD, so
//             that accessor honestly returns 0; the concrete owner
//             discovery lands in a follow-up round when either
//             (a) PdxFsDirEntry grows an owner_ref field, or (b) the
//             tool syscalls sys_pdxfs_stat_by_inode for the owner
//             during emit. Either upgrade is now a one-function-body
//             edit inside owner_col_owner_row_from_entry rather than a
//             change to sem_emit_entry / sem_emit_wire_compose.
//
// This is the D2 literal at the schema level: the downstream query
// tool filters by owner == alice by comparing the 16-byte Cap wire
// against a KIND_USER lookup, never by parsing a text uid. See
// r49-r50-plan.md §4.4 ("owner:KIND_USER_ref, not a uid integer").
//
// M3-001 shipped bytes [0..128] with SE_WIRE_RECORD_SIZE = 128; the
// M3-002 upgrade appends bytes [128..144] and bumps SE_WIRE_RECORD_
// SIZE to 144. The two bytes-[0..128] regions are identical -- a
// decoder that reads an M3-002 record with an M3-001 schema pin still
// sees a valid prefix.
//
// =============================================================================
// SCHEMA HASH (ls.ENH-010, paideia-os/ls#27; migrated ls.R90-XREPO.
// 012.M4-002, paideia-os/ls#30)
// =============================================================================
//
// libpdx-semantic-pipe::Binding requires a non-zero 32-byte hash
// (SP_ERR_NULL_HASH refuses schema_id == 0 -- see binding.pdx §40).
// Two independent call sites derive that hash today, deliberately not
// unified into one:
//
//   - sem_emit_bind_stdout (the actual bind path, #30): calls
//     libpdx-semantic-pipe::Registry::bind_by_name(fd, &_se_schema_
//     name, 17) directly. bind_by_name resolves the name against a
//     live svc.schema-registry when reachable, else falls back
//     in-library to the same deterministic pre-BLAKE3 fold
//     (Schema::spipe_schema_id_from_name) that shipped in libpdx-
//     semantic-pipe's Enhancement v2.0 wave (ENH-001, #11), and binds
//     with whichever id it derives. ls never sees or stores this
//     value -- it is entirely internal to the library call.
//   - sem_emit_reset (diagnostic/golden, #27): imprints
//     _se_pdxfsdirentry_hash via a direct call to
//     libpdx-semantic-pipe::Schema::spipe_schema_id_from_name
//     ("PdxFsDirEntry@0.1", 17) so tests/schema_golden.pdx has a
//     stable, inspectable copy of the interim fold to diff against a
//     golden. It is no longer in the bind's dependency chain -- kept
//     as the fixture's own hook, not as a hidden second source of
//     truth for the wire bind.
//
// Neither call site is a cryptographic hash (no collision resistance
// guarantee) at HEAD, but the interim fold IS the same value any other
// adopter of libpdx-semantic-pipe computes for the same schema name --
// byte-identical to that library's own `_wg_hash0` golden in tests/
// wire_golden.pdx -- so ls interoperates with an independently-built
// consumer today rather than agreeing only with its own placeholder
// (the pre-#27 M3-001 stub's actual defect: every stub-imprinting
// adopter picked a different constant). PENDING BLAKE3: the real
// BLAKE3("PdxFsDirEntry@0.1") upgrade lands as a body-only change
// inside spipe_schema_id_from_name when libpdx-schema-registry / the
// paideia-as BLAKE3 intrinsic ships; neither call site above changes
// shape when it does.
//
// =============================================================================
// STDOUT ENDPOINT SLOT
// =============================================================================
//
// LS_STDOUT_ENDPOINT_SLOT = 3 is the placeholder for the
// KIND_IPC_ENDPOINT cap slot the shell.M2 InitCap will populate at
// exec time. libpdx-semantic-pipe treats the "fd" arg as a u64 key
// into its internal binding table; whatever value ls picks here is
// consistent with the value ls hands to sys_ipc_send (Send::send_
// record calls it) so long as the two agree. Slot 3 is chosen to
// sit just above the three seed caps (KIND_USER @0, KIND_TTY @1,
// KIND_PDXFS_FILE @2) declared in caps.decl; the M4 InitCap witness
// pins this convention.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`SemanticEmit`).
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0` (or the
//     wire-value discriminator in the sub-band error return).
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF. Largest immediate
//     is 128 (PDXFS_DIR_ENTRY_SIZE) or the SP_SEND_OK sentinel (0);
//     the 0xFFFFEB2x error returns are `mov rax, imm64` emissions.
//   - Byte reads (per-byte copy of the 128-byte kernel record into
//     the .bss scratch) use `xor rax; mov_b rax, [ptr]` per #1248.
//   - Byte writes via `mov_b [dst], reg` at every store.
//   - r11 is scratch for LEA staging + short-lived intermediates.
//   - sem_emit_reset: non-leaf (calls spipe_schema_id_from_name).
//     One callee-save push (r12, alignment-only -- not read after the
//     call) -> rsp % 16 == 0 at the nested call site.
//   - sem_emit_bind_stdout: non-leaf (calls bind_by_name, ls.
//     R90-XREPO.012.M4-002 #30). One callee-save push (r12,
//     alignment-only) -> entry rsp % 16 == 8; +8 -> rsp % 16 == 0 at
//     the nested call site.
//   - sem_emit_entry: non-leaf (calls owner_col_owner_row_from_entry
//     + send_record). Three callee-save pushes (r12 = kernel_entry_ptr
//     survivor, r13 = copy cursor / wire base, r14 = unused padding)
//     -> 3*8 = 24 bytes; entry rsp % 16 == 8; 8 + 24 = 32; 32 % 16 ==
//     0 at every nested call site. sem_emit_wire_compose (ls.ENH-008,
//     #28) gained the same owner_col_owner_row_from_entry call; its
//     pre-existing sub rsp,8 pad already covered the alignment.
//
// =============================================================================
// CROSS-MODULE SYMBOLS
// =============================================================================
//
// Called:
//   bind_by_name                   -- libpdx-semantic-pipe::Registry
//                                     (ls.R90-XREPO.012.M4-002, #30)
//   send_record                    -- libpdx-semantic-pipe::Send
//   spipe_schema_id_from_name      -- libpdx-semantic-pipe::Schema
//                                     (ls.ENH-010, #27; sem_emit_reset's
//                                     diagnostic imprint only -- the
//                                     bind path no longer calls this
//                                     directly, see #30)
//   owner_col_owner_row_from_entry -- OwnerCol (src/owner_col.pdx)
//                                     -- ls.ENH-008, #28
//
// Written / read:
//   _se_pdxfsdirentry_hash         -- 32-byte PdxFsDirEntry@0.1 schema
//                                     id (this module's .bss)
//   _se_wire_scratch               -- 128-byte record composition
//                                     buffer at M3-001; extended to
//                                     144 bytes at M3-002 (this
//                                     module's .bss)
//   _ls_stats                      -- via ls_note (LS_ST_ENTRIES bump)

module SemanticEmit = structure {

  // ==========================================================================
  // Return codes
  // ==========================================================================
  pub let SE_OK               : u64 = 0
  pub let SE_ERR_BIND         : u64 = 0xFFFFEB24    // LS_ERR_EMIT_BIND mirror
  pub let SE_ERR_SEND         : u64 = 0xFFFFEB25    // LS_ERR_EMIT_SEND mirror

  // ==========================================================================
  // Wire constants
  // ==========================================================================
  //
  // The stdout endpoint cap slot ls consumes at exec time (shell.M2
  // InitCap convention; see file header). u64 because Binding::fd is
  // typed u64 even though at M3 the value fits in a byte.
  pub let LS_STDOUT_ENDPOINT_SLOT : u64 = 3

  // Kernel PdxFsDirEntry size (mirror
  // paideia-os src/kernel/core/cap/pdxfs_dir_iter.pdx §1).
  pub let SE_KERNEL_ENTRY_SIZE : u64 = 128

  // Wire record body size on the semantic pipe.  M3-002 emits 144
  // bytes = 128 kernel PdxFsDirEntry + 16 owner Cap wire (kind at
  // offset 128, target_ptr at offset 136 -- see file header §Wire
  // Record Shape).  Kept as a named constant so a future upgrade
  // (record grows fields, or shrinks under a version-tolerance
  // demotion) is a one-line edit.
  pub let SE_WIRE_RECORD_SIZE : u64 = 144

  // KIND_USER ordinal mirror -- the owner Cap wire's kind field
  // (offset 128 in the M3-002 record).  Value matches Ls::LS_KIND_USER
  // (0x190); mirrored locally so this module does not import Ls.
  pub let SE_OWNER_KIND_USER  : u64 = 0x190

  // Owner Cap wire offsets inside _se_wire_scratch (post-kernel-record).
  pub let SE_OFF_OWNER_KIND   : u64 = 128
  pub let SE_OFF_OWNER_TARGET : u64 = 136

  // ==========================================================================
  // Schema name (.rodata)
  // ==========================================================================
  //
  // _se_schema_name -- the literal schema name string passed to
  // libpdx-semantic-pipe::Schema::spipe_schema_id_from_name at reset
  // time (ls.ENH-010, paideia-os/ls#27). 17 bytes, no NUL terminator
  // (spipe_schema_id_from_name takes an explicit length, not a
  // C-string). This is also `_wg_name0` in libpdx-semantic-pipe's own
  // tests/wire_golden.pdx corpus -- both repos must pass the same
  // bytes to get the same id.
  pub let _se_schema_name : [u8; 17] = "PdxFsDirEntry@0.1"

  // ls.ENH-021 (#39): summary schema name for the trailing
  // PdxLsSummaryRecord@0.1 record. 22 bytes, no NUL terminator (matches
  // the _se_schema_name convention -- spipe_schema_id_from_name takes an
  // explicit length). Wire body carries {entry_count, total_bytes,
  // total_blocks, filtered_count}. The bind + send wiring lands with
  // the Runner summary-accumulator rework; today only the name string
  // ships so a follow-up round has a stable literal to imprint.
  //
  // ls.R90-XREPO.012.M4-002 (#30) migrated sem_emit_bind_stdout's
  // PdxFsDirEntry@0.1 bind onto Registry::bind_by_name (see file
  // header §Schema Hash); that migration does not, by itself, stand
  // up a second bind slot for this summary schema -- a live bind of
  // this name remains its own follow-up when the summary record's
  // send wiring lands.
  //
  // ls.ENH-021 (#39) deferred -- retire this comment when the summary
  // record ships. v1.1.1 (debugger finding 2): this literal is inert
  // .rodata that no emit path reads today; kept only so the ENH-021
  // wiring lands as a use-site edit rather than a re-declare. When
  // ship happens, caps.decl :: declares_output_schemas gains the
  // PdxLsSummaryRecord@0.1 entry and src/schema_dump.pdx's catalog
  // grows the matching second line in the same commit.
  pub let _se_summary_schema_name : [u8; 22] = "PdxLsSummaryRecord@0.1"

  // ==========================================================================
  // .bss storage
  // ==========================================================================
  //
  // _se_pdxfsdirentry_hash -- 32 bytes = 4 u64 lanes. The
  // pre-BLAKE3 schema id for "PdxFsDirEntry@0.1", computed by
  // libpdx-semantic-pipe::Schema::spipe_schema_id_from_name (ls.
  // ENH-010, paideia-os/ls#27). A .bss `uninit` starts zeroed at
  // load; the real id is imprinted by a static init helper below
  // (sem_emit_reset), called once from Runner before its first bind
  // call. Aligned to 8 so the four qword lanes are naturally aligned.
  pub let mut _se_pdxfsdirentry_hash : [u64; 4] = uninit @align(8)

  // _se_wire_scratch -- 144 bytes (18 u64 lanes) at M3-002: 16 lanes
  // for the copied kernel PdxFsDirEntry + 2 lanes for the appended
  // owner Cap wire (kind at lane 16 / offset 128, target_ptr at lane
  // 17 / offset 136). Sized 18 lanes since M3-001 so the M3-002 upgrade
  // did not reshape .bss -- only the copy tail and SE_WIRE_RECORD_SIZE
  // changed.
  pub let mut _se_wire_scratch       : [u64; 18] = uninit @align(8)

  // ==========================================================================
  // sem_emit_reset() -> ()
  //
  // Imprint the real PdxFsDirEntry@0.1 schema id into
  // _se_pdxfsdirentry_hash so Binding::libpdx_semantic_pipe_bind's
  // SP_ERR_NULL_HASH gate (binding.pdx §40) passes.  Called once from
  // Runner before the first bind attempt.  Safe to call more than
  // once; second and subsequent calls are idempotent (the fold is a
  // pure function of the name bytes -- same input, same output).
  //
  // ls.ENH-010 (paideia-os/ls#27): delegates to libpdx-semantic-
  // pipe::Schema::spipe_schema_id_from_name(name_ptr, name_len,
  // out_hash_ptr) over the literal `_se_schema_name` bytes, replacing
  // the M3-001 stub (first byte 0x01, rest zero). This is the same
  // pre-BLAKE3 fold every other adopter of libpdx-semantic-pipe.
  // ENH-001 calls for "PdxFsDirEntry@0.1" -- byte-identical to
  // libpdx-semantic-pipe's own `_wg_hash0` golden in tests/wire_
  // golden.pdx, so an independently-built consumer that binds the
  // same schema name agrees with ls's imprint without coordination.
  // Not cryptographic; upgrades to a real BLAKE3(name) call in place
  // when libpdx-schema-registry / the paideia-as BLAKE3 intrinsic
  // ships, with no change to this call site's shape.
  //
  // Register plan (non-leaf, one callee-save push for alignment):
  //   rdi = name_ptr (LEA _se_schema_name)
  //   rsi = name_len (17, literal)
  //   rdx = out_hash_ptr (LEA _se_pdxfsdirentry_hash)
  //   rax = call return (SP_SCHEMA_OK == 0 always, for this fixed
  //         well-formed input; not checked -- see justification)
  // ==========================================================================
  pub let sem_emit_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.ENH-010 (#27): imprint the real PdxFsDirEntry@0.1 schema id via libpdx-semantic-pipe::Schema::spipe_schema_id_from_name(name_ptr=&_se_schema_name, name_len=17, out_hash_ptr=&_se_pdxfsdirentry_hash), replacing the M3-001 stub-byte imprint. The three gates inside spipe_schema_id_from_name (null name_ptr, name_len == 0 or > 256, null out_hash_ptr) cannot fire for this fixed, well-formed, non-null call site, so the return value is not checked -- there is no error path for sem_emit_reset to report through its () -> () signature, and none of SP_SCHEMA_ERR_NULL_NAME/NAME_RANGE/NULL_HASH is reachable here. Single r12 push for SysV alignment across the nested call: entry rsp % 16 == 8; one push -> rsp % 16 == 0 for spipe_schema_id_from_name's SysV call site. Matched pop before ret. paideia-as conformance: no test mnemonic; no cmp reg, imm > 0x7FFFFFFF (rsi's 17 is the only immediate). r12 is pushed only for alignment parity and is not read after the call. Effects {mem} @{} match spipe_schema_id_from_name's own declared effects. Labels prefixed serst_ (none needed -- straight-line, no branch).",
      block: {
        push r12;                                // SysV alignment for the nested call

        lea rdi, [rip + _se_schema_name];        // name_ptr
        mov rsi, 17;                              // name_len
        lea rdx, [rip + _se_pdxfsdirentry_hash]; // out_hash_ptr
        call spipe_schema_id_from_name;

        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sem_emit_bind_stdout() -> u64
  //
  // Signature: () -> u64 !{mem, sysreg} @{cap}
  //   RAX (output): 0 on success; SE_ERR_BIND (0xFFFFEB24) on refusal.
  //
  // ls.R90-XREPO.012.M4-002 (#30): migrated off the hand-paired
  // "derive a hash locally, then bind with it" sequence onto
  // libpdx-semantic-pipe::Registry::bind_by_name(fd, name_ptr,
  // name_len) -- the schema-registry-aware entry point that resolves
  // PdxFsDirEntry@0.1 against a live svc.schema-registry when one is
  // reachable, or falls back in-library to the same deterministic
  // pre-BLAKE3 fold (spipe_schema_id_from_name) otherwise, and binds
  // with whichever id it derives. ls no longer computes or holds the
  // hash used for this bind at all -- the value bound is whatever a
  // fresh, independent bind_by_name call for the same name produces,
  // which is the literal fingerprint #30 asks for.
  //
  // Idempotent: bind_by_name's inner libpdx_semantic_pipe_bind call
  // returns SP_OK (0) when the fd is already bound to the same hash
  // and SP_ERR_ALREADY_BOUND (3) when bound to a DIFFERENT hash; for
  // ls's fixed-name bind, the second-call return is SP_OK.
  //
  // Register plan (non-leaf, one callee-save push for alignment):
  //   rdi = fd (LS_STDOUT_ENDPOINT_SLOT constant)
  //   rsi = name_ptr (LEA _se_schema_name)
  //   rdx = name_len (17, literal)
  //   rax = call return / SE_ERR_BIND on refusal
  //   r11 = LEA scratch
  //   r12 = alignment pad (SysV callee-save discipline; unused here
  //         but pushed to keep rsp % 16 == 0 for the nested call)
  // ==========================================================================
  pub let sem_emit_bind_stdout : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "ls.M3-001 (#8), migrated ls.R90-XREPO.012.M4-002 (#30): idempotent bind of LS_STDOUT_ENDPOINT_SLOT (3) to the PdxFsDirEntry@0.1 schema, now via libpdx-semantic-pipe::Registry::bind_by_name(fd, name_ptr=&_se_schema_name, name_len=17) rather than ls's own prior two-step spipe_schema_id_from_name + libpdx_semantic_pipe_bind pairing (that pairing remains, unchanged, inside sem_emit_reset for the schema_golden.pdx diagnostic fixture -- see file header §Schema Hash). bind_by_name resolves the name against svc.schema-registry when reachable and otherwise falls back to the identical interim fold, so this call site proves the real end-to-end name-to-bind path rather than agreeing with a golden only by ls computing the same fold twice. Return 0 (SP_OK, bind_by_name's own propagated rc) is treated as success; every other return (bind_by_name's registry-resolve codes 300..304, or libpdx_semantic_pipe_bind's SP_ERR_INVALID_FD 1 / SP_ERR_NULL_HASH 2 / SP_ERR_ALREADY_BOUND 3 / SP_ERR_TABLE_FULL 4) collapses to SE_ERR_BIND (0xFFFFEB24) -- ls's tool-level error taxonomy does not distinguish a registry-resolve failure from a bind-table failure; both mean 'stdout schema emission is not available this run'. ALREADY_BOUND would only fire if some other module previously bound the same slot to a DIFFERENT hash -- ls owns its stdout slot, so this cannot happen in a well-formed process; treating it as an error is defence-in-depth. Single r12 push for SysV alignment across the nested call: entry rsp % 16 == 8; one push -> rsp % 16 == 0 for bind_by_name's SysV call site (3 args, all register-passed, well under paideia-as's 6-arg unsafe-lambda ceiling). Matched pop before every ret. Immediates 3 (endpoint slot), 17 (name_len), and 0 (SP_OK compare) fit imm32 trivially; SE_ERR_BIND stages via r11 (does not fit sign-extended imm32). paideia-as conformance: no test mnemonic; no cmp reg, imm > 0x7FFFFFFF. r11 for LEA + sentinel staging. Effects {mem, sysreg} @{cap} match bind_by_name's own declared effects (mem for its scratch writes, sysreg for the registry-resolve IPC round trip, cap because it consumes ls's KIND_IPC_ENDPOINT). Labels prefixed sebs_.",
      block: {
        push r12;                                // SysV callee-save + alignment

        // Arg marshalling: rdi = fd, rsi = name_ptr, rdx = name_len.
        mov rdi, 3;                              // LS_STDOUT_ENDPOINT_SLOT
        lea r11, [rip + _se_schema_name];
        mov rsi, r11;                            // name_ptr
        mov rdx, 17;                             // name_len ("PdxFsDirEntry@0.1")

        call bind_by_name;

        // Return: SP_OK (0) -> SE_OK (0), anything else -> SE_ERR_BIND.
        cmp rax, 0;
        jne sebs_bind_fail;
        xor rax, rax;                            // SE_OK
        pop r12;
        ret;

      sebs_bind_fail:
        mov rax, 0xFFFFEB24;                     // SE_ERR_BIND
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sem_emit_entry(kernel_entry_ptr) -> u64
  //
  // Signature: (u64) -> u64 !{mem, sysreg} @{cap}
  //   RDI (input): kernel_entry_ptr -- 128-byte kernel-visible
  //                                     PdxFsDirEntry (see
  //                                     paideia-os pdxfs_dir_iter.pdx §1)
  //   RAX (output): 0 on success; SE_ERR_SEND on send_record refusal.
  //
  // Sequence:
  //   (1) Copy kernel_entry_ptr[0..128] into _se_wire_scratch[0..128]
  //       byte-by-byte (paideia-as #1248 mitigation: xor rax, rax
  //       before every mov_b load).
  //   (2) M3-002 + ls.ENH-008 (#28): append owner Cap wire at
  //       scratch[128..144] -- [128..136] = KIND_USER (0x190),
  //       [136..144] = OwnerCol::owner_col_owner_row_from_entry
  //       (kernel_entry_ptr) -- an honest-gap accessor that returns 0
  //       today (PdxFsDirEntry has no owner field), replacing the
  //       earlier inline `xor rax, rax` placeholder. The value
  //       concretises when a follow-up round plumbs per-file owner
  //       into PdxFsDirEntry or exposes sys_pdxfs_stat_by_inode --
  //       that upgrade is now a one-function-body edit inside
  //       owner_col_owner_row_from_entry, not a search-and-replace
  //       across this file's call sites. Bytes are qword-wide stores
  //       (owner fields are naturally 8-aligned inside the 8-aligned
  //       scratch).
  //   (3) Call Send::send_record(fd = LS_STDOUT_ENDPOINT_SLOT,
  //                              rec_ptr = &_se_wire_scratch,
  //                              rec_len = SE_WIRE_RECORD_SIZE).
  //   (4) Return SE_OK on send_record's SP_SEND_OK; else SE_ERR_SEND.
  //
  // Register plan (non-leaf, 3 callee-save pushes for alignment + carry):
  //   r12 = kernel_entry_ptr (survives across the copy loop, the
  //         owner_col_owner_row_from_entry call, and the send)
  //   r13 = copy loop cursor / wire base pointer during send
  //   r14 = unused (kept for the established 3-push alignment shape)
  //   rax = load byte / owner_col_owner_row_from_entry return / send
  //         return
  //   r11 = LEA scratch + sentinel staging + owner-wire address calc
  //   rcx = copy counter (caller-save; recomputed as needed)
  //
  // Alignment: 3 pushes = 24 bytes; entry rsp % 16 == 8; 8 + 24 = 32;
  // 32 % 16 == 0 at every nested call site (including the new
  // owner_col_owner_row_from_entry call).
  // ==========================================================================
  pub let sem_emit_entry : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (kernel_entry_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "ls.M3-001 (#8) + ls.M3-002 (#9) + ls.ENH-008 (#28): copy the 128-byte kernel PdxFsDirEntry into _se_wire_scratch, append a 16-byte owner Cap wire at scratch[128..144] (kind=KIND_USER 0x190 at offset 128; target_ptr = OwnerCol::owner_col_owner_row_from_entry(kernel_entry_ptr) at offset 136 -- the D2 literal owner-as-cap-ref shape from r49-r50-plan.md §4.4), and call libpdx-semantic-pipe::Send::send_record(LS_STDOUT_ENDPOINT_SLOT, scratch, SE_WIRE_RECORD_SIZE=144). Byte-by-byte copy loop with the #1248 mitigation (xor rax, rax; mov_b rax, [src]; mov_b [dst], rax) for the 128-byte kernel prefix -- the record is small enough that qword-wide copy has no material saving vs. the byte loop's uop cost, and the byte-loop shape is symmetric with libpdx-semantic-pipe::Send::send_record's own body copy. owner_col_owner_row_from_entry(r12) is called BEFORE the scratch[136] address is computed into r11, so its return in rax is stored immediately without being clobbered by intervening address arithmetic; it is a leaf ({} @{}), a strict subset of this function's own effects, so no widening. It honestly returns 0 today (PdxFsDirEntry has no owner field at HEAD -- see that function's own doc); the upgrade path when either (a) PdxFsDirEntry grows an owner field, or (b) sys_pdxfs_stat_by_inode ships is now a one-function-body edit inside owner_col_owner_row_from_entry rather than a change to this call site. Send return: SP_SEND_OK (0) -> SE_OK (0); every other value collapses to SE_ERR_SEND (0xFFFFEB25). This translation preserves the tool-level error taxonomy (0xFFFFEB2x = Runner sub-band) rather than surfacing library-internal codes to _start. Three callee-save pushes (r12=kernel_entry_ptr for pipeline stability across both nested calls, r13=wire scratch base, r14=unused padding) -> rsp % 16 == 0 at every nested call site (entry rsp %16 ==8; 3*8=24; 8+24=32; 32%16==0). Matched pops before every ret. paideia-as conformance: r11 scratch for LEA + sentinel; no test mnemonic; largest cmp immediate is 128 (SE_KERNEL_ENTRY_SIZE); the 0x190 owner-kind constant + SE_ERR_SEND stage via mov rax, imm32/imm64 (return path, not compare). Effects {mem, sysreg} @{cap} match send_record's effects tail. Labels prefixed seme_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                            // r12 = kernel_entry_ptr
        lea r13, [rip + _se_wire_scratch];       // r13 = &_se_wire_scratch (dst)

        // ---- (1) byte-by-byte copy kernel_entry[0..128] -> scratch --
        // rcx = 0..128; each iteration:
        //   xor rax; mov_b rax, [r12 + rcx]; mov_b [r13 + rcx], rax; rcx++.
        // r11 is the address-holder scratch (LEA-per-iter isn't needed
        // because we can address via base + index directly, but paideia-
        // as's mov_b addressing uses [reg] only, so we compute r11 =
        // r12 + rcx and r10 = r13 + rcx per iteration).
        xor rcx, rcx;

      seme_copy_head:
        cmp rcx, 128;                            // SE_KERNEL_ENTRY_SIZE
        jae seme_copy_done;

        // r11 = &src[rcx]
        mov r11, r12;
        add r11, rcx;
        xor rax, rax;                            // #1248 mitigation
        mov_b rax, [r11];

        // r10 = &dst[rcx]
        mov r10, r13;
        add r10, rcx;
        mov_b [r10], rax;

        add rcx, 1;
        jmp seme_copy_head;

      seme_copy_done:
        // ---- (2) M3-002 + ls.ENH-008 (#28): append owner Cap wire at
        //      scratch[128..144] --
        //
        //   [128..136] owner_kind      = KIND_USER (0x190)
        //   [136..144] owner_target_ptr = owner_col_owner_row_from_entry
        //                                 (kernel_entry_ptr) -- 0 today
        //
        // Qword-wide stores; owner fields are 8-aligned inside the 8-
        // aligned scratch, so no #1248 concern (stores, not loads).
        mov r11, r13;                            // r11 = &_se_wire_scratch
        add r11, 128;                            // r11 = &scratch[128]
        mov rax, 0x190;                          // SE_OWNER_KIND_USER
        mov [r11], rax;

        // owner_target_ptr @ scratch[136]: delegate to OwnerCol::
        // owner_col_owner_row_from_entry (ls.ENH-008, #28) rather than
        // an inline `xor rax, rax` placeholder -- r12/r13 survive the
        // call (callee-saved); rax is overwritten by the call return
        // and consumed immediately, so the address computation happens
        // AFTER the call rather than before.
        mov rdi, r12;                            // kernel_entry_ptr
        call owner_col_owner_row_from_entry;
        mov r11, r13;
        add r11, 136;                            // r11 = &scratch[136]
        mov [r11], rax;                          // owner_target_ptr (0 today)

        // ---- (3) send_record(fd, rec_ptr, rec_len) ------------------
        mov rdi, 3;                              // LS_STDOUT_ENDPOINT_SLOT
        mov rsi, r13;                            // &_se_wire_scratch
        mov rdx, 144;                            // SE_WIRE_RECORD_SIZE (M3-002)
        call send_record;

        // ---- (4) translate return ------------------------------------
        cmp rax, 0;                              // SP_SEND_OK
        jne seme_send_fail;
        xor rax, rax;                            // SE_OK
        pop r14;
        pop r13;
        pop r12;
        ret;

      seme_send_fail:
        mov rax, 0xFFFFEB25;                     // SE_ERR_SEND
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // sem_emit_wire_compose(kernel_entry_ptr) -> u64
  //
  // Signature: (u64) -> u64 !{mem} @{}
  //   RDI (input): kernel_entry_ptr -- 128-byte kernel-visible
  //                                     PdxFsDirEntry
  //   RAX (output): SE_WIRE_RECORD_SIZE (144) -- the number of wire
  //                 bytes composed into _se_wire_scratch. On any
  //                 defensive refusal (kernel_entry_ptr == 0),
  //                 returns 0 without touching the scratch.
  //
  // sem_emit_wire_compose runs the same compose logic as sem_emit_
  // entry steps (1) + (2) -- copy the 128-byte kernel record, append
  // the 16-byte owner Cap wire -- but SKIPS step (3) (Send::send_
  // record). Callers get the byte-exact wire body inside _se_wire_
  // scratch and can compare against a golden without needing a live
  // libpdx-semantic-pipe substrate.
  //
  // This is the M4-004 hook: the schema-golden fixture at tests/
  // schema_golden.pdx invokes this with a canned kernel entry, then
  // walks _se_wire_scratch byte-by-byte against the expected 144-byte
  // wire golden. If the compose logic ever drifts from the record
  // shape declared in the file header §Wire Record Shape, the
  // fixture's byte-diff surfaces the drift at M4 rather than at M5
  // (when a live-substrate run would surface it as a receiver-side
  // schema mismatch).
  //
  // Design decision: this helper duplicates the copy+append body from
  // sem_emit_entry rather than being extracted-and-shared. Two reasons:
  // (a) the loop shape at the call site is tiny (~30 instructions);
  // sharing would require an intermediate function-call boundary that
  // changes the register plan (rax survives the copy vs sem_emit_entry
  // where rax is the send return). (b) sem_emit_entry is the M3
  // hot path; keeping it a straight-line body (no extra call) is worth
  // duplicating twenty instructions.
  //
  // Register plan (non-leaf; two callee-save pushes for pipeline
  // stability across the compose):
  //   r12 = kernel_entry_ptr (survives the copy loop)
  //   r13 = wire scratch base (LEA once, reused across owner append)
  //   rcx = copy loop counter
  //   rax = load byte / return value
  //   r10, r11 = address-holder scratch (byte + qword store addressing)
  //
  // Alignment: 2 pushes + sub rsp,8 pad = 24 bytes; entry rsp % 16 ==
  // 8; 8 + 24 = 32; 32 % 16 == 0 at the owner_col_owner_row_from_entry
  // call site introduced by ls.ENH-008 (#28) -- the sub rsp,8 pad this
  // function always carried "for parity with sem_emit_entry" is what
  // that call now actually needs.
  // ==========================================================================
  pub let sem_emit_wire_compose : (u64) -> u64 !{mem} @{} =
    fn (kernel_entry_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "ls.M4-004 (#14) + ls.ENH-008 (#28): the compose-only sibling of sem_emit_entry, exposing the same 128-byte kernel-record copy + 16-byte owner Cap wire append into _se_wire_scratch WITHOUT the Send::send_record tail call. Callers (the schema-golden fixture at tests/schema_golden.pdx) get byte-exact wire bytes in _se_wire_scratch to diff against a golden, with no dependency on a live libpdx-semantic-pipe substrate. Defensive gate: kernel_entry_ptr == 0 returns 0 (bytes composed) without touching the scratch -- a broken caller sees a zero return, not garbage in _se_wire_scratch. Byte-by-byte copy loop follows the #1248 mitigation (xor rax, rax; mov_b rax, [src]; mov_b [dst], rax) identical to sem_emit_entry's copy body. Owner Cap wire append: qword stores at scratch[128] = SE_OWNER_KIND_USER (0x190), scratch[136] = OwnerCol::owner_col_owner_row_from_entry(r12) -- called before the scratch[136] address is computed into r11 so its rax return is not clobbered by the address arithmetic; it is a leaf ({} @{}), a strict subset of this function's own {mem} @{}, so no widening. Same honest-gap discipline as sem_emit_entry: returns 0 today (PdxFsDirEntry has no owner field at HEAD), and the future upgrade is a one-function-body edit inside owner_col_owner_row_from_entry rather than a change here. Two callee-save pushes (r12=kernel_entry_ptr, r13=wire scratch base) + sub rsp,8 pad = 24 bytes; entry rsp % 16 == 8; 8 + 24 = 32; 32 % 16 == 0 -- this function now HAS one nested call (owner_col_owner_row_from_entry), and the sub rsp,8 pad this function always carried 'for parity with sem_emit_entry' is what makes that call site aligned. Return value SE_WIRE_RECORD_SIZE (144) matches the number of wire bytes populated. paideia-as conformance: r11 + r10 as address scratch; no test mnemonic; largest cmp immediate 128 (SE_KERNEL_ENTRY_SIZE); the 0x190 owner-kind constant is a `mov rax, imm32` store, not a compare. Effects {mem} only (owner_col_owner_row_from_entry is {} @{}, a subset; no send_record, no cap invoke). Labels prefixed semc_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        // Defensive gate.
        cmp rdi, 0;
        je  semc_bad;

        mov r12, rdi;                            // r12 = kernel_entry_ptr
        lea r13, [rip + _se_wire_scratch];       // r13 = &_se_wire_scratch

        // ---- (1) byte-by-byte copy kernel_entry[0..128] -> scratch --
        xor rcx, rcx;

      semc_copy_head:
        cmp rcx, 128;                            // SE_KERNEL_ENTRY_SIZE
        jae semc_copy_done;

        mov r11, r12;
        add r11, rcx;
        xor rax, rax;                            // #1248 mitigation
        mov_b rax, [r11];

        mov r10, r13;
        add r10, rcx;
        mov_b [r10], rax;

        add rcx, 1;
        jmp semc_copy_head;

      semc_copy_done:
        // ---- (2) append owner Cap wire at scratch[128..144] ---------
        mov r11, r13;
        add r11, 128;
        mov rax, 0x190;                          // SE_OWNER_KIND_USER
        mov [r11], rax;

        // owner_target_ptr @ scratch[136]: same OwnerCol delegation as
        // sem_emit_entry (ls.ENH-008, #28) -- call happens before the
        // address computation so rax (the call's return) is not
        // clobbered by the r11 arithmetic.
        mov rdi, r12;                            // kernel_entry_ptr
        call owner_col_owner_row_from_entry;
        mov r11, r13;
        add r11, 136;
        mov [r11], rax;                          // owner_target_ptr (0 today)

        mov rax, 144;                            // SE_WIRE_RECORD_SIZE
        add rsp, 8;
        pop r13;
        pop r12;
        ret;

      semc_bad:
        xor rax, rax;
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }
}
