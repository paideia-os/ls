// src/posix_shim.pdx -- ls v1.1-A (paideia-os/ls M1-001 STUB retirement)
//
// PosixShim module: userspace syscall trampolines for the four
// path-addressed primitives the v1.1-A Runner body needs to enumerate
// a directory WITHOUT the pre-narrowed KIND_PDXFS_FILE cap that
// shell.M2's InitCap handoff never delivered.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// Four thin trampolines, all LEAF, all arity <= 3 so no r10 shuffle:
//
//   sys_open     (sysno 2)   path, flags, mode                  -> fd | -errno
//   sys_close    (sysno 3)   fd                                 -> 0  | -errno
//   sys_stat     (sysno 77)  path, path_len_hint, stat_buf_out  -> 0  | -errno
//   sys_getdents (sysno 78)  fd, buf, cap                       -> bytes (0=EOD)
//                                                                   | -errno
//
// Sysnos frozen at paideia-os design/user/syscall-table.md rows 2, 3,
// 77, 78. Record layout for sys_getdents is documented at paideia-os
// src/kernel/core/syscall/sys_getdents.pdx §Record layout (frozen for
// R56.M3): ino@0 u64, name_len@8 u16, type@10 u8, reserved@11 u8,
// name[name_len]@12 (no NUL); a header whose name_len == 0 terminates
// the stream. Stat buffer layout is at sys_stat.pdx §Kernel-side stat
// struct layout (64-byte record; ino@0 u64, size@8 u64, mtime@16 u64,
// mode@24 u32, ...).
//
// =============================================================================
// WHY NOT REUSE PdxfsShim
// =============================================================================
//
// PdxfsShim (src/pdxfs_shim.pdx) trampolines sysno 71/72
// (pdxfs_open, pdxfs_dir_readnext) -- the CAP-MINT primitives.
// sysno 71 needs a parent KIND_MEMORY cap carrying RIGHT_MINT (ls
// does not hold one) and sysno 72 needs a pre-narrowed
// KIND_PDXFS_FILE with DIR mode (shell.M2's InitCap handoff has not
// landed). Every call by the pre-v1.1-A Runner therefore refused with
// -EBADF, which is why the "M1-001 STUB body" label survived every
// intermediate wave -- the ceremonial machinery LOOKED live but the
// syscall path was never actually reachable end-to-end.
//
// The v1.1-A path bypasses cap machinery entirely and uses the
// POSIX-compat syscalls whose kernel dispatch shims do their own
// path walk against mount_root_vnode without a pre-held cap. That
// makes `ls` a REAL, live, end-to-end tool at HEAD; the cap-aware
// v2 body lands when shell.M2 does. PdxfsShim stays in-tree as the
// architectural anchor for that eventual v2 -- ripping it out now
// would make the v2 landing a re-declare rather than a use-site edit.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module basename PascalCase (`PosixShim`), no directory prefix.
//   - No `test` mnemonic anywhere (all bodies are 2-instruction leaves).
//   - No `cmp reg, imm` in any body -- every sysno is a `mov rax, imm`
//     emission, so the imm <= 0x7FFFFFFF rule never engages.
//   - No byte reads (bodies are pure syscall pass-throughs).
//   - r11 is scratch (paideia-as reserved); the SYSCALL instruction
//     itself clobbers rcx + r11 per Intel SDM Vol.2A §SYSCALL, which
//     is why every body declares !{mem, sysreg}.
//   - All four are LEAF functions -- no callee-save touched, no
//     push/pop parity to preserve. Entry rsp % 16 == 8 stays 8
//     through the SYSCALL; the kernel dispatch handles alignment.

module PosixShim = structure {

  // ==========================================================================
  // Syscall numbers (mirror paideia-os design/user/syscall-table.md).
  // ==========================================================================
  pub let PSH_SYSNO_WRITE    : u64 = 1
  pub let PSH_SYSNO_OPEN     : u64 = 2
  pub let PSH_SYSNO_CLOSE    : u64 = 3
  pub let PSH_SYSNO_STAT     : u64 = 77
  pub let PSH_SYSNO_GETDENTS : u64 = 78

  // ==========================================================================
  // Suggested getdents batch size. sys_getdents.pdx §KPTI bounce
  // discipline notes the body owns its own kernel scratch sized at
  // GETDENTS_IO_MAX; from the user side any cap up to that ceiling
  // is honored. 4096 is one page -- comfortable for tens of entries
  // per call at typical name lengths, still small enough that a
  // v1.1-A tool holds it entirely in .bss without stressing the
  // process's data segment.
  // ==========================================================================
  pub let PSH_GETDENTS_BUF_CAP : u64 = 4096

  // ==========================================================================
  // Path-length hint for sys_stat. The syscall's `path_len_hint` is
  // the walker CAP, not the exact strlen -- kernel walks to NUL or
  // to the cap, whichever comes first. 255 is the design/user/
  // syscall-table.md-recommended default ("hint is a walker CAP
  // (255 typical), not exact strlen"; see row 85 for the sys_chdir
  // note that pins the same convention).
  // ==========================================================================
  pub let PSH_PATH_HINT_DEFAULT : u64 = 255

  // ==========================================================================
  // sys_open(path_ptr, flags, mode) -> fd | -errno
  //
  // Signature: (u64, u64, u64) -> u64 !{mem, sysreg} @{}
  //   RDI (input): path_ptr -- NUL-terminated user-space path
  //   RSI (input): flags    -- POSIX open flags (0 = O_RDONLY suffices
  //                            for a directory the caller only
  //                            enumerates)
  //   RDX (input): mode     -- ignored unless O_CREAT is in flags
  //   RAX (output): fd (>= 0) on success; negative-errno u64
  //                 (bit 63 set) on failure -- caller detects with
  //                 `cmp rax, 0; jl <err>` (signed less-than).
  //
  // Arity 3 <= 4 so SysV rdi/rsi/rdx map straight to SYSCALL
  // rdi/rsi/rdx -- no r10 shuffle. Bodies of this shape use
  // `mov rax, N; syscall; ret`.
  // ==========================================================================
  pub let sys_open : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (path_ptr: u64) (flags: u64) (mode: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "ls v1.1-A: trampoline for paideia-os sysno 2 (sys_open). Arity 3 so SysV rdi/rsi/rdx map straight to SYSCALL rdi/rsi/rdx -- no r10 shuffle (paideia-os src/user/syscall_shim.pdx §3.2 arity-<=4 template). Return value verbatim from the syscall: non-negative fd on success, negative-errno u64 on failure (SYS_OPEN_ENOENT = 0xFFFFFFFFFFFFFFFE if path missing; SYS_OPEN_EFAULT = 0xFFFFFFFFFFFFFFF2 if path VA in the kernel half). Caller inspects the sign bit via `cmp rax, 0; jl <err>` -- same idiom audit_shim.pdx uses at aulb_begin_check. Effects {mem, sysreg} match the kernel body's tail: mem for the path walker's read of user pages, sysreg for the SYSCALL clobber of rcx + r11 per Intel SDM Vol.2A §SYSCALL. No @{cap} because sys_open does not consume a pre-held cap slot (the kernel walks against mount_root_vnode; the returned fd is not a cap_slot but a fd-table index). Leaf trampoline: no callee-save touched, no push/pop parity. Labels: none needed.",
      block: {
        mov rax, 2;                              // PSH_SYSNO_OPEN
        syscall;
        ret
      }
    }

  // ==========================================================================
  // sys_close(fd) -> 0 | -errno
  //
  // Signature: (u64) -> u64 !{mem, sysreg} @{}
  //   RDI (input): fd
  //   RAX (output): 0 on success; negative-errno u64 on failure.
  //
  // Return-code detection identical to sys_open (sign bit via jl).
  // Arity 1; no shuffle.
  // ==========================================================================
  pub let sys_close : (u64) -> u64 !{mem, sysreg} @{} =
    fn (fd: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "ls v1.1-A: trampoline for paideia-os sysno 3 (sys_close). Arity 1; no shuffle needed. Return: 0 success, negative-errno on failure. Runner ignores the return on both the success and error unwind paths (a close-time failure does not change the LS_* exit code the user sees; the fd is drained regardless), but the trampoline still returns the raw value so a future body that DOES care (a debugger fixture asserting close-succeeded) has the wire. Leaf trampoline. Effects {mem, sysreg} match the kernel body's tail; no @{cap}.",
      block: {
        mov rax, 3;                              // PSH_SYSNO_CLOSE
        syscall;
        ret
      }
    }

  // ==========================================================================
  // sys_stat(path_ptr, path_len_hint, stat_buf) -> 0 | -errno
  //
  // Signature: (u64, u64, u64) -> u64 !{mem, sysreg} @{}
  //   RDI (input): path_ptr      -- NUL-terminated user path
  //   RSI (input): path_len_hint -- walker CAP (255 typical; see
  //                                 PSH_PATH_HINT_DEFAULT)
  //   RDX (input): stat_buf      -- writable 64-byte user scratch;
  //                                 layout at sys_stat.pdx §Kernel-side
  //                                 stat struct layout
  //   RAX (output): 0 success; negative-errno on failure
  //                 (SYS_STAT_ENOENT = -ENOENT if path missing,
  //                  SYS_STAT_EFAULT = -EFAULT if either pointer VA
  //                  lands in the kernel half).
  //
  // Arity 3; no shuffle. v1.1-A's Runner calls stat BEFORE open as a
  // clean existence check: a missing-path error surfaces as
  // LS_ERR_BAD_PATH (0xFFFFEB21) without ever running the open. This
  // costs one extra syscall per invocation but keeps the error-code
  // taxonomy legible (LS_ERR_BAD_PATH vs LS_ERR_READDIR = "the path
  // resolved but the enumeration failed"), matching the M1-era error
  // vocabulary the tests/exit_matrix.pdx fixture already pins.
  // ==========================================================================
  pub let sys_stat : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (path_ptr: u64) (path_len_hint: u64) (stat_buf: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "ls v1.1-A: trampoline for paideia-os sysno 77 (sys_stat). Arity 3 so SysV rdi/rsi/rdx map straight to SYSCALL rdi/rsi/rdx -- no r10 shuffle. Fills the 64-byte stat scratch at stat_buf (layout: sys_stat.pdx §Kernel-side stat struct layout -- ino@0 u64, size@8 u64, mtime@16 u64, mode@24 u32, nlink@28 u32, uid@32 u32, gid@36 u32, blksize@40 u32, blocks@44 u32, reserved@48..). Return: 0 success, negative-errno u64 (-EFAULT/-ENOENT per sys_stat.pdx §Failure taxonomy) on failure. Runner uses it purely as an existence + readability check ahead of sys_open so a missing path lands in the LS_ERR_BAD_PATH sub-band rather than the LS_ERR_READDIR sub-band the M1 error-code matrix reserves for enumeration failures on a live path. Leaf trampoline. Effects {mem, sysreg} match the kernel body's tail.",
      block: {
        mov rax, 77;                             // PSH_SYSNO_STAT
        syscall;
        ret
      }
    }

  // ==========================================================================
  // sys_getdents(fd, buf, cap) -> bytes | -errno
  //
  // Signature: (u64, u64, u64) -> u64 !{mem, sysreg} @{}
  //   RDI (input): fd  -- from sys_open on a directory
  //   RSI (input): buf -- writable user scratch; the kernel writes a
  //                       stream of variable-length records into it
  //   RDX (input): cap -- byte-cap of buf (4096 = PSH_GETDENTS_BUF_CAP
  //                       is Runner's fixed choice)
  //   RAX (output): bytes-written on success (0 = EOD; buf untouched);
  //                 negative-errno u64 on failure (-EBADF if fd is
  //                 not a live directory; -EFAULT if buf VA is
  //                 rejected).
  //
  // Record layout (frozen at R56.M3, quoted verbatim from
  // sys_getdents.pdx §Record layout so a caller does not have to open
  // the kernel file):
  //
  //   +0   ino:      u64   inode index (low 16 bits carry backend slot)
  //   +8   name_len: u16   1..255 for a live entry; 0 marks the terminator
  //   +10  type:     u8    VNODE_TYPE_DIR=2, VNODE_TYPE_REG=1
  //   +11  reserved: u8    always 0
  //   +12  name[name_len]  no NUL terminator
  //
  //   Stream ends with a header whose name_len == 0 (12-byte terminator).
  //
  // Runner walks the returned bytes twice per call at most (once to
  // find records, once to write each name) and calls sys_getdents
  // again until it returns 0 -- the cursor is internal to the kernel
  // fd_entry (sys_getdents.pdx §Cursor discipline), so each call
  // resumes where the previous one left off.
  //
  // Arity 3; no shuffle.
  // ==========================================================================
  pub let sys_getdents : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (fd: u64) (buf: u64) (cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "ls v1.1-A: trampoline for paideia-os sysno 78 (sys_getdents). Arity 3 so SysV rdi/rsi/rdx map straight to SYSCALL rdi/rsi/rdx -- no r10 shuffle. Fills buf with a stream of variable-length records (layout frozen at sys_getdents.pdx §Record layout for R56.M3: ino@0 u64, name_len@8 u16, type@10 u8, reserved@11 u8, name@12; a header with name_len=0 terminates the stream). Return: bytes-written on success (0 = end-of-directory, buf untouched), negative-errno u64 on failure. Runner iterates until a 0 return, walking each returned batch record-by-record; the kernel fd_entry carries the readdir cursor across calls per §Cursor discipline. Leaf trampoline. Effects {mem, sysreg} match the kernel body's tail -- mem for user_write_bytes_via_walk into buf, sysreg for the SYSCALL clobber.",
      block: {
        mov rax, 78;                             // PSH_SYSNO_GETDENTS
        syscall;
        ret
      }
    }
}
